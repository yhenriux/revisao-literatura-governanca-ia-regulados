ment of Experimental Therapeutics, National Cancer Center Hospital, Tokyo, 104-0045, Japan."}]}},{"fullName":"Akagi Y","firstName":"Yu","lastName":"Akagi","initials":"Y","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biomedical Informatics, Graduate School of Medicine, The University of Tokyo, 7-3-1 Hongo Bunkyo-ku, Tokyo, 113-8655, Japan."}]}},{"fullName":"Kouno N","firstName":"Nobuji","lastName":"Kouno","initials":"N","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Medical AI Research and Development, National Cancer Center Research Institute, 5-1-1 Tsukiji, Chuo-ku, Tokyo, 104-0045, Japan."},{"affiliation":"AI Medical Engineering Team, RIKEN Center for Advanced Intelligence Project, 1-4-1 Nihonbashi,, Chuo-ku, Tokyo, 103-0027, Japan."},{"affiliation":"Department of Surgery, Graduate School of Medicine, Kyoto University, Kyoto, 606-8507, Japan."}]}},{"fullName":"Sudo K","firstName":"Kazuki","lastName":"Sudo","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Experimental Therapeutics, National Cancer Center Hospital, Tokyo, 104-0045, Japan."},{"affiliation":"Department of Medical Oncology, National Cancer Center Hospital, Tokyo, 104-0045, Japan."}]}},{"fullName":"Hirata M","firstName":"Makoto","lastName":"Hirata","initials":"M","authorId":{"type":"ORCID","value":"0000-0002-9994-9958"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Genetic Medicine and Services, National Cancer Center Hospital, Tokyo, 104-0045, Japan."}]}},{"fullName":"Sunami K","firstName":"Kuniko","lastName":"Sunami","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Laboratory Medicine, National Cancer Center Hospital, Tokyo, 104-0045, Japan."}]}},{"fullName":"Kubo T","firstName":"Takashi","lastName":"Kubo","initials":"T","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Laboratory Medicine, National Cancer Center Hospital, Tokyo, 104-0045, Japan."}]}},{"fullName":"Katayama H","firstName":"Hiroshi","lastName":"Katayama","initials":"H","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Clinical Research Support Office, National Cancer Center Hospital, Tokyo, 104-0045, Japan."}]}},{"fullName":"Takashima A","firstName":"Atsuo","lastName":"Takashima","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Gastrointestinal Medical Oncology, National Cancer Center Hospital, Tokyo, 104-0045, Japan."}]}},{"fullName":"Taniguchi T","firstName":"Tomonori","lastName":"Taniguchi","initials":"T","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Medical AI Research and Development, National Cancer Center Research Institute, 5-1-1 Tsukiji, Chuo-ku, Tokyo, 104-0045, Japan."},{"affiliation":"AI Medical Engineering Team, RIKEN Center for Advanced Intelligence Project, 1-4-1 Nihonbashi,, Chuo-ku, Tokyo, 103-0027, Japan."}]}},{"fullName":"Matsumoto H","firstName":"Hiromi","lastName":"Matsumoto","initials":"H","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Medical AI Research and Development, National Cancer Center Research Institute, 5-1-1 Tsukiji, Chuo-ku, Tokyo, 104-0045, Japan."},{"affiliation":"AI Medical Engineering Team, RIKEN Center for Advanced Intelligence Project, 1-4-1 Nihonbashi,, Chuo-ku, Tokyo, 103-0027, Japan."}]}},{"fullName":"Shibaki R","firstName":"Ryota","lastName":"Shibaki","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Medical AI Research and Development, National Cancer Center Research Institute, 5-1-1 Tsukiji, Chuo-ku, Tokyo, 104-0045, Japan."},{"affiliation":"AI Medical Engineering Team, RIKEN Center for Advanced Intelligence Project, 1-4-1 Nihonbashi,, Chuo-ku, Tokyo, 103-0027, Japan."}]}},{"fullName":"Asada K","firstName":"Ken","lastName":"Asada","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Medical AI Research and Development, National Cancer Center Research Institute, 5-1-1 Tsukiji, Chuo-ku, Tokyo, 104-0045, Japan."},{"affiliation":"AI Medical Engineering Team, RIKEN Center for Advanced Intelligence Project, 1-4-1 Nihonbashi,, Chuo-ku, Tokyo, 103-0027, Japan."}]}},{"fullName":"Komatsu M","firstName":"Masaaki","lastName":"Komatsu","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Medical AI Research and Development, National Cancer Center Research Institute, 5-1-1 Tsukiji, Chuo-ku, Tokyo, 104-0045, Japan."},{"affiliation":"AI Medical Engineering Team, RIKEN Center for Advanced Intelligence Project, 1-4-1 Nihonbashi,, Chuo-ku, Tokyo, 103-0027, Japan."}]}},{"fullName":"Kaneko S","firstName":"Syuzo","lastName":"Kaneko","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Medical AI Research and Development, National Cancer Center Research Institute, 5-1-1 Tsukiji, Chuo-ku, Tokyo, 104-0045, Japan."},{"affiliation":"AI Medical Engineering Team, RIKEN Center for Advanced Intelligence Project, 1-4-1 Nihonbashi,, Chuo-ku, Tokyo, 103-0027, Japan."}]}},{"fullName":"Yamada M","firstName":"Masayoshi","lastName":"Yamada","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Endoscopy Division, National Cancer Center Hospital, Tokyo, 104-0045, Japan."}]}},{"fullName":"Horinouchi H","firstName":"Hidehito","lastName":"Horinouchi","initials":"H","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Thoracic Oncology, National Cancer Center Hospital, Tokyo, 104-0045, Japan."}]}},{"fullName":"Tanaka K","firstName":"Katsuya","lastName":"Tanaka","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"IT Integrating and Support Center, National Cancer Center, Tokyo, 104-0045, Japan."}]}},{"fullName":"Goto Y","firstName":"Yasushi","lastName":"Goto","initials":"Y","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Thoracic Oncology, National Cancer Center Hospital, Tokyo, 104-0045, Japan."}]}},{"fullName":"Kato K","firstName":"Ken","lastName":"Kato","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Gastrointestinal Medical Oncology, National Cancer Center Hospital, Tokyo, 104-0045, Japan."}]}},{"fullName":"Saito Y","firstName":"Yutaka","lastName":"Saito","initials":"Y","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Endoscopy Division, National Cancer Center Hospital, Tokyo, 104-0045, Japan."}]}},{"fullName":"Nakamura K","firstName":"Kenichi","lastName":"Nakamura","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Clinical Research Support Office, National Cancer Center Hospital, Tokyo, 104-0045, Japan."}]}},{"fullName":"Yamamoto N","firstName":"Noboru","lastName":"Yamamoto","initials":"N","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Experimental Therapeutics, National Cancer Center Hospital, Tokyo, 104-0045, Japan."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-2632-1334"},{"type":"ORCID","value":"0000-0002-9994-9958"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"1","volume":"19","journalIssueId":4120300,"dateOfPublication":"2026 Feb","monthOfPublication":2,"yearOfPublication":2026,"printPublicationDate":"2026-02-01","journal":{"title":"Journal of hematology & oncology","medlineAbbreviation":"J Hematol Oncol","isoabbreviation":"J Hematol Oncol","nlmid":"101468937","essn":"1756-8722","issn":"1756-8722"}},"pubYear":"2026","pageInfo":"14","abstractText":"The paramount challenge in precision oncology lies in further improving quality of life and response rates for individual patients. Efforts toward these goals are steadily expanding the scope of clinical implementation, despite ongoing challenges such as standardization, cost-effectiveness, and data harmonization. Building upon this maturing foundation, generative AI-which has evolved dramatically in recent years-is particularly valuable at this stage of advancing efficiency and adoption as an auxiliary technology linking literature, guidelines, trial protocols, and patient data. Specifically, through mutation interpretation, trial eligibility matching, and tumor board support, it is expected to contribute to advancing standardization, improving cost-effectiveness, accelerating data harmonization, and further accelerating human-centered decision-making. Accordingly, this review surveys the development history of generative AI and its current healthcare applications, organizing its implementation potential for precision oncology along three axes: (1) generative AI-based interpretation of genetic mutations and estimation of their pathological significance; (2) generative AI-driven verification of clinical trial eligibility; and (3) multimodal foundation models for imaging and pathology that compute \"tumor phenotypes\" using real-world data, contributing to report drafting and molecular surrogate estimation. In response, we propose a strategy centered on retrieval-augmented generation (RAG) and human-in-the-loop (HITL) workflows, encompassing data preparation based on OMOP, mCODE, and FHIR; multicenter prospective evaluation; auditable logs and governance aligned with Good Manufacturing Practice (GMP) and the EU AI Act; and a synthetic data strategy including differential privacy. Ultimately, this approach validates value through real-world outcomes and charts a path toward \"learning oncology,\" accelerating patient-centered decision-making and clinical trial development.","affiliation":"Division of Medical AI Research and Development, National Cancer Center Research Institute, 5-1-1 Tsukiji, Chuo-ku, Tokyo, 104-0045, Japan. rhamamot@ncc.go.jp.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"grantsList":{"grant":[{"grantId":"the MEXT subsidy for the Advanced Integrated Intelligence Platform","agency":"Ministry of Education, Culture, Sports, Science and Technology","orderIn":0},{"grantId":"BRIDGE","agency":"Cabinet Office, Government of Japan","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Neoplasms","meshQualifierList":{"meshQualifier":[{"abbreviation":"GE","qualifierName":"genetics","majorTopic_YN":"N"},{"abbreviation":"TH","qualifierName":"therapy","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Medical Oncology","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Artificial Intelligence"},{"majorTopic_YN":"Y","descriptorName":"Precision Medicine","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Generative Artificial Intelligence"}]},"keywordList":{"keyword":["Transformer","Precision Oncology","Generative Artificial Intelligence","Large Language Model","Vision Language Model","Retrieval-augmented Generation"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1186/s13045-026-01781-y"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12896320"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12896320?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by-nc-nd","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["nct","doi"]},"dateOfCompletion":"2026-07-07","dateOfCreation":"2026-02-10","firstIndexDate":"2026-02-10","fullTextReceivedDate":"2026-02-14","dateOfRevision":"2026-07-07","electronicPublicationDate":"2026-02-09","firstPublicationDate":"2026-02-09"},{"id":"42383194","source":"MED","pmid":"42383194","pmcid":"PMC13316258","fullTextIdList":{"fullTextId":["PMC13316258"]},"doi":"10.1016/j.esmorw.2026.100723","title":"Large language models in oncology: promise, pitfalls, and the path to real-world adoption.","authorString":"McInerney S, Hall PS, Cresswell K.","authorList":{"author":[{"fullName":"McInerney S","firstName":"S","lastName":"McInerney","initials":"S","authorId":{"type":"ORCID","value":"0009-0003-7543-7450"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute of Genetics and Cancer, University of Edinburgh, Edinburgh, UK."}]}},{"fullName":"Hall PS","firstName":"P S","lastName":"Hall","initials":"PS","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute of Genetics and Cancer, University of Edinburgh, Edinburgh, UK."}]}},{"fullName":"Cresswell K","firstName":"K","lastName":"Cresswell","initials":"K","authorId":{"type":"ORCID","value":"0000-0001-6634-9537"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Usher Institute, University of Edinburgh, Edinburgh, UK."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-6634-9537"},{"type":"ORCID","value":"0009-0003-7543-7450"}]},"journalInfo":{"volume":"13","journalIssueId":4219706,"dateOfPublication":"2026 Sep","monthOfPublication":9,"yearOfPublication":2026,"printPublicationDate":"2026-09-01","journal":{"title":"ESMO real world data and digital oncology","medlineAbbreviation":"ESMO Real World Data Digit Oncol","isoabbreviation":"ESMO Real World Data Digit Oncol","nlmid":"9919053637506676","essn":"2949-8201","issn":"2949-8201"}},"pubYear":"2026","pageInfo":"100723","affiliation":"Institute of Genetics and Cancer, University of Edinburgh, Edinburgh, UK.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["Editorial"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1016/j.esmorw.2026.100723"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13316258"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13316258?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by-nc-nd","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-07-01","dateOfCreation":"2026-07-01","firstIndexDate":"2026-07-02","fullTextReceivedDate":"2026-08-19","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-22","firstPublicationDate":"2026-06-22"},{"id":"42368305","source":"MED","pmid":"42368305","pmcid":"PMC13306874","fullTextIdList":{"fullTextId":["PMC13306874"]},"doi":"10.35772/ghm.2026.01063","title":"From companion technologies to social care infrastructure: A multi-level perspective on loneliness-related support in dementia care in an era of artificial intelligence (AI).","authorString":"Uenishi M, Song P.","authorList":{"author":[{"fullName":"Uenishi M","firstName":"Machiko","lastName":"Uenishi","initials":"M","authorId":{"type":"ORCID","value":"0009-0008-5480-6962"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Global Health & Medicine, Bureau of Health Emergency and Management, Japan Institute for Health Security, Tokyo, Japan."}]}},{"fullName":"Song P","firstName":"Peipei","lastName":"Song","initials":"P","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Global Health & Medicine, Bureau of Health Emergency and Management, Japan Institute for Health Security, Tokyo, Japan."},{"affiliation":"National College of Nursing, Japan (NCNJ), Japan Institute for Health Security, Tokyo, Japan."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0009-0008-5480-6962"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"3","volume":"8","journalIssueId":4222530,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"printPublicationDate":"2026-06-01","journal":{"title":"Global health & medicine","medlineAbbreviation":"Glob Health Med","isoabbreviation":"Glob Health Med","nlmid":"101771579","essn":"2434-9194","issn":"2434-9186"}},"pubYear":"2026","pageInfo":"215-221","abstractText":"Loneliness and social isolation are important psychosocial concerns in dementia care, but they are difficult to address through pharmacological treatment or episodic social activities alone. Companion technologies, including socially assistive robots, humanoid and conversational robots, avatars, virtual agents, and artificial intelligence (AI)- enabled companions, are increasingly discussed as possible aids for engagement and interaction. However, current evidence does not justify treating these technologies as standalone interventions that directly reduce loneliness in people with dementia. We argue that these technologies may be more appropriately considered not only as devices or interventions, but also as potential components of social care infrastructure: tools that can encourage individual engagement and mediate human relationships but that need to be integrated into care ecosystems. We propose the multi-level care with social technologies (MCST) model, which consists of three connected layers: individual engagement, relational interaction, and the care ecosystem. The model emphasizes that loneliness-related support is produced through the interaction between technology, human facilitation, care workflows, ethical governance, and feedback-based adjustment. This approach is especially relevant as dementia care systems face workforce constraints and an increasing need for home-based care, while psychosocial needs remain and may be overlooked in routine care. AI-enabled and large-language-model-based companions may expand possibilities for personalization and continuous engagement, but dementia-specific evidence remains preliminary and safety concerns are substantial. Future research should validate the MCST model in real-world dementia care and establish evaluation frameworks that address psychosocial outcomes, sustained use, safety, privacy, human oversight, and accountability.","affiliation":"Division of Global Health & Medicine, Bureau of Health Emergency and Management, Japan Institute for Health Security, Tokyo, Japan.","publicationStatus":"ppublish","language":"eng","pubModel":"Print","pubTypeList":{"pubType":["Letter"]},"keywordList":{"keyword":["Perspective","Dementia","Artificial Intelligence (Ai)","Companion Technologies","Loneliness-related Distress","Social Care Infrastructure"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.35772/ghm.2026.01063"},{"availability":"Free","availabilityCode":"F","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13306874"},{"availability":"Free","availabilityCode":"F","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13306874?pdf=render"},{"availability":"Free","availabilityCode":"F","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.35772/ghm.2026.01063"}]},"isOpenAccess":"N","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-06-29","dateOfCreation":"2026-06-29","firstIndexDate":"2026-07-02","fullTextReceivedDate":"2026-08-19","dateOfRevision":"2026-08-13","firstPublicationDate":"2026-06-01"},{"id":"42328274","source":"MED","pmid":"42328274","pmcid":"PMC13275244","fullTextIdList":{"fullTextId":["PMC13275244"]},"doi":"10.3389/fdgth.2026.1868217","title":"Editorial: Advances in generative artificial intelligence for mental health.","authorString":"Han N, Guan Z, Li A, Liu X, Liu X, Xue J.","authorList":{"author":[{"fullName":"Han N","firstName":"Nuo","lastName":"Han","initials":"N","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Bay Area School of Applied Psychological Sciences, Beijing Normal University, Zhuhai, China."},{"affiliation":"Beijing Key Laboratory of Applied Experimental Psychology, National Demonstration Center for Experimental Psychology Education (Beijing Normal University), Faculty of Psychology, Beijing Normal University, Beijing, China."}]}},{"fullName":"Guan Z","firstName":"Zengda","lastName":"Guan","initials":"Z","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of E-commerce, School of Business, Shandong Jianzhu University, Jinan, China."}]}},{"fullName":"Li A","firstName":"Ang","lastName":"Li","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychology, Beijing Forestry University, Beijing, China."}]}},{"fullName":"Liu X","firstName":"Xiaoqian","lastName":"Liu","initials":"X","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"State Key Laboratory of Cognitive Science and Mental Health, Institute of Psychology, Chinese Academy of Sciences, Beijing, China."},{"affiliation":"Department of Psychology, University of Chinese Academy of Sciences, Beijing, China."}]}},{"fullName":"Liu X","firstName":"Xingyun","lastName":"Liu","initials":"X","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Key Laboratory of Adolescent Cyberpsychology and Behavior, Ministry of Education, Wuhan, China."},{"affiliation":"Key Laboratory of Human Development and Mental Health of Hubei Province, School of Psychology, Central China Normal University, Wuhan, China."}]}},{"fullName":"Xue J","firstName":"Jia","lastName":"Xue","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Factor Inwentash Faculty of Social Work, University of Toronto, Toronto, ON, Canada."},{"affiliation":"Faculty of Information, University of Toronto, Toronto, ON, Canada."}]}}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics"]},"journalInfo":{"volume":"8","journalIssueId":4117475,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Frontiers in digital health","medlineAbbreviation":"Front Digit Health","isoabbreviation":"Front Digit Health","nlmid":"101771889","essn":"2673-253X","issn":"2673-253X"}},"pubYear":"2026","pageInfo":"1868217","affiliation":"Bay Area School of Applied Psychological Sciences, Beijing Normal University, Zhuhai, China.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["Editorial"]},"keywordList":{"keyword":["Challenges","Implementation","Opportunities","Digital Mental Health","Generative Artificial Intelligence"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/fdgth.2026.1868217"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13275244"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13275244?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-06-22","dateOfCreation":"2026-06-22","firstIndexDate":"2026-06-23","fullTextReceivedDate":"2026-06-26","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-04","firstPublicationDate":"2026-06-04"},{"id":"41534067","source":"MED","pmid":"41534067","pmcid":"PMC12853083","fullTextIdList":{"fullTextId":["PMC12853083"]},"doi":"10.2196/86550","title":"From Agents to Governance: Essential AI Skills for Clinicians in the Large Language Model Era.","authorString":"Cao W, Zhang Q, Liu J, Liu S.","authorList":{"author":[{"fullName":"Cao W","firstName":"Weiping","lastName":"Cao","initials":"W","authorId":{"type":"ORCID","value":"0009-0000-9117-6367"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Cardiology, West China Hospital, Sichuan University, Chengdu, Sichuan, China."},{"affiliation":"Department of Cardiology, The People's Hospital of Leshan, Leshan, Sichuan, China."}]}},{"fullName":"Zhang Q","firstName":"Qing","lastName":"Zhang","initials":"Q","authorId":{"type":"ORCID","value":"0000-0002-5652-4036"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Cardiology, West China Hospital, Sichuan University, Chengdu, Sichuan, China."}]}},{"fullName":"Liu J","firstName":"Jialin","lastName":"Liu","initials":"J","authorId":{"type":"ORCID","value":"0000-0002-1369-4625"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Information Center, West China Hospital, Sichuan University, Chengdu, China."},{"affiliation":"Department of Medical Informatics, West China Medical School, Sichuan University, Chengdu, China."}]}},{"fullName":"Liu S","firstName":"Siru","lastName":"Liu","initials":"S","authorId":{"type":"ORCID","value":"0000-0002-5003-5354"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biomedical Informatics, Vanderbilt University Medical Center, Nashville, TN, United States."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-1369-4625"},{"type":"ORCID","value":"0000-0002-5003-5354"},{"type":"ORCID","value":"0000-0002-5652-4036"},{"type":"ORCID","value":"0009-0000-9117-6367"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"volume":"28","journalIssueId":4082344,"dateOfPublication":"2026 Jan","monthOfPublication":1,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Journal of medical Internet research","medlineAbbreviation":"J Med Internet Res","isoabbreviation":"J Med Internet Res","nlmid":"100959882","essn":"1438-8871","issn":"1439-4456"}},"pubYear":"2026","pageInfo":"e86550","abstractText":"Large language models are rapidly transitioning from pilot schemes to routine clinical practice. This creates an urgent need for clinicians to develop the necessary skills to strike the right balance between seizing opportunities and taking accountability. We propose a 3-tier competency framework to support clinicians' evolution from cautious users to responsible stewards of artificial intelligence (AI). Tier 1 (foundational skills) defines the minimum competencies for safe use, including prompt engineering, human-AI agent interaction, security and privacy awareness, and the clinician-patient interface (transparency and consent). Tier 2 (intermediate skills) emphasizes evaluative expertise, including bias detection and mitigation, interpretation of explainability outputs, and the effective clinical integration of AI-generated workflows. Tier 3 (advanced skills) establishes leadership capabilities, mandating competencies in ethical governance (delineating accountability and liability boundaries), regulatory strategy, and model life cycle management-specifically, the ability to govern algorithmic adaptation and change protocols. Integrating this framework into continuing medical education programs and role-specific job descriptions could enhance clinicians' ability to use AI safely and responsibly. This could standardize deployment and support safer clinical practice, with the potential to improve patient outcomes.","affiliation":"Department of Cardiology, West China Hospital, Sichuan University, Chengdu, Sichuan, China.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Artificial Intelligence"},{"majorTopic_YN":"N","descriptorName":"Large Language Models"}]},"keywordList":{"keyword":["Artificial intelligence","Agent","Education","Continuing Medical Education","Competency","Clinician","Large Language Model"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/86550"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12853083"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12853083?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":2,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-06-26","dateOfCreation":"2026-01-14","firstIndexDate":"2026-01-15","fullTextReceivedDate":"2026-01-30","dateOfRevision":"2026-06-26","electronicPublicationDate":"2026-01-14","firstPublicationDate":"2026-01-14"},{"id":"42193555","source":"MED","pmid":"42193555","pmcid":"PMC13203138","fullTextIdList":{"fullTextId":["PMC13203138"]},"doi":"10.3390/bs16050676","title":"AI in Psychotherapy: Opportunities and Risks.","authorString":"Neacșu V.","authorList":{"author":[{"fullName":"Neacșu V","firstName":"Valentina","lastName":"Neacșu","initials":"V","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Psychology, \"Titu Maiorescu\" University, 040056 Bucharest, Romania."}]}}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"5","volume":"16","journalIssueId":4201776,"dateOfPublication":"2026 Apr","monthOfPublication":4,"yearOfPublication":2026,"printPublicationDate":"2026-04-01","journal":{"title":"Behavioral sciences (Basel, Switzerland)","medlineAbbreviation":"Behav Sci (Basel)","isoabbreviation":"Behav Sci (Basel)","nlmid":"101576826","essn":"2076-328X","issn":"2076-328X"}},"pubYear":"2026","pageInfo":"676","abstractText":"This article examines the emerging role of artificial intelligence in mental health contexts, with a particular focus on psychotherapy and the risks associated with deploying large language models (LLMs) in sensitive clinical domains. It aims to provide a broad review of current literature, highlighting key risks of general-purpose artificial intelligence (AI) systems, while also exploring the potential of clinically oriented LLMs for therapist training, supervision, and professional development. It discusses several key concerns, including AI-related psychosis, the development of parasocial attachments, and the growing number of crisis-related interactions users have with general-purpose AI models. These challenges raise important questions about the safety, reliability, and ethical management of AI systems when individuals seek support during periods of psychological crisis. Beyond identifying these risks, the article explores the potential of clinical LLMs specifically designed for mental health applications. In particular, AI can serve as a tool for therapists' training, supervision, and professional development, offering simulated clinical scenarios, structured feedback, and support for reflective practice. The article concludes by outlining key directions for the responsible development of therapeutic AI. These include the importance of human oversight, the use of specialized and clinically informed training datasets, advances in model fine-tuning and safety alignment, and the establishment of clear professional guidelines and regulatory frameworks. Together, these developments may help ensure that AI technologies are integrated into mental healthcare in ways that prioritize safety, ethical practice, and the continued central role of human clinicians.","affiliation":"Faculty of Psychology, \"Titu Maiorescu\" University, 040056 Bucharest, Romania.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"keywordList":{"keyword":["Psychology","psychotherapy","Artificial Intelligence (Ai)","Ai Therapy","Ai Psychosis","Clinical Llms"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3390/bs16050676"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13203138"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13203138?pdf=render"}]},"commentCorrectionList":{"commentCorrection":[{"id":"PPR1168838","source":"PPR","type":"Preprint in","note":"Link created based on a title-first author match","orderIn":10002}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-05-27","dateOfCreation":"2026-05-27","firstIndexDate":"2026-05-28","fullTextReceivedDate":"2026-05-27","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-04-29","firstPublicationDate":"2026-04-29"},{"id":"41911018","source":"MED","pmid":"41911018","pmcid":"PMC13077275","fullTextIdList":{"fullTextId":["PMC13077275"]},"doi":"10.2196/93040","title":"Mass Media Narratives of Psychiatric Adverse Events Associated With Generative AI Chatbots: Rapid Scoping Review.","authorString":"Chung VH, Bernier P, Hudon A.","authorList":{"author":[{"fullName":"Chung VH","firstName":"Van-Han-Alex","lastName":"Chung","initials":"VH","authorId":{"type":"ORCID","value":"0009-0004-4649-9887"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Medicine, McGill University, Montreal, QC, Canada."}]}},{"fullName":"Bernier P","firstName":"Pénélope","lastName":"Bernier","initials":"P","authorId":{"type":"ORCID","value":"0009-0005-8489-7410"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Campus Mauricie, Faculty of Medicine, Université de Montréal, Montreal, QC, Canada."}]}},{"fullName":"Hudon A","firstName":"Alexandre","lastName":"Hudon","initials":"A","authorId":{"type":"ORCID","value":"0000-0002-4868-0928"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry and Addictology, Faculty of Medicine, Université de Montréal, Montreal, QC, Canada."},{"affiliation":"Department of Psychiatry, Institut universitaire en santé mentale de Montréal, Montreal, QC, Canada."},{"affiliation":"Centre de recherche de l'Institut universitaire en santé mentale de Montréal, Montreal, QC, Canada."},{"affiliation":"Centre de recherche en pédagogie de la santé, Université de Montréal, Montreal, QC, Canada."},{"affiliation":"Department of Psychiatry, Institut national de psychiatrie légale Philippe Pinel, Montreal, QC, Canada."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-4868-0928"},{"type":"ORCID","value":"0009-0004-4649-9887"},{"type":"ORCID","value":"0009-0005-8489-7410"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"volume":"13","journalIssueId":4143666,"dateOfPublication":"2026 Mar","monthOfPublication":3,"yearOfPublication":2026,"printPublicationDate":"2026-03-01","journal":{"title":"JMIR mental health","medlineAbbreviation":"JMIR Ment Health","isoabbreviation":"JMIR Ment Health","nlmid":"101658926","essn":"2368-7959","issn":"2368-7959"}},"pubYear":"2026","pageInfo":"e93040","abstractText":"<h4>Background</h4>Generative artificial intelligence (AI) chatbots have rapidly entered public use, including in contexts involving emotional support and mental health-related interactions. Although these systems are increasingly accessible, concerns have emerged regarding potential adverse psychiatric outcomes reported in public discourse, including psychosis, suicidal ideation, self-harm, and suicide. However, these reports largely originate from journalistic accounts rather than systematically verified clinical data.<h4>Objective</h4>This rapid scoping review aimed to systematically map and characterize mass media narratives describing alleged adverse psychiatric outcomes temporally associated with generative AI chatbot interactions.<h4>Methods</h4>A rapid scoping review methodology was applied to publicly accessible news articles identified primarily through Google News searches. Articles published from November 2022 onward were screened for eligibility if they described a specific case in which psychiatric deterioration or crisis was temporally linked to generative AI use. Data were extracted using a structured coding template capturing article characteristics, demographic information, AI platform features, interaction intensity, outcome type and severity, type of evidence reported, and causal attribution language. Descriptive statistics and cross-tabulations were performed.<h4>Results</h4>A total of 71 news articles representing 36 unique cases were included. Suicide death was the most frequently reported outcome (35/61, 57.4% cases with complete severity coding), followed by psychiatric hospitalization (12/61, 19.7%). Fatal outcomes were disproportionately represented among minors (19/21, 90.5%) compared with adults (17/35, 48.6%). ChatGPT was the most frequently cited platform (51/71, 71.8%), followed by Character AI (10/71, 14.1%). Causal attribution most commonly referenced AI system behavior (45/61, 73.8%), and the term \"alleged\" was the predominant causal descriptor (33/61, 54.1%). Evidence sources were primarily chat logs or screenshots (34/61, 55.7%), while police or medical documentation was rare (1/61, 1.6%). Regulatory calls were present in 51 of 60 (85%) articles with nonmissing data.<h4>Conclusions</h4>Mass media reporting of generative AI-related psychiatric harms is concentrated around severe outcomes, particularly suicide deaths among youth, and is frequently framed within regulatory and corporate accountability narratives. While causality cannot be established from media reports, consistent patterns of high-intensity interactions, user vulnerability, and limited safeguard reporting highlight the need for structured safety surveillance, transparent AI risk auditing, and clearer governance frameworks. As generative AI becomes increasingly integrated into everyday psychosocial contexts, systematic research and formal safety monitoring will be necessary to determine whether media-reported harms correspond to verifiable clinical risk patterns.","affiliation":"Faculty of Medicine, McGill University, Montreal, QC, Canada.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["Scoping Review","review-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Suicide","meshQualifierList":{"meshQualifier":[{"abbreviation":"SN","qualifierName":"statistics & numerical data","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Mental Disorders"},{"majorTopic_YN":"Y","descriptorName":"Mass Media"},{"majorTopic_YN":"Y","descriptorName":"Generative Artificial Intelligence"}]},"keywordList":{"keyword":["Suicide","Self-harm","Psychosis","Media Reporting","Adolescent Mental Health","Digital Mental Health","Artificial Intelligence Chatbots","Generative Artificial Intelligence","Ai Safety","Chatgpt"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/93040"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13077275"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13077275?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":5,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-07-14","dateOfCreation":"2026-03-30","firstIndexDate":"2026-03-31","fullTextReceivedDate":"2026-04-20","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-03-30","firstPublicationDate":"2026-03-30"},{"id":"41273266","source":"MED","pmid":"41273266","pmcid":"PMC12712562","fullTextIdList":{"fullTextId":["PMC12712562"]},"doi":"10.2196/85799","title":"Delusional Experiences Emerging From AI Chatbot Interactions or \"AI Psychosis\".","authorString":"Hudon A, Stip E.","authorList":{"author":[{"fullName":"Hudon A","firstName":"Alexandre","lastName":"Hudon","initials":"A","authorId":{"type":"ORCID","value":"0000-0002-4868-0928"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry and Addictology, Faculty of Medicine, Université de Montréal, Montreal, QC, Canada."},{"affiliation":"Unité de recherche en psychiatrie, Département de psychiatrie, Institut universitaire en santé mentale de Montréal, Montreal, QC, Canada."},{"affiliation":"Centre de recherche, Institut universitaire en santé mentale de Montréal, Montreal, QC, Canada."},{"affiliation":"Department of Psychiatry, Institut national de psychiatrie légale Philippe-Pinel, Montreal, QC, Canada."},{"affiliation":"Centre de recherche en pédagogie de la santé, Université de Montréal, Montreal, QC, Canada."}]}},{"fullName":"Stip E","firstName":"Emmanuel","lastName":"Stip","initials":"E","authorId":{"type":"ORCID","value":"0000-0003-2859-2100"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry and Addictology, Faculty of Medicine, Université de Montréal, Montreal, QC, Canada."},{"affiliation":"Unité de recherche en psychiatrie, Département de psychiatrie, Institut universitaire en santé mentale de Montréal, Montreal, QC, Canada."},{"affiliation":"Centre de recherche, Institut universitaire en santé mentale de Montréal, Montreal, QC, Canada."},{"affiliation":"Department of Psychiatry, United Arab Emirates University, Al-Ain, United Arab Emirates."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-4868-0928"},{"type":"ORCID","value":"0000-0003-2859-2100"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"volume":"12","journalIssueId":4063741,"dateOfPublication":"2025 Dec","monthOfPublication":12,"yearOfPublication":2025,"printPublicationDate":"2025-12-01","journal":{"title":"JMIR mental health","medlineAbbreviation":"JMIR Ment Health","isoabbreviation":"JMIR Ment Health","nlmid":"101658926","essn":"2368-7959","issn":"2368-7959"}},"pubYear":"2025","pageInfo":"e85799","abstractText":"The integration of artificial intelligence (AI) into daily life has introduced unprecedented forms of human-machine interaction, prompting psychiatry to reconsider the boundaries between environment, cognition, and technology. This Viewpoint reviews the concept of \"AI psychosis,\" which is a framework to understand how sustained engagement with conversational AI systems might trigger, amplify, or reshape psychotic experiences in vulnerable individuals. Drawing from phenomenological psychopathology, the stress-vulnerability model, cognitive theory, and digital mental health research, the paper situates AI psychosis at the intersection of predisposition and algorithmic environment. Rather than defining a new diagnostic entity, it examines how immersive and anthropomorphic AI technologies may modulate perception, belief, and affect, altering the prereflective sense of reality that grounds human experience. The argument unfolds through 4 complementary lenses. First, within the stress-vulnerability model, AI acts as a novel psychosocial stressor. Its 24-hour availability and emotional responsiveness may increase allostatic load, disturb sleep, and reinforce maladaptive appraisals. Second, the digital therapeutic alliance, a construct describing relational engagement with digital systems, is conceptualized as a double-edged mediator. While empathic design can enhance adherence and support, uncritical validation by AI systems may entrench delusional conviction or cognitive perseveration, reversing the corrective principles of cognitive-behavioral therapy for psychosis. Third, disturbances in theory of mind offer a cognitive pathway: individuals with impaired or hyperactive mentalization may project intentionality or empathy onto AI, perceiving chatbots as sentient interlocutors. This dyadic misattribution may form a \"digital folie à deux,\" where the AI becomes a reinforcing partner in delusional elaboration. Fourth, emerging risk factors, including loneliness, trauma history, schizotypal traits, nocturnal or solitary AI use, and algorithmic reinforcement of belief-confirming content may play roles at the individual and environmental levels. Building on this synthesis, we advance a translational research agenda and five domains of action: (1) empirical studies using longitudinal and digital-phenotyping designs to quantify dose-response relationships between AI exposure, stress physiology, and psychotic symptomatology; (2) integration of digital phenomenology into clinical assessment and training; (3) embedding therapeutic design safeguards into AI systems, such as reflective prompts and \"reality-testing\" nudges; (4) creation of ethical and governance frameworks for AI-related psychiatric events, modeled on pharmacovigilance; and (5) development of environmental cognitive remediation, a preventive intervention aimed at strengthening contextual awareness and reanchoring experience in the physical and social world. By applying empirical rigor and therapeutic ethics to this emerging interface, clinicians, researchers, patients, and developers can transform a potential hazard into an opportunity to deepen understanding of human cognition, safeguard mental health, and promote responsible AI integration within society.","affiliation":"Department of Psychiatry and Addictology, Faculty of Medicine, Université de Montréal, Montreal, QC, Canada.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Review","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Delusions","meshQualifierList":{"meshQualifier":[{"abbreviation":"ET","qualifierName":"etiology","majorTopic_YN":"N"},{"abbreviation":"PX","qualifierName":"psychology","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Psychotic Disorders","meshQualifierList":{"meshQualifier":[{"abbreviation":"ET","qualifierName":"etiology","majorTopic_YN":"N"},{"abbreviation":"PX","qualifierName":"psychology","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Generative Artificial Intelligence"}]},"keywordList":{"keyword":["Artificial intelligence","Schizophrenia","Delusions","Psychosis","Theory Of Mind","Human-computer Interaction","Phenomenological Psychopathology","Digital Phenotyping","Chatbots","Stress-Vulnerability Model"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/85799"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12712562"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12712562?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":19,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2025-12-03","dateOfCreation":"2025-11-22","firstIndexDate":"2025-11-23","fullTextReceivedDate":"2025-12-22","dateOfRevision":"2025-12-22","electronicPublicationDate":"2025-12-03","firstPublicationDate":"2025-12-03"},{"id":"41701936","source":"MED","pmid":"41701936","pmcid":"PMC12912660","fullTextIdList":{"fullTextId":["PMC12912660"]},"doi":"10.2196/77127","title":"Artificial Intelligence in Medical Education: Transformative Potential, Current Applications, and Future Implications.","authorString":"Izquierdo-Condoy JS, Arias-Intriago M, Montero Corrales L, Ortiz-Prado E.","authorList":{"author":[{"fullName":"Izquierdo-Condoy JS","firstName":"Juan S","lastName":"Izquierdo-Condoy","initials":"JS","authorId":{"type":"ORCID","value":"0000-0002-1178-0546"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"One Health Research Group, Universidad de Las Américas, Via Nayon S/N, Quito, 170124, Ecuador, +593 995760693."}]}},{"fullName":"Arias-Intriago M","firstName":"Marlon","lastName":"Arias-Intriago","initials":"M","authorId":{"type":"ORCID","value":"0009-0002-3717-383X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"One Health Research Group, Universidad de Las Américas, Via Nayon S/N, Quito, 170124, Ecuador, +593 995760693."}]}},{"fullName":"Montero Corrales L","firstName":"Laura","lastName":"Montero Corrales","initials":"L","authorId":{"type":"ORCID","value":"0000-0002-3752-9421"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Escuela de Comunicación, Universidad Latina de Costa Rica, San Jose, Costa Rica."}]}},{"fullName":"Ortiz-Prado E","firstName":"Esteban","lastName":"Ortiz-Prado","initials":"E","authorId":{"type":"ORCID","value":"0000-0002-1895-7498"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"One Health Research Group, Universidad de Las Américas, Via Nayon S/N, Quito, 170124, Ecuador, +593 995760693."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-1178-0546"},{"type":"ORCID","value":"0000-0002-1895-7498"},{"type":"ORCID","value":"0000-0002-3752-9421"},{"type":"ORCID","value":"0009-0002-3717-383X"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"volume":"12","journalIssueId":4112614,"dateOfPublication":"2026 Feb","monthOfPublication":2,"yearOfPublication":2026,"printPublicationDate":"2026-02-01","journal":{"title":"JMIR medical education","medlineAbbreviation":"JMIR Med Educ","isoabbreviation":"JMIR Med Educ","nlmid":"101684518","essn":"2369-3762","issn":"2369-3762"}},"pubYear":"2026","pageInfo":"e77127","abstractText":"<h4>Unlabelled</h4>Artificial intelligence (AI) is increasingly influencing medical education by enabling adaptive learning, AI-assisted assessment, and scalable instructional tools. Natural language processing, machine learning, and generative large language models offer innovative ways to support teaching and learning, yet their integration raises ethical, pedagogical, and infrastructural challenges. This viewpoint article aims to examine the current applications, benefits, and challenges of AI in medical education and propose strategies for responsible and effective integration. AI tools such as chatbots, virtual patients, and intelligent tutoring systems enhance personalized and immersive learning. Automated grading and predictive analytics support efficient evaluations, while AI-assisted writing tools streamline content creation. Despite these advances, concerns persist around data privacy, algorithmic bias, unequal access, and diminished critical thinking. Key solutions include AI literacy training, data oversight, equitable infrastructure, and curriculum reform. The FACETS framework offers 6 dimensions (ie, form, application, context, instructional mode, technology, and the SAMR [substitution, augmentation, modification, redefinition model]) to evaluate AI integration effectively. AI offers substantial opportunities to transform medical education, but its adoption must be ethical, equitable, and pedagogically grounded. Strategic frameworks such as FACETS, combined with institutional governance and cross-sector collaboration, are essential to guide implementation so that AI enhances learning outcomes while preserving the humanistic foundations of medical practice.","affiliation":"One Health Research Group, Universidad de Las Américas, Via Nayon S/N, Quito, 170124, Ecuador, +593 995760693.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Forecasting"},{"majorTopic_YN":"Y","descriptorName":"Education, Medical","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"},{"abbreviation":"TD","qualifierName":"trends","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Artificial Intelligence","meshQualifierList":{"meshQualifier":[{"abbreviation":"TD","qualifierName":"trends","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Generative Artificial Intelligence"},{"majorTopic_YN":"N","descriptorName":"Large Language Models"}]},"keywordList":{"keyword":["Artificial intelligence","Medical education","Machine Learning","Future Implications","Adaptive Learning Systems"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/77127"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12912660"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12912660?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":3,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-07-08","dateOfCreation":"2026-02-17","firstIndexDate":"2026-02-17","fullTextReceivedDate":"2026-02-18","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-02-17","firstPublicationDate":"2026-02-17"},{"id":"42314276","source":"MED","pmid":"42314276","pmcid":"PMC13312132","fullTextIdList":{"fullTextId":["PMC13312132"]},"doi":"10.1016/j.identj.2026.109696","title":"Beyond Explainability: The Trust Paradox of Conversational Artificial Intelligence in Endodontics.","authorString":"Turky M, Dummer PM.","authorList":{"author":[{"fullName":"Turky M","firstName":"Mohammed","lastName":"Turky","initials":"M","authorId":{"type":"ORCID","value":"0000-0002-4250-9951"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Endodontics, Faculty of Dentistry, Minia University, Minia, Egypt; Department of Endodontics, Faculty of Dentistry, Sphinx University, Assiut, Egypt. Electronic address: m.torky.abdelrazik@mu.edu.eg."}]}},{"fullName":"Dummer PM","firstName":"Paul Mh","lastName":"Dummer","initials":"PM","authorId":{"type":"ORCID","value":"0000-0002-0726-7467"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Dentistry, College of Biomedical and Life Sciences, Cardiff University, Cardiff, UK."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-0726-7467"},{"type":"ORCID","value":"0000-0002-4250-9951"}]},"journalInfo":{"issue":"4","volume":"76","journalIssueId":4227336,"dateOfPublication":"2026 Aug","monthOfPublication":8,"yearOfPublication":2026,"printPublicationDate":"2026-08-01","journal":{"title":"International dental journal","medlineAbbreviation":"Int Dent J","isoabbreviation":"Int Dent J","nlmid":"0374714","essn":"1875-595X","issn":"0020-6539"}},"pubYear":"2026","pageInfo":"109696","affiliation":"Department of Endodontics, Faculty of Dentistry, Minia University, Minia, Egypt; Department of Endodontics, Faculty of Dentistry, Sphinx University, Assiut, Egypt. Electronic address: m.torky.abdelrazik@mu.edu.eg.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Letter"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1016/j.identj.2026.109696"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13312132"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13312132?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"N","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by-nc-nd","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCreation":"2026-06-18","firstIndexDate":"2026-06-19","fullTextReceivedDate":"2026-08-19","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-18","firstPublicationDate":"2026-06-18"},{"id":"42042673","source":"MED","pmid":"42042673","pmcid":"PMC13118771","fullTextIdList":{"fullTextId":["PMC13118771"]},"doi":"10.3390/nursrep16040146","title":"AI Tools for Teaching the Safe Administration of Medications in Nursing: A Scoping Review.","authorString":"de Oliveira WDD, Ghirotti MELP, de Sousa ÁFL, Silva ALNVD, de Carvalho HEF, Valim MD, Dos Santos Júnior AG.","authorList":{"author":[{"fullName":"de Oliveira WDD","firstName":"Wínola Dafny Douglas","lastName":"de Oliveira","initials":"WDD","authorId":{"type":"ORCID","value":"0009-0008-7403-0145"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Câmpus de Três Lagoas, Universidade Federal de Mato Grosso do Sul, Três Lagoas 79070-900, MS, Brazil."}]}},{"fullName":"Ghirotti MELP","firstName":"Maria Eduarda Leite Pinto","lastName":"Ghirotti","initials":"MELP","authorId":{"type":"ORCID","value":"0009-0005-0091-9919"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Câmpus de Três Lagoas, Universidade Federal de Mato Grosso do Sul, Três Lagoas 79070-900, MS, Brazil."}]}},{"fullName":"de Sousa ÁFL","firstName":"Álvaro Francisco Lopes","lastName":"de Sousa","initials":"ÁFL","authorId":{"type":"ORCID","value":"0000-0003-2710-2122"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Câmpus de Três Lagoas, Universidade Federal de Mato Grosso do Sul, Três Lagoas 79070-900, MS, Brazil."},{"affiliation":"Public Health Research Centre, Comprehensive Health Research Center, CHRC, REAL, NOVA University Lisbon, 1050-091 Lisbon, Portugal."}]}},{"fullName":"Silva ALNVD","firstName":"Adaiele Lúcia Nogueira Vieira da","lastName":"Silva","initials":"ALNVD","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Câmpus de Campo Grande, Universidade Federal do Mato Grosso do Sul, Campo Grande 79070-900, MS, Brazil."},{"affiliation":"School of Nursing, Federal University of São Carlos (UFSCar), São Carlos 13565-905, SP, Brazil."}]}},{"fullName":"de Carvalho HEF","firstName":"Herica Emília Félix","lastName":"de Carvalho","initials":"HEF","authorId":{"type":"ORCID","value":"0000-0002-5913-8886"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Nursing Program, Universidade Estadual do Maranhão (UEMA), Coroatá 65400-000, MA, Brazil."}]}},{"fullName":"Valim MD","firstName":"Marília Duarte","lastName":"Valim","initials":"MD","authorId":{"type":"ORCID","value":"0000-0002-2746-1865"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Nursing, Federal University of São Carlos (UFSCar), São Carlos 13565-905, SP, Brazil."}]}},{"fullName":"Dos Santos Júnior AG","firstName":"Aires Garcia","lastName":"Dos Santos Júnior","initials":"AG","authorId":{"type":"ORCID","value":"0000-0002-5946-0197"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Câmpus de Três Lagoas, Universidade Federal de Mato Grosso do Sul, Três Lagoas 79070-900, MS, Brazil."},{"affiliation":"Public Health Research Centre, Comprehensive Health Research Center, CHRC, REAL, NOVA University Lisbon, 1050-091 Lisbon, Portugal."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-2746-1865"},{"type":"ORCID","value":"0000-0002-5913-8886"},{"type":"ORCID","value":"0000-0002-5946-0197"},{"type":"ORCID","value":"0000-0003-2710-2122"},{"type":"ORCID","value":"0000-0003-4858-9339"},{"type":"ORCID","value":"0009-0005-0091-9919"},{"type":"ORCID","value":"0009-0008-7403-0145"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"4","volume":"16","journalIssueId":4186077,"dateOfPublication":"2026 Apr","monthOfPublication":4,"yearOfPublication":2026,"printPublicationDate":"2026-04-01","journal":{"title":"Nursing reports (Pavia, Italy)","medlineAbbreviation":"Nurs Rep","isoabbreviation":"Nurs Rep","nlmid":"101592662","essn":"2039-4403","issn":"2039-439X"}},"pubYear":"2026","pageInfo":"146","abstractText":"<b>Background</b>: Safe medication administration is a fundamental aspect of nursing practice and a core component of patient safety. However, systemic failures, workload pressures, and educational gaps continue to contribute to medication errors, posing persistent challenges for healthcare systems. In this context, innovative educational technologies, particularly Artificial Intelligence (AI), have emerged as promising strategies to support the development of competencies related to safe medication administration. <b>Methods</b>: This scoping review aimed to map evidence on AI-based tools used to teach safe medication administration in nursing. The review was conducted in accordance with the Joanna Briggs Institute (JBI) methodology and reported following the PRISMA-ScR guidelines. Searches were performed in PubMed, Scopus, Web of Science, LILACS, and Google Scholar, covering studies published between 2010 and October 2025 in English, Portuguese, and Spanish. Study selection was conducted in two stages, followed by standardized data extraction. <b>Results</b>: A total of 545 records were identified, of which only two studies met the eligibility criteria. The included studies, conducted in Israel and South Korea, evaluated a microlearning chatbot and Large Language Model (LLM)-based tools designed to support teaching safe medication administration. Both studies demonstrated improvements in knowledge and performance in tasks and simulations related to the medication process, as well as positive acceptability among participants. However, neither study assessed direct clinical outcomes, such as reductions in medication errors or preventable adverse events. <b>Conclusions</b>: Although AI-based educational tools show potential to enhance competencies related to medication safety in nursing, the available evidence remains limited. Further robust, multicenter, and comparative studies are needed to evaluate their impact on clinical outcomes and to support their integration into nursing education and practice.","affiliation":"Câmpus de Três Lagoas, Universidade Federal de Mato Grosso do Sul, Três Lagoas 79070-900, MS, Brazil.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"keywordList":{"keyword":["Artificial intelligence","Nursing","Nursing Education","Patient Safety"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3390/nursrep16040146"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13118771"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13118771?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-04-27","dateOfCreation":"2026-04-27","firstIndexDate":"2026-04-27","fullTextReceivedDate":"2026-05-18","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-04-21","firstPublicationDate":"2026-04-21"},{"id":"41355258","source":"MED","pmid":"41355258","pmcid":"PMC12688312","fullTextIdList":{"fullTextId":["PMC12688312"]},"doi":"10.5213/inj.2550274.137","title":"Privacy-by-Design Framework for Large Language Model Chatbots in Urology.","authorString":"Kim EJ, Kim J.","authorList":{"author":[{"fullName":"Kim EJ","firstName":"Eun Joung","lastName":"Kim","initials":"EJ","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Game Contents, Kyungil University, Gyeongsan, Korea."}]}},{"fullName":"Kim J","firstName":"JungYoon","lastName":"Kim","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Game Media, College of Future Industry, Gachon University, Seongnam, Korea."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-2396-9514"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"Suppl 2","volume":"29","journalIssueId":4067801,"dateOfPublication":"2025 Nov","monthOfPublication":11,"yearOfPublication":2025,"printPublicationDate":"2025-11-01","journal":{"title":"International neurourology journal","medlineAbbreviation":"Int Neurourol J","isoabbreviation":"Int Neurourol J","nlmid":"101534513","essn":"2093-6931","issn":"2093-4777"}},"pubYear":"2025","pageInfo":"S65-S72","abstractText":"This review presents a privacy-by-design-based technical and governance framework for the safe clinical deployment of large language model (LLM) chatbots in urology. Given the high sensitivity of urological data involving urinary, sexual, and reproductive health, the proposed approach integrates on-site algorithmic deidentification, federated learning with differential privacy and secure aggregation, and secure retrieval-augmented generation with source citation and audit logging. Collectively, these components establish a federated, explainable, and auditable pipeline that preserves data sovereignty while improving clinical reliability and regulatory compliance. Urology thus serves as a critical test bed for validating the safety, governance, and accountability standards required for broader adoption of LLM-based medical chatbots across clinical domains.","affiliation":"Department of Game Contents, Kyungil University, Gyeongsan, Korea.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["review-article","Journal Article"]},"grantsList":{"grant":[{"grantId":"2025-RISE-15","agency":"Gyeongsangbuk-do RISE project","orderIn":0}]},"keywordList":{"keyword":["Urology","Medical Chatbot","Large Language Model","Privacy-by-design Framework"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.5213/inj.2550274.137"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12688312"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12688312?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by-nc","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2025-12-08","dateOfCreation":"2025-12-08","firstIndexDate":"2025-12-08","fullTextReceivedDate":"2025-12-22","dateOfRevision":"2025-12-11","electronicPublicationDate":"2025-11-30","firstPublicationDate":"2025-11-30"},{"id":"42111317","source":"MED","pmid":"42111317","pmcid":"PMC13154040","fullTextIdList":{"fullTextId":["PMC13154040"]},"doi":"10.3389/frai.2026.1772215","title":"Designing AI for distress: an iterative case study of a hierarchical agent for psychosocial support.","authorString":"Patturajan V, Ravikumar D, Narayanan S, Krishnamurthy V, Santhosh S.","authorList":{"author":[{"fullName":"Patturajan V","firstName":"Vaishnavi","lastName":"Patturajan","initials":"V","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Computer Science and Engineering, Vellore Institute of Technology, Chennai, Tamil Nadu, India."}]}},{"fullName":"Ravikumar D","firstName":"Devipreya","lastName":"Ravikumar","initials":"D","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Computer Science and Engineering, Vellore Institute of Technology, Chennai, Tamil Nadu, India."}]}},{"fullName":"Narayanan S","firstName":"Sneghavalli","lastName":"Narayanan","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Computer Science and Engineering, Vellore Institute of Technology, Chennai, Tamil Nadu, India."}]}},{"fullName":"Krishnamurthy V","firstName":"Vallidevi","lastName":"Krishnamurthy","initials":"V","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Computer Science and Engineering, Vellore Institute of Technology, Chennai, Tamil Nadu, India."}]}},{"fullName":"Santhosh S","firstName":"Stephen","lastName":"Santhosh","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DelMag Innovations, Chennai, Tamil Nadu, India."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0009-0008-7836-8979"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"volume":"9","journalIssueId":4117457,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Frontiers in artificial intelligence","medlineAbbreviation":"Front Artif Intell","isoabbreviation":"Front Artif Intell","nlmid":"101770551","essn":"2624-8212","issn":"2624-8212"}},"pubYear":"2026","pageInfo":"1772215","abstractText":"<h4>Introduction</h4>In recent years, psychosocial issues like bullying and ragging have risen all around the world. Even though there are some victims who report such cases, most of them never do so because of fear, stigma, or mistrust, mainly among students. This scenario highlights the necessity of safe, anonymous, and easily available support system. The promising approach to solving this problem is conversational AI because it allows people to request assistance in a simple and an easy-going way. However, conversational AI systems often lack contextual sensitivity, emotional intelligence, and appropriate support response mechanisms. To address this, there is a need for structured frameworks integrating human-in-the-loop oversight along with preventive and actionable insights to ensure ethical and proportional responses. This paper introduces SocialWellbeing, a socio-technical system which is designed to overcome psychosocial harms in a three-pillar framework.<h4>Methods</h4>The initial pillar offers artificial intelligence-based first-line care whereby users can share their issues anonymously and get caring responses. The second pillar facilitates human-guided escalation where more serious cases are passed to trusted advisors or authorities to provide real-life support. The third pillar is devoted to data-driven prevention, where anonymized data are used to identify trends and serve as a guide in the institutional preventive efforts.<h4>Results</h4>The AI system was tested in two stages. Phase 1 involved prompt engineering that identified the types of incidents, detected the emotions, and generated supportive responses. Phase 2 improved this strategy with a chain-of-thought strategy, which was A.G.E. (Acknowledge-Guide-Escalate) oriented and explicit guidelines and escalation logic to add reliability and clarity to the strategy. Results of this evaluation show that Phase 2 improved the Gemini 2.5 Flash model's classification accuracy to approximately 88%-89%, compared to 84%-86% in Phase 1, with empathy scores increasing from 4.2-4.3 to 4.4-4.8 on a five-point scale. The level of empathy also went up on a five-point scale to 4.4-4.8 as compared to 4.2-4.3.<h4>Discussion</h4>The findings indicate that a structured, hierarchical approach improves the reliability and safety of psychosocial AI systems. The Acknowledge-Guide-Escalate (A.G.E.) framework enables consistent emotional recognition and contextually relevant guidance. The inclusion of human-in-the-loop oversight and preventive, actionable insights strengthens ethical alignment and response quality.","affiliation":"School of Computer Science and Engineering, Vellore Institute of Technology, Chennai, Tamil Nadu, India.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["research-article","Journal Article"]},"keywordList":{"keyword":["Confidentiality","Escalation","Emotional Support","Psychosocial Assistance","Large Language Model","Mental Health Chatbot","Ai-based Guidance","Gemini Api"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/frai.2026.1772215"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13154040"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13154040?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-05-11","dateOfCreation":"2026-05-11","firstIndexDate":"2026-05-13","fullTextReceivedDate":"2026-05-20","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-04-24","firstPublicationDate":"2026-04-24"},{"id":"42305941","source":"MED","pmid":"42305941","pmcid":"PMC13265308","fullTextIdList":{"fullTextId":["PMC13265308"]},"doi":"10.3389/frai.2026.1834985","title":"A multi-agent RAG system for generating SCORM courses from enterprise documents.","authorString":"Amirkhanova G, Amirkhanov B, Amirkhanov A, Aubakirova R.","authorList":{"author":[{"fullName":"Amirkhanova G","firstName":"Gulshat","lastName":"Amirkhanova","initials":"G","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Artificial Intelligence and Big Data, Faculty of Information Technology, Al-Farabi Kazakh National University, Almaty, Kazakhstan."}]}},{"fullName":"Amirkhanov B","firstName":"Bauyrzhan","lastName":"Amirkhanov","initials":"B","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Artificial Intelligence and Big Data, Faculty of Information Technology, Al-Farabi Kazakh National University, Almaty, Kazakhstan."}]}},{"fullName":"Amirkhanov A","firstName":"Alikhan","lastName":"Amirkhanov","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Artificial Intelligence and Big Data, Faculty of Information Technology, Al-Farabi Kazakh National University, Almaty, Kazakhstan."}]}},{"fullName":"Aubakirova R","firstName":"Ramilya","lastName":"Aubakirova","initials":"R","authorId":{"type":"ORCID","value":"0009-0002-8957-6315"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Artificial Intelligence and Big Data, Faculty of Information Technology, Al-Farabi Kazakh National University, Almaty, Kazakhstan."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0009-0002-8957-6315"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"9","journalIssueId":4117457,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Frontiers in artificial intelligence","medlineAbbreviation":"Front Artif Intell","isoabbreviation":"Front Artif Intell","nlmid":"101770551","essn":"2624-8212","issn":"2624-8212"}},"pubYear":"2026","pageInfo":"1834985","abstractText":"Corporate onboarding requires the effective transfer of complex organizational knowledge embedded in internal policies and procedural documents; however, existing artificial intelligence (AI)-driven course generation systems primarily target academic or public knowledge domains. This gap limits the scalability and consistency of enterprise training, particularly in regulated environments where factual accuracy is critical. In this study, we present a multi-agent pipeline that automatically generates Sharable Content Object Reference Model (SCORM) 1.2-compliant e-learning courses from heterogeneous enterprise documents using large language models and retrieval-augmented generation (RAG). The system integrates four stages: semantic document ingestion with structure-aware chunking and embedding, an autonomous ReAct-based architect agent for course design, a parallel content generation pipeline combining multi-query retrieval and neural reranking, and standards-compliant SCORM packaging for deployment in learning management systems. Evaluated using real-world occupational safety documents, the system produced a complete multi-module course with structured lessons and assessments within minutes, demonstrating end-to-end automation of instructional design grounded exclusively in source materials. By ensuring traceability of generated content to organizational knowledge, the approach reduces the risk of hallucinations.","affiliation":"Department of Artificial Intelligence and Big Data, Faculty of Information Technology, Al-Farabi Kazakh National University, Almaty, Kazakhstan.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["research-article","Journal Article"]},"keywordList":{"keyword":["Scorm","Retrieval-augmented Generation","Automated Course Generation","Corporate Onboarding","Enterprise Learning"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/frai.2026.1834985"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13265308"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13265308?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-06-17","dateOfCreation":"2026-06-17","firstIndexDate":"2026-06-18","fullTextReceivedDate":"2026-06-25","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-01","firstPublicationDate":"2026-06-01"},{"id":"41719483","source":"MED","pmid":"41719483","pmcid":"PMC12923100","fullTextIdList":{"fullTextId":["PMC12923100"]},"doi":"10.2196/79044","title":"AI and Digital Tools in Dermatology: Addressing Access and Misinformation.","authorString":"du Crest D, Madhumita M, Enbiale W, Ruiz Postigo JA, Malvehy J, Wongvibulsin S, Gupta S, Kittler H, Skayem C, Mahto A, Adamson AS, Lipoff JB, Papier A, Cartier H, Garson S, Freeman E.","authorList":{"author":[{"fullName":"du Crest D","firstName":"Dominique","lastName":"du Crest","initials":"D","authorId":{"type":"ORCID","value":"0000-0002-2496-3018"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"SkinAid SAS, 50 Rue Danton, Levallois Perret, 92300, France, 33 620715128."}]}},{"fullName":"Madhumita M","firstName":"Monisha","lastName":"Madhumita","initials":"M","authorId":{"type":"ORCID","value":"0000-0001-5652-8785"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Dermatology, Saveetha Medical College, Chennai, India."}]}},{"fullName":"Enbiale W","firstName":"Wendemagegn","lastName":"Enbiale","initials":"W","authorId":{"type":"ORCID","value":"0000-0002-0692-850X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"College of Medicine and Health Sciences, Bahir Dar University, Bahir Dar, Ethiopia."}]}},{"fullName":"Ruiz Postigo JA","firstName":"Jose Antonio","lastName":"Ruiz Postigo","initials":"JA","authorId":{"type":"ORCID","value":"0000-0002-7165-8358"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"World Health Organization, Geneva, Switzerland."}]}},{"fullName":"Malvehy J","firstName":"Josep","lastName":"Malvehy","initials":"J","authorId":{"type":"ORCID","value":"0000-0002-6998-914X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Centro de Investigación Biomédica en Red de Enfermedades Raras Instituto de Salud Carlos III, Barcelona, Spain."}]}},{"fullName":"Wongvibulsin S","firstName":"Shannon","lastName":"Wongvibulsin","initials":"S","authorId":{"type":"ORCID","value":"0000-0002-1390-7440"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Dermatology, Department of Medicine, David Geffen School of Medicine, University of California, Los Angeles, CA, United States."}]}},{"fullName":"Gupta S","firstName":"Somesh","lastName":"Gupta","initials":"S","authorId":{"type":"ORCID","value":"0000-0003-3015-8602"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"All India Institute of Medical Sciences, New Delhi, New Delhi, India."}]}},{"fullName":"Kittler H","firstName":"Harald","lastName":"Kittler","initials":"H","authorId":{"type":"ORCID","value":"0000-0002-0051-8016"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Dermatology, Medical University of Vienna, Vienna, Austria."}]}},{"fullName":"Skayem C","firstName":"Charbel","lastName":"Skayem","initials":"C","authorId":{"type":"ORCID","value":"0000-0002-4498-0683"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Hôpital Ambroise-Paré, Boulogne Billancourt, France."}]}},{"fullName":"Mahto A","firstName":"Anjali","lastName":"Mahto","initials":"A","authorId":{"type":"ORCID","value":"0009-0009-1908-1350"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Self London, London, United Kingdom."}]}},{"fullName":"Adamson AS","firstName":"Adewole S","lastName":"Adamson","initials":"AS","authorId":{"type":"ORCID","value":"0000-0002-1493-1776"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"University of Texas at Austin Dell Medical School, Austin, TX, United States."}]}},{"fullName":"Lipoff JB","firstName":"Jules B","lastName":"Lipoff","initials":"JB","authorId":{"type":"ORCID","value":"0000-0002-0557-4260"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Dermatology, Lewis Katz School of Medicine, Temple University, Philadelphia, PA, United States."}]}},{"fullName":"Papier A","firstName":"Art","lastName":"Papier","initials":"A","authorId":{"type":"ORCID","value":"0000-0002-0181-0481"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Dermatology, University of Rochester College of Medicine, Rochester, NY, United States."}]}},{"fullName":"Cartier H","firstName":"Hugues","lastName":"Cartier","initials":"H","authorId":{"type":"ORCID","value":"0000-0003-3334-7601"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Saint-Jean Clinic of Dermatology, Arras, France."}]}},{"fullName":"Garson S","firstName":"Sébastien","lastName":"Garson","initials":"S","authorId":{"type":"ORCID","value":"0009-0002-1679-6552"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"SELARL Dr GARSON, Senlis, France."}]}},{"fullName":"Freeman E","firstName":"Esther","lastName":"Freeman","initials":"E","authorId":{"type":"ORCID","value":"0000-0001-7751-9466"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Massachusetts General Hospital, Department of Dermatology, Boston, MA, United States."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5652-8785"},{"type":"ORCID","value":"0000-0001-7751-9466"},{"type":"ORCID","value":"0000-0002-0051-8016"},{"type":"ORCID","value":"0000-0002-0181-0481"},{"type":"ORCID","value":"0000-0002-0557-4260"},{"type":"ORCID","value":"0000-0002-0692-850X"},{"type":"ORCID","value":"0000-0002-1390-7440"},{"type":"ORCID","value":"0000-0002-1493-1776"},{"type":"ORCID","value":"0000-0002-2496-3018"},{"type":"ORCID","value":"0000-0002-4498-0683"},{"type":"ORCID","value":"0000-0002-6998-914X"},{"type":"ORCID","value":"0000-0002-7165-8358"},{"type":"ORCID","value":"0000-0003-3015-8602"},{"type":"ORCID","value":"0000-0003-3334-7601"},{"type":"ORCID","value":"0009-0002-1679-6552"},{"type":"ORCID","value":"0009-0009-1908-1350"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"volume":"9","journalIssueId":4116161,"dateOfPublication":"2026 Feb","monthOfPublication":2,"yearOfPublication":2026,"printPublicationDate":"2026-02-01","journal":{"title":"JMIR dermatology","medlineAbbreviation":"JMIR Dermatol","isoabbreviation":"JMIR Dermatol","nlmid":"101770607","essn":"2562-0959","issn":"2562-0959"}},"pubYear":"2026","pageInfo":"e79044","abstractText":"<h4>Unlabelled</h4>Digital dermatology, which is defined as the use of digital technologies that leverage individual- and population-level skin data to improve the diagnosis, treatment, and prevention of skin diseases, has emerged as a critical frontier for bridging persistent gaps in dermatologic care. This transformation holds particular promise for addressing long-standing inequities linked to geography, income, and skin type. According to the Global Burden of Disease 2023 study, skin and subcutaneous diseases remain among the most prevalent global health conditions, contributing substantially to disability-adjusted life years. Digital tools (including teledermatology, artificial intelligence [AI], and large language models) offer new ways to extend diagnosis, education, and patient empowerment to historically underserved populations. However, these same innovations risk amplifying disparities if they are not designed and deployed intentionally. Algorithmic bias, uneven digital access, and the absence of culturally responsive models can undermine progress. In this conceptual and narrative review, we draw on expert dialogues and illustrative literature, including multistakeholder exchanges at the Skin and Digital Summit (2023-2025) and related global forums, to examine how digital dermatology can promote equitable skin health. We focus on 3 interlinked priorities: expanding access through scalable digital platforms, ensuring AI fairness via comprehensive and diverse datasets, and countering dermatological misinformation. Central to the latter is a bot concept described here as a dynamic cycle that analyzes scientific literature; ranks evidence; translates complex research into clear language; and delivers trustworthy, personalized guidance to both consumers and clinicians. By embedding expert oversight and evidence prioritization, such tools can ensure that accurate, actionable information reaches users at the speed and scale of the internet. Drawing on case studies (including lessons from the World Health Organization's AI skin health app) and insights from the Skin and Digital Summit, we highlight both the transformative potential and the ethical complexities of these digital solutions. To navigate this evolving landscape, we propose the concept of radical dermatology, which confronts the reality that big tech is reshaping skin health whether we like it or not and insists that dermatologists and stakeholders lead the transformation through bold collaboration and unwavering clinical relevance.","affiliation":"SkinAid SAS, 50 Rue Danton, Levallois Perret, 92300, France, 33 620715128.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Review","Journal Article"]},"grantsList":{"grant":[{"grantId":"001","agency":"World Health Organization","acronym":"WHO_","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Skin Diseases","meshQualifierList":{"meshQualifier":[{"abbreviation":"DI","qualifierName":"diagnosis","majorTopic_YN":"N"},{"abbreviation":"TH","qualifierName":"therapy","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Communication"},{"majorTopic_YN":"Y","descriptorName":"Dermatology","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"},{"abbreviation":"TD","qualifierName":"trends","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Telemedicine"},{"majorTopic_YN":"Y","descriptorName":"Artificial Intelligence"},{"majorTopic_YN":"N","descriptorName":"Digital Health"},{"majorTopic_YN":"N","descriptorName":"Digital Media"}]},"keywordList":{"keyword":["Artificial intelligence","SKin","AI","Dermatology","Misinformation","Teledermatology","Global Health","Social Media","Digital Health","Llm","Health Tech","Ethical Ai","Digital Dermatology","Large Language Model","Radical Dermatology","Ai In Health Care"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/79044"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12923100"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12923100?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-07-08","dateOfCreation":"2026-02-20","firstIndexDate":"2026-02-21","fullTextReceivedDate":"2026-02-21","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-02-20","firstPublicationDate":"2026-02-20"},{"id":"41975946","source":"MED","pmid":"41975946","pmcid":"PMC13073234","fullTextIdList":{"fullTextId":["PMC13073234"]},"doi":"10.3390/healthcare14070943","title":"Artificial Intelligence-Driven Tools in Mental Health Service Delivery: A Scoping Review.","authorString":"Woo Y, Jung K.","authorList":{"author":[{"fullName":"Woo Y","firstName":"Yeshin","lastName":"Woo","initials":"Y","authorId":{"type":"ORCID","value":"0000-0003-2773-3848"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Research & Development, Incheon Metropolitan Mental Health Welfare Center, Incheon 22106, Republic of Korea."}]}},{"fullName":"Jung K","firstName":"Kibum","lastName":"Jung","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Physical Therapy, Graduate School, Sahmyook University, Seoul 01795, Republic of Korea."},{"affiliation":"Department of Physical Therapy, Kangbuk Samsung Hospital, Seoul 03181, Republic of Korea."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0003-2773-3848"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics"]},"journalInfo":{"issue":"7","volume":"14","journalIssueId":4179658,"dateOfPublication":"2026 Apr","monthOfPublication":4,"yearOfPublication":2026,"printPublicationDate":"2026-04-01","journal":{"title":"Healthcare (Basel, Switzerland)","medlineAbbreviation":"Healthcare (Basel)","isoabbreviation":"Healthcare (Basel)","nlmid":"101666525","essn":"2227-9032","issn":"2227-9032"}},"pubYear":"2026","pageInfo":"943","abstractText":"<b>Background</b>: Artificial intelligence (AI) holds transformative potential for mental health services. However, existing reviews have predominantly focused on algorithmic accuracy, with limited attention to how these technologies are implemented and integrated into real-world service delivery. This scoping review addresses this gap by examining the contexts in which AI technologies-including large language models (LLMs) and machine learning-are implemented, as well as the factors influencing their sustainable adoption within real-world mental health service systems. <b>Methods</b>: Following the established methodological framework, a systematic search (2015-2026) was conducted in PubMed and Scopus. Two independent reviewers screened an initial pool of 829 records using Zotero and Rayyan to minimize selection bias. Following title, abstract, and full-text screening based on predefined eligibility criteria, 26 studies focusing on real-world AI applications (e.g., clinical settings, community services, and case management) were included in the final synthesis. <b>Results</b>: The findings indicate a rapid acceleration in research, with 50% of included studies (<i>n</i> = 13) published since 2024. AI-driven decision support systems were the most prevalent (50%, <i>n</i> = 13), followed by predictive machine learning models (27%) and generative AI applications (15%). Most tools were designed for clinician use (77%) and implemented in hospital-based settings (46%). Although 46% of studies reported real-world implementation, more than half remained at the pilot stage. Notably, research emphasis has shifted from technical efficacy toward feasibility, and implementation contexts (<i>n</i> = 17). <b>Conclusion</b>: AI in mental health is transitioning from laboratory validation to real-world integration. However, the current landscape remains heavily centered on clinician workflows and screening functions, with limited expansion into community-based recovery and long-term prevention. To move beyond the pilot stage, future initiatives should prioritize seamless workflow integration and the application of structured ethical and implementation frameworks that support clinician-patient relationships. This review provides an evidentiary basis for advancing sustainable, AI-enhanced mental health service delivery.","affiliation":"Department of Research & Development, Incheon Metropolitan Mental Health Welfare Center, Incheon 22106, Republic of Korea.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"keywordList":{"keyword":["Artificial intelligence","Mental Health Services","Implementation Science","Scoping Review","Digital Health","Large Language Models"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3390/healthcare14070943"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13073234"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13073234?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-04-14","dateOfCreation":"2026-04-14","firstIndexDate":"2026-04-14","fullTextReceivedDate":"2026-04-20","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-04-03","firstPublicationDate":"2026-04-03"},{"id":"42083979","source":"MED","pmid":"42083979","pmcid":"PMC13236030","fullTextIdList":{"fullTextId":["PMC13236030"]},"doi":"10.1097/yco.0000000000001088","title":"Opportunities and risks of large language models in digital interventions for substance use disorders.","authorString":"de Vries M, Schaub MP.","authorList":{"author":[{"fullName":"de Vries M","firstName":"Marissa","lastName":"de Vries","initials":"M","authorId":{"type":"ORCID","value":"0009-0007-1689-2209"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Research Department Jellinek, Arkin, Amsterdam Netherlands."}]}},{"fullName":"Schaub MP","firstName":"Michael P","lastName":"Schaub","initials":"MP","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Swiss Research Institute for Public Health and Addiction, associated to the University of Zurich, Zurich, Switzerland."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0009-0007-1689-2209"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics"]},"journalInfo":{"issue":"4","volume":"39","journalIssueId":4202499,"dateOfPublication":"2026 Jul","monthOfPublication":7,"yearOfPublication":2026,"printPublicationDate":"2026-07-01","journal":{"title":"Current opinion in psychiatry","medlineAbbreviation":"Curr Opin Psychiatry","isoabbreviation":"Curr Opin Psychiatry","nlmid":"8809880","essn":"1473-6578","issn":"0951-7367"}},"pubYear":"2026","pageInfo":"308-313","abstractText":"<h4>Purpose of review</h4>Large language models (LLMs) are increasingly integrated into digital mental health tools, yet their role in substance use disorder (SUD) interventions remains poorly understood. This review synthesizes emerging evidence on the opportunities and risks of applying LLMs across the digital SUD care continuum.<h4>Recent findings</h4>Studies report promising applications in early detection, personalized support, continuous monitoring, and relapse prevention. LLMs demonstrate capacity to extract substance-use signals from natural language, generate supportive and motivational responses, and interpret narrative data for patient-reported outcomes. However, risks are substantial. LLMs can produce inaccurate or hallucinated content, may reinforce stigma or demographic bias, and can generate misleading or potentially unsafe advice. Privacy concerns are amplified in SUD contexts, where sensitive data are often managed outside regulated healthcare systems. Existing regulatory frameworks such as the EU AI Act or U.S. device regulations, do not yet provide clear governance for anonymous, AI-supported SUD interventions.<h4>Summary</h4>LLMs have potential to expand scalable, low-threshold support for SUDs, but their safe deployment requires validation, bias mitigation, transparent data governance, and robust human oversight. Evidence remains preliminary, and clinical integration should proceed cautiously.","affiliation":"Research Department Jellinek, Arkin, Amsterdam Netherlands.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["research-article","Review","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Substance-Related Disorders","meshQualifierList":{"meshQualifier":[{"abbreviation":"TH","qualifierName":"therapy","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Digital Health"},{"majorTopic_YN":"Y","descriptorName":"Large Language Models"}]},"keywordList":{"keyword":["Artificial intelligence","Substance Use Disorder","Digital Interventions","Large Language Models"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1097/YCO.0000000000001088"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13236030"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13236030?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-07-16","dateOfCreation":"2026-05-05","firstIndexDate":"2026-05-13","fullTextReceivedDate":"2026-06-07","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-04-29","firstPublicationDate":"2026-04-29"},{"id":"41781954","source":"MED","pmid":"41781954","pmcid":"PMC13069786","fullTextIdList":{"fullTextId":["PMC13069786"]},"doi":"10.1186/s12912-026-04518-x","title":"Advantages and challenges for utilization of generative artificial intelligence in clinical nursing practice: an integrative review.","authorString":"Han GI, Choi H, Son YJ.","authorList":{"author":[{"fullName":"Han GI","firstName":"Ga In","lastName":"Han","initials":"GI","authorId":{"type":"ORCID","value":"0009-0000-0510-6136"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Graduate School of Nursing, Chung-Ang University, 84 Heukseok ro, Dongjak-gu, Seoul, 06974, South Korea."}]}},{"fullName":"Choi H","firstName":"Hyeyeon","lastName":"Choi","initials":"H","authorId":{"type":"ORCID","value":"0009-0007-0269-2767"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Surgery Intensive Care Unit, Samsung Medical Center, 81, Irwon-ro, Gangnam-gu, Seoul, 06351, South Korea."}]}},{"fullName":"Son YJ","firstName":"Youn-Jung","lastName":"Son","initials":"YJ","authorId":{"type":"ORCID","value":"0000-0002-0961-9606"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Red Cross College of Nursing, Chung-Ang University, 84 Heukseok ro, Dongjak-gu, Seoul, 06974, South Korea. yjson@cau.ac.kr."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-0961-9606"},{"type":"ORCID","value":"0009-0000-0510-6136"},{"type":"ORCID","value":"0009-0007-0269-2767"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"1","volume":"25","journalIssueId":4142938,"dateOfPublication":"2026 Mar","monthOfPublication":3,"yearOfPublication":2026,"printPublicationDate":"2026-03-01","journal":{"title":"BMC nursing","medlineAbbreviation":"BMC Nurs","isoabbreviation":"BMC Nurs","nlmid":"101088683","essn":"1472-6955","issn":"1472-6955"}},"pubYear":"2026","pageInfo":"347","abstractText":"<h4>Background</h4>Generative artificial intelligence (AI) has the potential to ease the administrative burden placed on nurses and to advance the quality and efficiency of care. Emerging nursing evidence suggests that increasing clinical complexity is associated with missed care, indicating that generative AI may play a role in supporting clinical judgment and streamlining nursing workflows. Despite these possibilities, its use within nursing area remains at an early developmental stage. This study aims to explore current applications of generative AI in clinical nursing, and to identify its advantages and challenges.<h4>Methods</h4>This integrative review followed the updated methodology of Whittemore and Knafl in 2005. Individual studies in this review were selected based on their relevance to the utilization of generative AI in clinical nursing practice. A literature search was conducted using PubMed, Cochrane, CINAHL, Web of Science, EMBASE, SCOPUS, and Google Scholar, covering the period from January 2000 to September 2025. A quality assessment was performed using a mixed-methods appraisal tool.<h4>Results</h4>The 15 included studies, which were published between 2023 and 2025, comprised randomized controlled trials, cross-sectional studies, qualitative studies, and mixed-methods studies. In clinical nursing practice, generative AI is mainly utilized in three areas: clinical decision-making support, patient education and self-management support for chronic diseases, and efficiency of nursing work. The most common purpose of generative AI is to enhance nursing efficiency. ChatGPT is most frequently used in clinical decision-making support and enhancing nursing workflows, while task-oriented chatbots are primarily applied to patient education and self-management. Generative AI requires enhanced accuracy and reliability through continuous learning from new data, empathic conversations, and human interaction.<h4>Conclusions</h4>Our findings suggest that the use of generative AI in nursing practice has the potential to support clinical decision-making, educate patients and enable self-management, and improve nursing efficiency. By reducing documentation burdens, optimizing workflows and enabling personalized care, generative AI could enhance nursing practice. However, these findings should be interpreted cautiously given the heterogeneity of study designs and the predominantly exploratory nature of the available evidence. The integration of generative AI into nursing practice requires continued improvements in accuracy, reliability, empathic interaction and meaningful human involvement. These potential benefits can be realized by nurses, with appropriate competencies and a critical understanding of both the advantages and limitations of generative AI being fostered.<h4>Clinical trial number</h4>Not applicable.","affiliation":"Graduate School of Nursing, Chung-Ang University, 84 Heukseok ro, Dongjak-gu, Seoul, 06974, South Korea.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"grantsList":{"grant":[{"grantId":"RS-2025-24803234","agency":"the National Research Foundation of Korea (NRF)","orderIn":0},{"grantId":"RS-2025-24803234","agency":"the National Research Foundation of Korea","orderIn":0}]},"keywordList":{"keyword":["Hospitals","Nurses","Review Literature As Topic","Practical Nursing","Generative Artificial Intelligence"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1186/s12912-026-04518-x"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13069786"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13069786?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":1,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by-nc-nd","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-04-11","dateOfCreation":"2026-03-04","firstIndexDate":"2026-03-06","fullTextReceivedDate":"2026-04-12","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-03-04","firstPublicationDate":"2026-03-04"},{"id":"41663720","source":"MED","pmid":"41663720","pmcid":"PMC13000207","fullTextIdList":{"fullTextId":["PMC13000207"]},"doi":"10.1038/s41746-026-02432-9","title":"Toward integrated sleep health: multimodal AI in Hang Hao Meng agent.","authorString":"Cai M, Liang S, Zhen S, Wei S, Sun T, Liu J, Mao H, Zhang J.","authorList":{"author":[{"fullName":"Cai M","firstName":"Mingjian","lastName":"Cai","initials":"M","authorId":{"type":"ORCID","value":"0000-0002-3424-7242"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Affiliated Mental Health Center & Hangzhou Seventh People's Hospital, Zhejiang University School of Medicine, Hangzhou, Zhejiang, China."}]}},{"fullName":"Liang S","firstName":"Sugai","lastName":"Liang","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Affiliated Mental Health Center & Hangzhou Seventh People's Hospital, Zhejiang University School of Medicine, Hangzhou, Zhejiang, China."}]}},{"fullName":"Zhen S","firstName":"Shuai","lastName":"Zhen","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Ant Group, Hangzhou, China."}]}},{"fullName":"Wei S","firstName":"Siwei","lastName":"Wei","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Affiliated Mental Health Center & Hangzhou Seventh People's Hospital, Zhejiang University School of Medicine, Hangzhou, Zhejiang, China."}]}},{"fullName":"Sun T","firstName":"Tao","lastName":"Sun","initials":"T","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Ant Group, Hangzhou, China."}]}},{"fullName":"Liu J","firstName":"Junwei","lastName":"Liu","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Ant Group, Hangzhou, China."}]}},{"fullName":"Mao H","firstName":"Hongjing","lastName":"Mao","initials":"H","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Affiliated Mental Health Center & Hangzhou Seventh People's Hospital, Zhejiang University School of Medicine, Hangzhou, Zhejiang, China. 13777861972@163.com."}]}},{"fullName":"Zhang J","firstName":"Junhang","lastName":"Zhang","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Affiliated Mental Health Center & Hangzhou Seventh People's Hospital, Zhejiang University School of Medicine, Hangzhou, Zhejiang, China. 13757155899@163.com."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-3424-7242"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"1","volume":"9","journalIssueId":4112760,"dateOfPublication":"2026 Feb","monthOfPublication":2,"yearOfPublication":2026,"printPublicationDate":"2026-02-01","journal":{"title":"NPJ digital medicine","medlineAbbreviation":"NPJ Digit Med","isoabbreviation":"NPJ Digit Med","nlmid":"101731738","essn":"2398-6352","issn":"2398-6352"}},"pubYear":"2026","pageInfo":"232","abstractText":"This Perspective introduces 'Hang Hao Meng', an AI-powered sleep health expert agent for comprehensive patient management. Leveraging large language models, multimodal analytics, and a digital-human interface, it delivers end-to-end services from screening to personalized treatment. Deployed at scale, the agent has provided triage for over four million individuals and completed 90,000+ screenings, demonstrating a scalable model for enhancing accessibility and personalized care in sleep medicine.","affiliation":"Affiliated Mental Health Center & Hangzhou Seventh People's Hospital, Zhejiang University School of Medicine, Hangzhou, Zhejiang, China.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"grantsList":{"grant":[{"grantId":"2024C04024","agency":"Pioneer and Leading Goose Research and Development Program of Zhejiang Province; the East-West Cooperation Program","orderIn":0},{"grantId":"2024XHSZ-Z06","agency":"Research Program of the Zhejiang Health Information Association","orderIn":0},{"grantId":"2024C04024","agency":"Pioneer and Leading Goose Research and Development Program of Zhejiang Province; the East–West Cooperation Program","orderIn":0},{"grantId":"2025C01103","agency":"Annual “Pioneer &amp; Leader + X” Science and Technology Plan of the Zhejiang Provincial Department of Science and Technology","orderIn":0},{"grantId":"2025C01103","agency":"Annual \"Pioneer & Leader + X\" Science and Technology Plan of the Zhejiang Provincial Department of Science and Technology","orderIn":0}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1038/s41746-026-02432-9"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13000207"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13000207?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by-nc-nd","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-03-19","dateOfCreation":"2026-02-09","firstIndexDate":"2026-02-10","fullTextReceivedDate":"2026-03-20","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-02-09","firstPublicationDate":"2026-02-09"},{"id":"42275394","source":"MED","pmid":"42275394","pmcid":"PMC13257963","fullTextIdList":{"fullTextId":["PMC13257963"]},"doi":"10.1371/journal.pdig.0001453","title":"Clinical artificial intelligence applications of vision-language foundation models.","authorString":"Thirunavukarasu AJ, Li S, Qin P, Nie D, Sanghera R, Lim E, Yu J, Zhang L.","authorList":{"author":[{"fullName":"Thirunavukarasu AJ","firstName":"Arun James","lastName":"Thirunavukarasu","initials":"AJ","authorId":{"type":"ORCID","value":"0000-0001-8968-4768"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Clinical Neurosciences, Medical Sciences Division, University of Oxford, Oxford, United Kingdom."},{"affiliation":"International Centre for Eye Health, London School of Hygiene and Tropical Medicine, London, United Kingdom."}]}},{"fullName":"Li S","firstName":"Siyou","lastName":"Li","initials":"S","authorId":{"type":"ORCID","value":"0009-0007-6840-5791"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Electronic Engineering and Computer Science, Queen Mary University of London, London, United Kingdom."}]}},{"fullName":"Qin P","firstName":"Pengyao","lastName":"Qin","initials":"P","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Engineering, College of Engineering and Physical Sciences, University of Birmingham, Birmingham, United Kingdom."}]}},{"fullName":"Nie D","firstName":"Dong","lastName":"Nie","initials":"D","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Meta AI, Meta Platforms Inc., Menlo Park, California, United States of America."}]}},{"fullName":"Sanghera R","firstName":"Rohan","lastName":"Sanghera","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Clinical Neurosciences, Medical Sciences Division, University of Oxford, Oxford, United Kingdom."},{"affiliation":"Heidi Health, Melbourne, Australia‌‌‌‌‌‌‌‌."}]}},{"fullName":"Lim E","firstName":"Ernest","lastName":"Lim","initials":"E","authorId":{"type":"ORCID","value":"0000-0002-6972-0511"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute for Safe Autonomy, University of York, York, United Kingdom."},{"affiliation":"Ufonia Ltd., Oxford, United Kingdom."},{"affiliation":"Moorfields Eye Hospital NHS Foundation Trust, London, United Kingdom."}]}},{"fullName":"Yu J","firstName":"Juntao","lastName":"Yu","initials":"J","authorId":{"type":"ORCID","value":"0000-0001-7971-9154"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Electronic Engineering and Computer Science, Queen Mary University of London, London, United Kingdom."}]}},{"fullName":"Zhang L","firstName":"Le","lastName":"Zhang","initials":"L","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Engineering, College of Engineering and Physical Sciences, University of Birmingham, Birmingham, United Kingdom."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-7971-9154"},{"type":"ORCID","value":"0000-0001-8968-4768"},{"type":"ORCID","value":"0000-0002-6972-0511"},{"type":"ORCID","value":"0009-0007-6840-5791"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"6","volume":"5","journalIssueId":4204541,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"printPublicationDate":"2026-06-01","journal":{"title":"PLOS digital health","medlineAbbreviation":"PLOS Digit Health","isoabbreviation":"PLOS Digit Health","nlmid":"9918335064206676","essn":"2767-3170","issn":"2767-3170"}},"pubYear":"2026","pageInfo":"e0001453","abstractText":"Vision-language models (VLMs) represent a transformative advance in generative artificial intelligence (AI), using multimodal data processing to enhance clinical decision-making and workflow efficiency. Built on transformer architectures, VLMs excel in tasks like image interpretation, report generation, and visual question-answering, with emerging applications in radiology, pathology, and broader clinical practice. Their potential extends to automating documentation, improving medical education, and assisting with clinical decision-making in real-time. However, successful integration requires rigorous validation to address challenges such as bias, interpretability, and safety concerns. Prospective clinical trials, health economic evaluations, and stakeholder engagement are essential to ensure equitable and effective deployment. Regulatory frameworks must evolve to accommodate VLM functionality while maintaining accountability and protecting patient safety. By balancing innovation with robust oversight, VLMs hold promise in reducing clinician workload, expanding access to expert care, and advancing precision medicine-ushering in a new era of AI-augmented healthcare.","affiliation":"Department of Clinical Neurosciences, Medical Sciences Division, University of Oxford, Oxford, United Kingdom.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1371/journal.pdig.0001453"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13257963"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13257963?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-06-11","dateOfCreation":"2026-06-11","firstIndexDate":"2026-06-12","fullTextReceivedDate":"2026-06-13","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-11","firstPublicationDate":"2026-06-11"},{"id":"42247409","source":"MED","pmid":"42247409","pmcid":"PMC13240874","fullTextIdList":{"fullTextId":["PMC13240874"]},"doi":"10.1371/journal.pone.0350748","title":"The application of large language models in bariatric surgery: A scoping review.","authorString":"Guo N, Li X, Li X, Kang C, Gong X, Ji X, Zheng J.","authorList":{"author":[{"fullName":"Guo N","firstName":"Ningjing","lastName":"Guo","initials":"N","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Nursing, Shanxi Medical University, Shanxi, China."}]}},{"fullName":"Li X","firstName":"Xuyan","lastName":"Li","initials":"X","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Nursing, Shanxi Medical University, Shanxi, China."},{"affiliation":"Heping Hospital Affiliated to Changzhi Medical College, Shanxi, China."}]}},{"fullName":"Li X","firstName":"Xiaoxue","lastName":"Li","initials":"X","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Nursing, Shanxi Medical University, Shanxi, China."}]}},{"fullName":"Kang C","firstName":"Congmin","lastName":"Kang","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Nursing, Shanxi Medical University, Shanxi, China."}]}},{"fullName":"Gong X","firstName":"Xiaoyan","lastName":"Gong","initials":"X","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Nursing, Shanxi Medical University, Shanxi, China."}]}},{"fullName":"Ji X","firstName":"Xinyu","lastName":"Ji","initials":"X","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Nursing, Shanxi Medical University, Shanxi, China."}]}},{"fullName":"Zheng J","firstName":"Jie","lastName":"Zheng","initials":"J","authorId":{"type":"ORCID","value":"0000-0002-7332-4837"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Nursing, Shanxi Medical University, Shanxi, China."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-7332-4837"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"6","volume":"21","journalIssueId":4204536,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"PloS one","medlineAbbreviation":"PLoS One","isoabbreviation":"PLoS One","nlmid":"101285081","essn":"1932-6203","issn":"1932-6203"}},"pubYear":"2026","pageInfo":"e0350748","abstractText":"<h4>Background</h4>Exploratory applications of large language models within the specialized field of metabolic and bariatric surgery have begun to emerge. Nevertheless, existing research remains fragmented, lacking comprehensive integration.<h4>Objective</h4>To conduct a scoping review of studies on the application of large language models in the field of metabolic and bariatric surgery, aiming to provide a reference for clinical practice and future research.<h4>Methods</h4>This scoping review adhered to the Joanna Briggs Institute methodological framework and followed the preferred reporting items for systematic reviews and meta-Analyses extension for scoping reviews (PRISMA-ScR) guidelines.PubMed, Web of Science, The Cochrane Library, Embase, CINAHL, CNKI, Wanfang, and VIP databases were searched for relevant studies, with the search timeframe from database inception to November 2025. The included literature was summarized and analyzed.<h4>Results</h4>A total of 21 English-language studies were included. LLMs were primarily applied in scenarios such as patient education and information consultation, clinical decision support, and professional knowledge assessment. While LLMs performed well in information-provision tasks, they showed low consistency with expert opinions in complex clinical tasks such as individualized surgical recommendations. Performance varied across different models, with GPT-4 generally demonstrating superior performance, and domain-specific models showing professional potential. Current research still faces challenges regarding information accuracy, readability, and clinical applicability.<h4>Conclusion</h4>Large language models hold auxiliary potential in the field of metabolic and bariatric surgery, particularly for knowledge dissemination and patient education. However, their reliability in complex clinical decision-making remains limited. Future efforts should focus on conducting high-quality studies, advancing model specialization and standardized evaluation, and exploring safe and effective human-AI collaboration models.","affiliation":"School of Nursing, Shanxi Medical University, Shanxi, China.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["Scoping Review","research-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Bariatric Surgery","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Large Language Models"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1371/journal.pone.0350748"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13240874"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13240874?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-06-06","dateOfCreation":"2026-06-05","firstIndexDate":"2026-06-06","fullTextReceivedDate":"2026-06-07","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-05","firstPublicationDate":"2026-06-05"},{"id":"42160748","source":"MED","pmid":"42160748","pmcid":"PMC13234539","fullTextIdList":{"fullTextId":["PMC13234539"]},"doi":"10.2196/84683","title":"Development, Feasibility, Acceptability, and Usability of an Artificial Intelligence-Powered Chatbot (Suzy) to Support Patients in Substance Use Disorder Recovery: Multiphase Study.","authorString":"Comulada WS, Swendeman D, Ho YX, Streck JM, Lewis DM, Rezai R, Warren D, Pachas G, Chandler M, Jackson JL, Gelberg L.","authorList":{"author":[{"fullName":"Comulada WS","firstName":"Warren Scott","lastName":"Comulada","initials":"WS","authorId":{"type":"ORCID","value":"0000-0002-1340-6371"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry and Biobehavioral Sciences, David Geffen School of Medicine, University of California, Los Angeles, Los Angeles, CA, United States."},{"affiliation":"Department of Health Policy and Management, Fielding School of Public Health, University of California, Los Angeles, Los Angeles, CA, United States."}]}},{"fullName":"Swendeman D","firstName":"Dallas","lastName":"Swendeman","initials":"D","authorId":{"type":"ORCID","value":"0000-0002-4570-6352"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry and Biobehavioral Sciences, David Geffen School of Medicine, University of California, Los Angeles, Los Angeles, CA, United States."},{"affiliation":"Department of Epidemiology, Fielding School of Public Health, University of California, Los Angeles, Los Angeles, CA, United States."}]}},{"fullName":"Ho YX","firstName":"Y Xian","lastName":"Ho","initials":"YX","authorId":{"type":"ORCID","value":"0000-0002-1885-6136"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Dimagi, Inc, Cambridge, MA, United States."}]}},{"fullName":"Streck JM","firstName":"Joanna M","lastName":"Streck","initials":"JM","authorId":{"type":"ORCID","value":"0000-0002-7842-9080"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Addiction Medicine, Department of Psychiatry, Massachusetts General Hospital/Harvard Medical School, Boston, MA, United States."},{"affiliation":"Tobacco Research and Treatment Center, Division of General Internal Medicine, Massachusetts General Hospital/Harvard Medical School, Boston, MA, United States."}]}},{"fullName":"Lewis DM","firstName":"Delta-Marie","lastName":"Lewis","initials":"DM","authorId":{"type":"ORCID","value":"0000-0002-5707-1796"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Dimagi, Inc, Cambridge, MA, United States."}]}},{"fullName":"Rezai R","firstName":"Roxana","lastName":"Rezai","initials":"R","authorId":{"type":"ORCID","value":"0000-0002-5614-9483"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Epidemiology, Fielding School of Public Health, University of California, Los Angeles, Los Angeles, CA, United States."}]}},{"fullName":"Warren D","firstName":"David","lastName":"Warren","initials":"D","authorId":{"type":"ORCID","value":"0009-0007-1536-0489"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Dimagi, Inc, Cambridge, MA, United States."}]}},{"fullName":"Pachas G","firstName":"Gladys","lastName":"Pachas","initials":"G","authorId":{"type":"ORCID","value":"0000-0003-2983-2954"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Addiction Medicine, Department of Psychiatry, Massachusetts General Hospital/Harvard Medical School, Boston, MA, United States."}]}},{"fullName":"Chandler M","firstName":"Maria","lastName":"Chandler","initials":"M","authorId":{"type":"ORCID","value":"0009-0009-0409-2428"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"TCC Family Health aka The Children's Clinic, Long Beach, CA, United States."}]}},{"fullName":"Jackson JL","firstName":"Jonathan L","lastName":"Jackson","initials":"JL","authorId":{"type":"ORCID","value":"0000-0002-7746-2129"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Dimagi, Inc, Cambridge, MA, United States."}]}},{"fullName":"Gelberg L","firstName":"Lillian","lastName":"Gelberg","initials":"L","authorId":{"type":"ORCID","value":"0000-0001-9772-0116"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Health Policy and Management, Fielding School of Public Health, University of California, Los Angeles, Los Angeles, CA, United States."},{"affiliation":"Department of Family Medicine, David Geffen School of Medicine, University of California, Los Angeles, Los Angeles, CA, United States."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-9772-0116"},{"type":"ORCID","value":"0000-0002-1340-6371"},{"type":"ORCID","value":"0000-0002-1885-6136"},{"type":"ORCID","value":"0000-0002-4570-6352"},{"type":"ORCID","value":"0000-0002-5614-9483"},{"type":"ORCID","value":"0000-0002-5707-1796"},{"type":"ORCID","value":"0000-0002-7746-2129"},{"type":"ORCID","value":"0000-0002-7842-9080"},{"type":"ORCID","value":"0000-0003-2983-2954"},{"type":"ORCID","value":"0009-0007-1536-0489"},{"type":"ORCID","value":"0009-0009-0409-2428"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"10","journalIssueId":4187512,"dateOfPublication":"2026 May","monthOfPublication":5,"yearOfPublication":2026,"printPublicationDate":"2026-05-01","journal":{"title":"JMIR formative research","medlineAbbreviation":"JMIR Form Res","isoabbreviation":"JMIR Form Res","nlmid":"101726394","essn":"2561-326X","issn":"2561-326X"}},"pubYear":"2026","pageInfo":"e84683","abstractText":"<h4>Background</h4>Substance use disorder (SUD) remains a major public health crisis in the United States, with significant challenges in treatment access, retention, and workforce capacity. SUD care teams, including addiction medicine physicians and peer recovery coaches (PRCs), support patients receiving SUD treatment but face heavy workloads and burnout. Artificial intelligence (AI) innovations, particularly large language model (LLM)-based chatbots, may extend PRC support and provide patients with on-demand recovery support between clinic visits and PRC contacts. However, evidence on their development, feasibility, acceptability, and usability in addiction services remains limited.<h4>Objective</h4>This study describes the development, feasibility, acceptability, and usability of an AI-powered health coaching chatbot (Suzy) designed to support patients in SUD recovery.<h4>Methods</h4>A total of 2 clinicians, 5 researchers, and 2 technology developers led a small, multiphase pilot study. In the formative phase, they conducted focus groups and qualitative in-depth interviews with 12 health care professionals and 8 patients with substance use histories to specify chatbot functions and develop a rule-based chatbot. In phase 2, they conducted usability testing of the rule-based chatbot with 8 patients who reported substance use and completed standardized tasks, surveys, and qualitative interviews. Measures included the System Usability Scale (SUS), Net Promoter Score (NPS), and Single Ease of Use Question (SEQ). In phase 3, they developed an LLM-based chatbot co-designed and fine-tuned with PRCs and other SUD experts.<h4>Results</h4>Rule-based chatbot functions included craving management, appointment reminders, resource referrals, care team contacts, and goal setting. Usability task testing supported feasibility. In this small pilot sample, quantitative and qualitative feedback indicated acceptability and usability, with an average SUS score of 93 (benchmark 68), an NPS of 63 (benchmark 35), and a mean SEQ score of 6.5/7. Patients valued Suzy's approachable, nonjudgmental language and features that promoted accountability, self-monitoring, and 24/7 availability, while emphasizing that chatbots should supplement but not replace human support. The LLM-based chatbot development emphasized information accuracy, safety escalation protocols to mitigate risks of inappropriate chatbot responses, human-in-the-loop features, and expanded conversational flexibility and personal tailoring.<h4>Conclusions</h4>In this pilot study, a rule-based chatbot designed to support SUD care demonstrated feasibility, usability, and acceptability. LLM-based chatbot development required more robust safety and emergency reporting features, while offering more patient-responsive conversational functions. By providing on-demand coaching, referrals, and reminders, Suzy may extend the reach of care teams, alleviate provider burden, and enhance patient engagement. Additional work is needed to understand how to best integrate Suzy into patients' recovery journeys to ensure human support remains accessible and prioritized. LLM evaluation was based on expert testing and safety review. Clinical effectiveness, including the impact on substance use, was not evaluated. Next steps include evaluating the LLM chatbot in real-world settings with larger samples and assessing its efficacy in reducing substance use.","affiliation":"Department of Psychiatry and Biobehavioral Sciences, David Geffen School of Medicine, University of California, Los Angeles, Los Angeles, CA, United States.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"grantsList":{"grant":[{"grantId":"R43 DA050218","agency":"NIDA NIH HHS","acronym":"DA","orderIn":0},{"grantId":"R44 DA050218","agency":"NIDA NIH HHS","acronym":"DA","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Substance-Related Disorders","meshQualifierList":{"meshQualifier":[{"abbreviation":"PX","qualifierName":"psychology","majorTopic_YN":"N"},{"abbreviation":"RH","qualifierName":"rehabilitation","majorTopic_YN":"N"},{"abbreviation":"TH","qualifierName":"therapy","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Focus Groups","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Feasibility Studies"},{"majorTopic_YN":"N","descriptorName":"Pilot Projects"},{"majorTopic_YN":"N","descriptorName":"Qualitative Research"},{"majorTopic_YN":"Y","descriptorName":"Artificial Intelligence","meshQualifierList":{"meshQualifier":[{"abbreviation":"ST","qualifierName":"standards","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Adult"},{"majorTopic_YN":"N","descriptorName":"Middle Aged"},{"majorTopic_YN":"N","descriptorName":"Female"},{"majorTopic_YN":"N","descriptorName":"Male"},{"majorTopic_YN":"N","descriptorName":"Large Language Models"}]},"keywordList":{"keyword":["Artificial intelligence","GPT","Substance Use Disorder","Human-centered Design","Health Coach","Chatbot","Iterative Development","Peer Recovery Coach","Large Language Model"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/84683"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13234539"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13234539?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-07-17","dateOfCreation":"2026-05-20","firstIndexDate":"2026-05-21","fullTextReceivedDate":"2026-06-07","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-05-20","firstPublicationDate":"2026-05-20"},{"id":"41592221","source":"MED","pmid":"41592221","pmcid":"PMC13032092","fullTextIdList":{"fullTextId":["PMC13032092"]},"doi":"10.2196/80348","title":"Large Language Model-Based Chatbots and Agentic AI for Mental Health Counseling: Systematic Review of Methodologies, Evaluation Frameworks, and Ethical Safeguards.","authorString":"Cho HN, Wang J, Hu D, Zheng K.","authorList":{"author":[{"fullName":"Cho HN","firstName":"Ha Na","lastName":"Cho","initials":"HN","authorId":{"type":"ORCID","value":"0000-0001-8033-6644"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Informatics, University of California, Irvine, Irvine, CA, United States."}]}},{"fullName":"Wang J","firstName":"Jiayuan","lastName":"Wang","initials":"J","authorId":{"type":"ORCID","value":"0009-0000-2144-4610"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Informatics, University of California, Irvine, Irvine, CA, United States."}]}},{"fullName":"Hu D","firstName":"Di","lastName":"Hu","initials":"D","authorId":{"type":"ORCID","value":"0000-0002-2842-1478"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Informatics, University of California, Irvine, Irvine, CA, United States."}]}},{"fullName":"Zheng K","firstName":"Kai","lastName":"Zheng","initials":"K","authorId":{"type":"ORCID","value":"0000-0003-4121-4948"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Informatics, University of California, Irvine, Irvine, CA, United States."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-8033-6644"},{"type":"ORCID","value":"0000-0002-2842-1478"},{"type":"ORCID","value":"0000-0003-4121-4948"},{"type":"ORCID","value":"0009-0000-2144-4610"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"volume":"5","journalIssueId":4146411,"dateOfPublication":"2026 Mar","monthOfPublication":3,"yearOfPublication":2026,"printPublicationDate":"2026-03-01","journal":{"title":"JMIR AI","medlineAbbreviation":"JMIR AI","isoabbreviation":"JMIR AI","nlmid":"9918645789006676","essn":"2817-1705","issn":"2817-1705"}},"pubYear":"2026","pageInfo":"e80348","abstractText":"<h4>Background</h4>Large language model (LLM)-based chatbots have rapidly emerged as tools for digital mental health (MH) counseling. However, evidence on their methodological quality, evaluation rigor, and ethical safeguards remains fragmented, limiting interpretation of clinical readiness and deployment safety.<h4>Objective</h4>This systematic review aimed to synthesize the methodologies, evaluation practices, and ethical or governance frameworks of LLM-based chatbots developed for MH counseling and to identify gaps affecting validity, reproducibility, and translation.<h4>Methods</h4>We searched Google Scholar, PubMed, IEEE Xplore, and ACM Digital Library for studies published between January 2020 and May 2025. Eligible studies reported original development or empirical evaluation of LLM-driven MH counseling chatbots. We excluded studies that did not involve LLM-based conversational agents, were not focused on counseling or supportive MH communication, or lacked evaluable system outputs or outcomes. Screening and data extraction were conducted in Covidence (Veritas Health Innovation) following PRISMA (Preferred Reporting Items for Systematic Reviews and Meta-Analyses) 2020 guidelines. Study quality was appraised using a structured traffic light framework across 5 methodological domains (design, dataset reporting, evaluation metrics, external validation, and ethics), with an overall judgment derived across domains. We used narrative synthesis with descriptive aggregation to summarize methodological trends, evaluation metrics, and governance considerations.<h4>Results</h4>Twenty studies met the inclusion criteria. GPT-based models (GPT-2/3/4) were used in 45% (9/20) of studies, while 90% (18/20) used fine-tuned or domain-adaptation models such as LLaMa, ChatGLM, or Qwen. Reported deployment types were not mutually exclusive; standalone apps were most common (18/20, 90%), and some systems were also implemented as virtual agents (4/20, 20%) or delivered via existing platforms (2/20, 10%). Evaluation approaches were frequently mixed, with qualitative assessment (13/20, 65%), such as thematic analysis or rubric-based scoring, often complemented by quantitative language metrics (18/20, 90%), including BLEU (Bilingual Evaluation Understudy), ROUGE (Recall-Oriented Understudy for Gisting Evaluation), or perplexity. Quality appraisal indicated consistently low risk for dataset reporting and evaluation metrics, but recurring limitations were observed in external validation and reporting on ethics and safety, including incomplete documentation of safety safeguards and governance practices. No included study reported registered randomized controlled trials or independent clinical validation in real-world care settings.<h4>Conclusions</h4>LLM-based MH counseling chatbots show promise for scalable and personalized support, but current evidence is limited by heterogeneous study designs, minimal external validation, and inconsistent reporting of safety and governance practices. Future work should prioritize clinically grounded evaluation frameworks, transparent reporting of model and prompt configurations, and stronger validation using standardized outcomes to support safe, reliable, and regulatory-ready deployment.","affiliation":"Department of Informatics, University of California, Irvine, Irvine, CA, United States.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"keywordList":{"keyword":["Personalized Health Care","Digital Health","Conversational Agent","Digital Mental Health Intervention","Large Language Model Chatbots"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/80348"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13032092"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13032092?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-03-13","dateOfCreation":"2026-01-27","firstIndexDate":"2026-01-27","fullTextReceivedDate":"2026-03-29","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-03-13","firstPublicationDate":"2026-03-13"},{"id":"41901113","source":"MED","pmid":"41901113","pmcid":"PMC13029413","fullTextIdList":{"fullTextId":["PMC13029413"]},"doi":"10.3390/nu18060938","title":"Generative AI in Precision Nutrition: A Review of Current Developments and Future Directions.","authorString":"Abdur Rahman L, Dedousis V, Papathanail I, Poursoleymani R, Kafyra M, Kalafati IP, Mougiakakou SG.","authorList":{"author":[{"fullName":"Abdur Rahman L","firstName":"Lubnaa","lastName":"Abdur Rahman","initials":"L","authorId":{"type":"ORCID","value":"0000-0001-7271-2814"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Graduate School for Cellular and Biomedical Sciences, University of Bern, 3012 Bern, Switzerland."},{"affiliation":"ARTORG Center for Biomedical Engineering Research, University of Bern, 3008 Bern, Switzerland."}]}},{"fullName":"Dedousis V","firstName":"Vasileios","lastName":"Dedousis","initials":"V","authorId":{"type":"ORCID","value":"0009-0001-1439-9564"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Graduate School for Cellular and Biomedical Sciences, University of Bern, 3012 Bern, Switzerland."},{"affiliation":"ARTORG Center for Biomedical Engineering Research, University of Bern, 3008 Bern, Switzerland."}]}},{"fullName":"Papathanail I","firstName":"Ioannis","lastName":"Papathanail","initials":"I","authorId":{"type":"ORCID","value":"0000-0002-7767-3831"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"ARTORG Center for Biomedical Engineering Research, University of Bern, 3008 Bern, Switzerland."}]}},{"fullName":"Poursoleymani R","firstName":"Rooholla","lastName":"Poursoleymani","initials":"R","authorId":{"type":"ORCID","value":"0009-0002-4365-6782"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Graduate School for Cellular and Biomedical Sciences, University of Bern, 3012 Bern, Switzerland."},{"affiliation":"ARTORG Center for Biomedical Engineering Research, University of Bern, 3008 Bern, Switzerland."}]}},{"fullName":"Kafyra M","firstName":"Maria","lastName":"Kafyra","initials":"M","authorId":{"type":"ORCID","value":"0009-0005-9665-0829"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Nutrition and Dietetics, School of Health Science and Education, Harokopio University of Athens, 17676 Athens, Greece."}]}},{"fullName":"Kalafati IP","firstName":"Ioanna Panagiota","lastName":"Kalafati","initials":"IP","authorId":{"type":"ORCID","value":"0000-0001-5572-7491"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Nutrition and Dietetics, School of Health Science and Education, Harokopio University of Athens, 17676 Athens, Greece."}]}},{"fullName":"Mougiakakou SG","firstName":"Stavroula Georgia","lastName":"Mougiakakou","initials":"SG","authorId":{"type":"ORCID","value":"0000-0002-6355-9982"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"ARTORG Center for Biomedical Engineering Research, University of Bern, 3008 Bern, Switzerland."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5572-7491"},{"type":"ORCID","value":"0000-0001-7271-2814"},{"type":"ORCID","value":"0000-0002-6355-9982"},{"type":"ORCID","value":"0000-0002-7767-3831"},{"type":"ORCID","value":"0009-0001-1439-9564"},{"type":"ORCID","value":"0009-0002-4365-6782"},{"type":"ORCID","value":"0009-0005-9665-0829"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"6","volume":"18","journalIssueId":4161783,"dateOfPublication":"2026 Mar","monthOfPublication":3,"yearOfPublication":2026,"printPublicationDate":"2026-03-01","journal":{"title":"Nutrients","medlineAbbreviation":"Nutrients","isoabbreviation":"Nutrients","nlmid":"101521595","essn":"2072-6643","issn":"2072-6643"}},"pubYear":"2026","pageInfo":"938","abstractText":"<b>Background:</b> Precision nutrition (PN) aims to personalize dietary guidance by accounting for inter-individual variability across biological, metabolic, lifestyle, and environmental factors influencing nutritional needs and health outcomes. While traditional Artificial Intelligence (AI) has advanced nutritional research through systems like automated dietary assessment, these models often operate rigidly. Generative AI (GenAI) introduces the capacity for adaptive interventions for enhanced PN. However, the scope and maturity of its applications remain insufficiently characterized. <b>Objective:</b> This review examined original works applying GenAI in PN, focusing on application, methodology, and limitations. <b>Methods:</b> A systematic search was conducted in PubMed, ACM Digital Library, and Scopus. Inclusion criteria focused on original works deploying GenAI models in PN contexts. Included works were further formally assessed based on data used, validation, transparency, bias, and security and privacy. <b>Results:</b> 21 eligible studies were identified, all published after 2024. The literature indicated a surge in large language model-based systems for personalized dietary recommendations, followed by applications in data foundation building and food effect understanding. A recurrent limitation was questionable evaluation on synthetic data and hallucinations, necessitating a human-expert-in-the-loop, especially in high-stakes clinical settings. Additionally, only 4 of 21 reviewed studies incorporated biological content or biological inputs, and fewer approached biologically grounded PN within implemented personalization workflows using metabolic and/or genomic variables. <b>Conclusions:</b> Although GenAI research in PN is expanding rapidly, most applications remain personalized at a user-preference level rather than including biological determinants. The need for standardized reporting, stronger genome-informed modeling, and consistent human-in-the-loop validation protocols is further highlighted to advance towards holistic PN.","affiliation":"Graduate School for Cellular and Biomedical Sciences, University of Bern, 3012 Bern, Switzerland.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["Systematic Review","review-article","Journal Article"]},"grantsList":{"grant":[{"grantId":"101080117","agency":"European Commission and the Swiss Confederation–State Secretariat for Education, Research and Innovation","orderIn":0},{"grantId":"101080117","agency":"European Commission and State Secretariat for Education, Research and Innovation (SERI)","orderIn":0},{"grantId":"10093560","agency":"UK Research and Innovation (UKRI) under the UK government’s Horizon Europe funding guarantee","orderIn":0},{"grantId":"101057730","agency":"European Commission and State Secretariat for Education, Research and Innovation (SERI)","orderIn":0},{"grantId":"101057730","agency":"European Commission and the Swiss Confederation–State Secretariat for Education, Research and Innovation","orderIn":0},{"grantId":"10106435","agency":"UK Research and Innovation (UKRI) under the UK government’s Horizon Europe funding guarantee","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Precision Medicine","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"},{"abbreviation":"TD","qualifierName":"trends","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Generative Artificial Intelligence"},{"majorTopic_YN":"N","descriptorName":"Large Language Models"}]},"keywordList":{"keyword":["Personalized Nutrition","Precision Nutrition","Generative Artificial Intelligence"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3390/nu18060938"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13029413"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13029413?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":3,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-07-13","dateOfCreation":"2026-03-28","firstIndexDate":"2026-03-29","fullTextReceivedDate":"2026-03-28","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-03-17","firstPublicationDate":"2026-03-17"},{"id":"42130876","source":"MED","pmid":"42130876","pmcid":"PMC13160892","fullTextIdList":{"fullTextId":["PMC13160892"]},"doi":"10.3389/fpubh.2026.1792627","title":"Ethical issues in multi-agent AI systems for healthcare: a narrative review.","authorString":"Xie Z, Wang H, Dai L, Wang Z, Song H, Qian J.","authorList":{"author":[{"fullName":"Xie Z","firstName":"Zhibin","lastName":"Xie","initials":"Z","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"KoGuan School of Law, Shanghai Jiao Tong University, Shanghai, China."}]}},{"fullName":"Wang H","firstName":"Hongyu","lastName":"Wang","initials":"H","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"The Chinese University of Hong Kong, Hong Kong, Hong Kong SAR, China."}]}},{"fullName":"Dai L","firstName":"Lexuan","lastName":"Dai","initials":"L","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"University of Southern California, Los Angeles, CA, United States."}]}},{"fullName":"Wang Z","firstName":"Zikai","lastName":"Wang","initials":"Z","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Shanghai Artificial Intelligence Research Institute, Shanghai, China."}]}},{"fullName":"Song H","firstName":"Haitao","lastName":"Song","initials":"H","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Shanghai Artificial Intelligence Research Institute, Shanghai, China."}]}},{"fullName":"Qian J","firstName":"Jingzhe","lastName":"Qian","initials":"J","authorId":{"type":"ORCID","value":"0009-0003-8490-9413"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Shanghai Artificial Intelligence Research Institute, Shanghai, China."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0009-0003-8490-9413"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"volume":"14","journalIssueId":4110762,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Frontiers in public health","medlineAbbreviation":"Front Public Health","isoabbreviation":"Front Public Health","nlmid":"101616579","essn":"2296-2565","issn":"2296-2565"}},"pubYear":"2026","pageInfo":"1792627","abstractText":"<h4>Introduction</h4>Multi-agent AI systems are believed to bring significant improvements in digital health, but it also brings new and more serious ethical issues. Such systems distribute the decision-making process among multiple interacting agents, and this decentralized decision-making system has raised ethical concerns in the medical field. On the one hand, it continues the ethical issues of traditional AI tools; on the other hand, the interaction processes within complex systems have also brought about new dilemmas. This narrative review aims to synthesize the ethical issues related to multi-agent AI systems in healthcare presented and explore the corresponding mitigation strategies.<h4>Methods</h4>The study outcomes were synthesized using a narrative approach. Relevant records were gathered through Boolean searches in databases such as PubMed, Scopus, and Web of Science. A total of 21 articles related to multi-agent AI, healthcare, and ethical issues are included in this review.<h4>Results</h4>Seven key ethical challenges were identified: (1) compound opacity, where interacting AI agents create layers of inscrutable decision-making; (2) error propagation and attribution difficulties, complicating accountability for clinical harm; (3) increased clinician dependence and automation bias, leading to potential deskilling and overreliance; (4) erosion of human oversight, as multi-agent AI systems operate beyond effective human control; (5) privacy and data security risks, stemming from complex data flows among agents; (6) threats to patient autonomy and informed consent, due to opaque or paternalistic AI recommendations; and (7) contextual blindness, reflecting a loss of individualized patient understanding in modular AI workflows. Furthermore, this review also summarized solutions proposed in the existing literature for these ethical issues.<h4>Conclusions</h4>Multi-agent AI systems intensify existing ethical concerns in healthcare by distributing decision-making and blurring responsibility. To mitigate these issues, recent research advocates for the development of adaptive governance models, clear accountability frameworks, human-AI collaboration structures that preserve clinician authority, enhanced systems for explainability, and privacy-centered designs. In order to successfully incorporate agentic AI into healthcare, it is essential to maintain transparency, protect patient rights, and ensure that human-centered values continue to guide clinical decision-making in an era dominated by autonomous, interacting AI systems.","affiliation":"KoGuan School of Law, Shanghai Jiao Tong University, Shanghai, China.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Artificial Intelligence","meshQualifierList":{"meshQualifier":[{"abbreviation":"ES","qualifierName":"ethics","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Delivery of Health Care","meshQualifierList":{"meshQualifier":[{"abbreviation":"ES","qualifierName":"ethics","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Digital Health","meshQualifierList":{"meshQualifier":[{"abbreviation":"ES","qualifierName":"ethics","majorTopic_YN":"N"}]}}]},"keywordList":{"keyword":["Healthcare Ethics","Digital Health","Autonomous Decision-Making","Agentic Ai Systems","Responsibility And Accountability"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/fpubh.2026.1792627"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13160892"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13160892?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":2,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-07-16","dateOfCreation":"2026-05-14","firstIndexDate":"2026-05-15","fullTextReceivedDate":"2026-05-20","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-04-28","firstPublicationDate":"2026-04-28"},{"id":"42381988","source":"MED","pmid":"42381988","pmcid":"PMC13314595","fullTextIdList":{"fullTextId":["PMC13314595"]},"doi":"10.3389/fpsyt.2026.1883962","title":"Generative AI as interactional infrastructure for meaning-centered care in later life.","authorString":"Chen B, Jin AY.","authorList":{"author":[{"fullName":"Chen B","firstName":"Bing","lastName":"Chen","initials":"B","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Third Affiliated Hospital of Wenzhou Medical University, Wenzhou, China."}]}},{"fullName":"Jin AY","firstName":"An-Yue","lastName":"Jin","initials":"AY","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Wenzhou Central Hospital, Wenzhou, China."}]}}]},"journalInfo":{"volume":"17","journalIssueId":4112086,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Frontiers in psychiatry","medlineAbbreviation":"Front Psychiatry","isoabbreviation":"Front Psychiatry","nlmid":"101545006","essn":"1664-0640","issn":"1664-0640"}},"pubYear":"2026","pageInfo":"1883962","abstractText":"Generative artificial intelligence (GenAI) and large language models are rapidly entering mental health research and service delivery, yet their dominant use remains symptom-centric, emphasizing screening, classification, triage, and risk detection. For older adults, mental health is often inseparable from existential concerns: loss of social role, disrupted continuity of self, loneliness, diminished dignity, and questions of legacy. This perspective argues that GenAI should not be conceptualized as an autonomous substitute for clinicians, nurses, social workers, or family caregivers. Instead, it may be better understood as an interactional infrastructure for meaning-centered care in later life. Drawing on meaning-centered psychotherapy, dignity therapy, life review, gerotranscendence theory, care ethics, and implementation science, we propose a Sensing-Narrating-Connecting-Governing framework. In this model, multimodal AI systems help detect existential and relational cues, support life-review conversations, co-construct dignity-preserving narratives, connect older adults with human care networks, and operate under explicit safeguards for privacy, hallucination, dependency, crisis escalation, and cultural adaptation. The proposed framework shifts evaluation from model performance alone toward existential well-being, dignity, continuity of self, therapeutic alliance, equity, and workflow integration. We conclude that GenAI may contribute to public mental health only when deployed as a bounded, human-supervised, culturally responsive layer of relational augmentation rather than as a replacement for human presence.","affiliation":"Third Affiliated Hospital of Wenzhou Medical University, Wenzhou, China.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["brief-report","Journal Article"]},"keywordList":{"keyword":["Older Adults","Life Review","Dignity Therapy","Public Mental Health","Digital Mental Health","Generative Artificial Intelligence","Large Language Models","Meaning-centered Care"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/fpsyt.2026.1883962"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13314595"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13314595?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-07-01","dateOfCreation":"2026-07-01","firstIndexDate":"2026-07-02","fullTextReceivedDate":"2026-08-19","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-16","firstPublicationDate":"2026-06-16"},{"id":"42231767","source":"MED","pmid":"42231767","pmcid":"PMC13229467","fullTextIdList":{"fullTextId":["PMC13229467"]},"doi":"10.2196/96556","title":"Mapping Practice-Based Signals of Generative AI in Psychiatric Care: Qualitative Study of Korean Psychiatrists' Experiences, Interpretations, and Implementation Priorities.","authorString":"Kim M, An Y, Jeon M, Lee Y, Lahcine OF, Kim H, Lee S, Lee S, Yang JC, Jeon SW, Jung D, Cho CH.","authorList":{"author":[{"fullName":"Kim M","firstName":"Myungsung","lastName":"Kim","initials":"M","authorId":{"type":"ORCID","value":"0000-0003-4316-5182"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Graduate School of Health Science and Technology, Ulsan National Institute of Science and Technology, Ulsan, Republic of Korea."}]}},{"fullName":"An Y","firstName":"Yoosuk","lastName":"An","initials":"Y","authorId":{"type":"ORCID","value":"0000-0003-4548-0653"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry, National Traffic injury Rehabilitation Hospital, Yangpyeong, Gyeonggi-do, Republic of Korea."},{"affiliation":"Department of Neuropsychiatry, Seoul National University Hospital, Seoul, Republic of Korea."},{"affiliation":"Department of Psychiatry, College of Medicine, Seoul National University, Seoul, Republic of Korea."}]}},{"fullName":"Jeon M","firstName":"Min","lastName":"Jeon","initials":"M","authorId":{"type":"ORCID","value":"0009-0006-4478-0303"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Graduate School of Health Science and Technology, Ulsan National Institute of Science and Technology, Ulsan, Republic of Korea."}]}},{"fullName":"Lee Y","firstName":"Yunji","lastName":"Lee","initials":"Y","authorId":{"type":"ORCID","value":"0009-0004-6055-2787"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Graduate School of Health Science and Technology, Ulsan National Institute of Science and Technology, Ulsan, Republic of Korea."}]}},{"fullName":"Lahcine OF","firstName":"Orane Farrah","lastName":"Lahcine","initials":"OF","authorId":{"type":"ORCID","value":"0009-0006-7967-1174"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Graduate School of Health Science and Technology, Ulsan National Institute of Science and Technology, Ulsan, Republic of Korea."}]}},{"fullName":"Kim H","firstName":"Hyorim","lastName":"Kim","initials":"H","authorId":{"type":"ORCID","value":"0009-0007-8198-3123"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Graduate School of Health Science and Technology, Ulsan National Institute of Science and Technology, Ulsan, Republic of Korea."}]}},{"fullName":"Lee S","firstName":"Seonmi","lastName":"Lee","initials":"S","authorId":{"type":"ORCID","value":"0000-0002-9642-1605"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Digital Humanities and Computational Social Sciences, Korea Advanced Institute of Science and Technology, N4 Bldg, Room 1314, 291 Daehak-ro, Yuseong-gu, Daejeon, 34141, Republic of Korea, 82 010-9797-0807."}]}},{"fullName":"Lee S","firstName":"Sangil","lastName":"Lee","initials":"S","authorId":{"type":"ORCID","value":"0000-0001-9025-6250"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Liberal Arts, Ulsan National Institute of Science and Technology, Ulsan, Republic of Korea."}]}},{"fullName":"Yang JC","firstName":"Jong-Chul","lastName":"Yang","initials":"JC","authorId":{"type":"ORCID","value":"0000-0002-7701-2718"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Jeonbuk National University Hospital, Jeollabuk-do, Republic of Korea."}]}},{"fullName":"Jeon SW","firstName":"Sang-Won","lastName":"Jeon","initials":"SW","authorId":{"type":"ORCID","value":"0009-0007-3316-8781"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry, Sungkyunkwan University School of Medicine, Kangbuk Samsung Hospital, Seoul, Republic of Korea."}]}},{"fullName":"Jung D","firstName":"Dooyoung","lastName":"Jung","initials":"D","authorId":{"type":"ORCID","value":"0000-0002-5381-4847"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Digital Humanities and Computational Social Sciences, Korea Advanced Institute of Science and Technology, N4 Bldg, Room 1314, 291 Daehak-ro, Yuseong-gu, Daejeon, 34141, Republic of Korea, 82 010-9797-0807."},{"affiliation":"Mind Care and Growth Center, Korea Advanced Institute of Science and Technology, Daejeon, Republic of Korea."}]}},{"fullName":"Cho CH","firstName":"Chul-Hyun","lastName":"Cho","initials":"CH","authorId":{"type":"ORCID","value":"0000-0002-1663-9680"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry, College of Medicine, Korea University, Seoul, Republic of Korea."},{"affiliation":"Department of Biomedical Informatics, College of Medicine, Korea University, Seoul, Republic of Korea."},{"affiliation":"Department of Medical Education, College of Medicine, Korea University, Seoul, Republic of Korea."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-9025-6250"},{"type":"ORCID","value":"0000-0002-1663-9680"},{"type":"ORCID","value":"0000-0002-5381-4847"},{"type":"ORCID","value":"0000-0002-7701-2718"},{"type":"ORCID","value":"0000-0002-9642-1605"},{"type":"ORCID","value":"0000-0003-4316-5182"},{"type":"ORCID","value":"0000-0003-4548-0653"},{"type":"ORCID","value":"0009-0004-6055-2787"},{"type":"ORCID","value":"0009-0006-4478-0303"},{"type":"ORCID","value":"0009-0006-7967-1174"},{"type":"ORCID","value":"0009-0007-3316-8781"},{"type":"ORCID","value":"0009-0007-8198-3123"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"volume":"28","journalIssueId":4204496,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"printPublicationDate":"2026-06-01","journal":{"title":"Journal of medical Internet research","medlineAbbreviation":"J Med Internet Res","isoabbreviation":"J Med Internet Res","nlmid":"100959882","essn":"1438-8871","issn":"1439-4456"}},"pubYear":"2026","pageInfo":"e96556","abstractText":"<h4>Background</h4>Generative artificial intelligence (GenAI) has increasingly entered psychiatric practice through patient-facing chatbots, self-help tools, and clinician-facing workflow support. Although prior research has examined clinicians' attitudes, readiness, and anticipated use cases, less is known about how frontline encounters with GenAI shape psychiatrists' interpretations and implementation priorities. Health care foresight also remains methodologically underdeveloped and has focused mainly on external signals, overlooking clinically consequential signals emerging from everyday practice. This gap is especially important in psychiatry, where GenAI-related benefits and harms may depend on patient vulnerability, crisis sensitivity, and the therapeutic relationship.<h4>Objective</h4>This study aims to qualitatively examine how South Korean psychiatrists described clinical experiences with GenAI, how they interpreted its roles and limits in psychiatric care, and what implementation priorities they emphasized. Selected concepts from horizon scanning informed the organization of the analysis by orienting attention to practice-based signals, interpretive patterns, and implementation priorities.<h4>Methods</h4>In this qualitative descriptive study, directed content analysis and codebook-based thematic synthesis were used to analyze responses to 3 open-ended survey questions administered to members of the Korean Neuropsychiatric Association. Invitations were distributed through the association's official email system from October 27 to December 26, 2025. The qualitative analysis included respondents who provided an interpretable response to at least 1 item. The questions addressed (1) GenAI-related clinical experiences, (2) perceived advantages and limitations of GenAI relative to human therapists, and (3) priorities for the safe introduction of GenAI into mental health care. An exploratory participant-level cross-question thematic alignment analysis was also conducted to examine recurring adjacent-item pairings across the experience-interpretation-priority sequence.<h4>Results</h4>Of 408 total survey respondents, 311 respondents provided a meaningful response to at least 1 open-ended item. Psychiatrists described GenAI as a clinically ambivalent technology whose implications depended on context, intensity of use, and patient vulnerability. Practice-based signals clustered around patient-led use, clinician-led use, GenAI as a relational object, and GenAI-mediated changes in the patient-clinician interface, with high-risk and destabilizing scenarios cutting across these themes. Respondents viewed GenAI as potentially useful as an adjunct, but also as relationally limited and unacceptable as a replacement for human therapists. Implementation priorities centered on governance, crisis and vulnerability safeguards, technical reliability and clinical validation, and education, supervision, and structural readiness. Cross-question analysis suggested recurrent alignments between frontline signals, a view of GenAI as standardized and tireless but relationally thin, and governance- and validation-oriented implementation priorities.<h4>Conclusions</h4>In this qualitative descriptive study, GenAI emerged in psychiatric practice as an access tool, a workflow aid, and, at times, a competing interpretive reference point in clinical encounters. The key implementation challenge is therefore not whether psychiatry will encounter GenAI, but how its use should be bounded, supervised, and governed in light of patient vulnerability, psychiatric risk, and the relational demands of care.","affiliation":"Graduate School of Health Science and Technology, Ulsan National Institute of Science and Technology, Ulsan, Republic of Korea.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Attitude of Health Personnel"},{"majorTopic_YN":"Y","descriptorName":"Psychiatry","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Qualitative Research"},{"majorTopic_YN":"N","descriptorName":"Adult"},{"majorTopic_YN":"N","descriptorName":"Female"},{"majorTopic_YN":"N","descriptorName":"Male"},{"majorTopic_YN":"N","descriptorName":"Republic of Korea"},{"majorTopic_YN":"Y","descriptorName":"Psychiatrists"},{"majorTopic_YN":"Y","descriptorName":"Generative Artificial Intelligence"}]},"keywordList":{"keyword":["Psychiatrists","Qualitative Research","Thematic Analysis","Horizon Scanning","Generative Artificial Intelligence","Mental Health Artificial Intelligence"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/96556"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13229467"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13229467?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":1,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-06-07","dateOfCreation":"2026-06-03","firstIndexDate":"2026-06-03","fullTextReceivedDate":"2026-06-04","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-02","firstPublicationDate":"2026-06-02"},{"id":"41370787","source":"MED","pmid":"41370787","pmcid":"PMC12694945","fullTextIdList":{"fullTextId":["PMC12694945"]},"doi":"10.2196/79838","title":"Evaluating Generative AI Psychotherapy Chatbots Used by Youth: Cross-Sectional Study.","authorString":"Sobowale K, Humphrey DK, Zhao SY.","authorList":{"author":[{"fullName":"Sobowale K","firstName":"Kunmi","lastName":"Sobowale","initials":"K","authorId":{"type":"ORCID","value":"0000-0002-3489-7114"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry and Biobehavioral Sciences, University of California, 760 Westwood Plaza, Suite 48-241, Los Angeles, CA, 90024, United States, 1 310-794-7035, 1 925-281-3270."}]}},{"fullName":"Humphrey DK","firstName":"Daniel Kevin","lastName":"Humphrey","initials":"DK","authorId":{"type":"ORCID","value":"0009-0005-3530-4279"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychology, College of Arts and Science, University of San Francisco, San Francisco, CA, United States."}]}},{"fullName":"Zhao SY","firstName":"Sophia Yingruo","lastName":"Zhao","initials":"SY","authorId":{"type":"ORCID","value":"0009-0009-4937-7443"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"University of California Los Angeles, Los Angeles, CA, United States."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-3489-7114"},{"type":"ORCID","value":"0009-0005-3530-4279"},{"type":"ORCID","value":"0009-0009-4937-7443"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"volume":"12","journalIssueId":4063741,"dateOfPublication":"2025 Dec","monthOfPublication":12,"yearOfPublication":2025,"printPublicationDate":"2025-12-01","journal":{"title":"JMIR mental health","medlineAbbreviation":"JMIR Ment Health","isoabbreviation":"JMIR Ment Health","nlmid":"101658926","essn":"2368-7959","issn":"2368-7959"}},"pubYear":"2025","pageInfo":"e79838","abstractText":"<h4>Background</h4>Many youth rely on direct-to-consumer generative artificial intelligence (GenAI) chatbots for mental health support, yet the quality of the psychotherapeutic capabilities of these chatbots is understudied.<h4>Objective</h4>This study aimed to comprehensively evaluate and compare the quality of widely used GenAI chatbots with psychotherapeutic capabilities using the Conversational Agent for Psychotherapy Evaluation II (CAPE-II) framework.<h4>Methods</h4>In this cross-sectional study, trained raters used the CAPE-II framework to rate the quality of 5 chatbots from GenAI platforms widely used by youth. Trained raters role-played as youth using personas of youth with mental health challenges to prompt chatbots, facilitating conversations. Chatbot responses were generated from August to October 2024. The primary outcomes were rated scores in 9 sections. The proportion of high-quality ratings (binary rating of 1) across each section was compared between chatbots using Bonferroni-corrected chi-square tests.<h4>Results</h4>While GenAI chatbots were found to be accessible (104/120 high-quality ratings, 86.7%) and avoid harmful statements and misinformation (71/80, 89%), they performed poorly in their therapeutic approach (14/45, 31%) and their ability to monitor and assess risk (31/80, 39%). Privacy policies were difficult to understand, and information on chatbot model training and knowledge was unavailable, resulting in low scores. Bonferroni-corrected chi-square tests showed statistically significant differences in chatbot quality in the background, therapeutic approach, and monitoring and risk evaluation sections. Qualitatively, raters perceived most chatbots as having strong conversational abilities but found them plagued by various issues, including fabricated content and poor handling of crisis situations.<h4>Conclusions</h4>Direct-to-consumer GenAI chatbots are unsafe for the millions of youth who use them. While they demonstrate strengths in accessibility and conversational capabilities, they pose unacceptable risks through improper crisis handling and a lack of transparency regarding privacy and model training. Immediate reforms, including the use of standardized audits of quality, such as the CAPE-II framework, are needed. These findings provide actionable targets for platforms, regulators, and policymakers to protect youth seeking mental health support.","affiliation":"Department of Psychiatry and Biobehavioral Sciences, University of California, 760 Westwood Plaza, Suite 48-241, Los Angeles, CA, 90024, United States, 1 310-794-7035, 1 925-281-3270.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Cross-Sectional Studies"},{"majorTopic_YN":"Y","descriptorName":"Communication"},{"majorTopic_YN":"Y","descriptorName":"Mental Disorders","meshQualifierList":{"meshQualifier":[{"abbreviation":"TH","qualifierName":"therapy","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Psychotherapy","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Artificial Intelligence"},{"majorTopic_YN":"N","descriptorName":"Adolescent"},{"majorTopic_YN":"N","descriptorName":"Female"},{"majorTopic_YN":"N","descriptorName":"Male"},{"majorTopic_YN":"N","descriptorName":"Generative Artificial Intelligence"}]},"keywordList":{"keyword":["Artificial intelligence","psychotherapy","Evaluation Framework","Conversational Agent","Chatbots","Large Language Models","Chatgpt","Digital Health: Therapy","Psychotherapy Chatbots","Generative Ai"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/79838"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12694945"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12694945?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":5,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2025-12-10","dateOfCreation":"2025-12-10","firstIndexDate":"2025-12-11","fullTextReceivedDate":"2025-12-22","dateOfRevision":"2025-12-14","electronicPublicationDate":"2025-12-10","firstPublicationDate":"2025-12-10"},{"id":"41736834","source":"MED","pmid":"41736834","pmcid":"PMC12927464","fullTextIdList":{"fullTextId":["PMC12927464"]},"doi":"10.5334/aogh.5130","title":"Use of Artificial Intelligence in Public Health Education for Pandemic Preparedness and Response.","authorString":"Souza ECSG, Dos Santos Junior AG, Félix AMS, Borges JPA, de Oliveira LB, Carneiro LM, de Sousa AFL.","authorList":{"author":[{"fullName":"Souza ECSG","firstName":"Ellen Crystian Silvestre Garcia","lastName":"Souza","initials":"ECSG","authorId":{"type":"ORCID","value":"0009-0008-0161-3710"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Universidade Federal de Mato Grosso do Sul (UFMS), Três Lagoas Campus, MS, 79600-080, Brazil."}]}},{"fullName":"Dos Santos Junior AG","firstName":"Aires Garcia","lastName":"Dos Santos Junior","initials":"AG","authorId":{"type":"ORCID","value":"0000-0002-5946-0197"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Universidade Federal de Mato Grosso do Sul (UFMS), Três Lagoas Campus, MS, 79600-080, Brazil."}]}},{"fullName":"Félix AMS","firstName":"Adriana M S","lastName":"Félix","initials":"AMS","authorId":{"type":"ORCID","value":"0000-0002-3559-3729"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Nursing, Universidade de São Paulo, São Paulo, SP, 05403-000, Brazil."}]}},{"fullName":"Borges JPA","firstName":"João Paulo Assunção","lastName":"Borges","initials":"JPA","authorId":{"type":"ORCID","value":"0000-0003-4834-9861"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Universidade Federal Mato Grosso do Sul (UFMS), Coxim Campus, MS, 79400-000, Brazil."}]}},{"fullName":"de Oliveira LB","firstName":"Layze Braz","lastName":"de Oliveira","initials":"LB","authorId":{"type":"ORCID","value":"0000-0001-7472-5213"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Universidade Federal de Maran˙hão, São Luís 65080-805 Maranhao, Brazil."}]}},{"fullName":"Carneiro LM","firstName":"Liliane Moretti","lastName":"Carneiro","initials":"LM","authorId":{"type":"ORCID","value":"0000-0003-3195-8767"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Universidade Federal de Mato Grosso do Sul (UFMS), Três Lagoas Campus, MS, 79600-080, Brazil."}]}},{"fullName":"de Sousa AFL","firstName":"Alvaro Francisco Lopes","lastName":"de Sousa","initials":"AFL","authorId":{"type":"ORCID","value":"0000-0003-2710-2122"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Universidade Federal de Mato Grosso do Sul (UFMS), Três Lagoas Campus, MS, 79600-080, Brazil."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-7472-5213"},{"type":"ORCID","value":"0000-0002-3559-3729"},{"type":"ORCID","value":"0000-0002-5946-0197"},{"type":"ORCID","value":"0000-0003-2710-2122"},{"type":"ORCID","value":"0000-0003-3195-8767"},{"type":"ORCID","value":"0000-0003-4834-9861"},{"type":"ORCID","value":"0009-0008-0161-3710"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"1","volume":"92","journalIssueId":4090940,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Annals of global health","medlineAbbreviation":"Ann Glob Health","isoabbreviation":"Ann Glob Health","nlmid":"101620864","essn":"2214-9996","issn":"2214-9996"}},"pubYear":"2026","pageInfo":"21","abstractText":"<i>Background:</i> The rapid evolution of artificial intelligence (AI) has enabled new approaches for health education, particularly during public health emergencies. However, evidence remains fragmented on how AI-based educational strategies support preparedness, response, and recovery phases of pandemics and epidemics. <i>Objective:</i> To map the use of AI-based technologies in health education strategies addressing preparedness, response, and recovery during public health emergencies, identifying target populations, intervention characteristics, outcomes, scalability, and knowledge gaps. <i>Methods:</i> This scoping review followed Joanna Briggs Institute methodology and PRISMA-ScR guidelines. Searches were conducted in PubMed/MEDLINE, Scopus, Web of Science, Embase, IEEE Xplore, and LILACS, complemented by gray literature from Google Scholar. Studies published from 2010 onward in English, Portuguese, or Spanish were included. Eligible designs comprised primary studies, methodological or implementation research, and reviews with explicit educational components. Data extraction covered context, populations, AI modalities, educational purposes, delivery channels, supervision requirements, pandemic-cycle phase, scalability, outcomes, and evidence gaps. <i>Results:</i> Forty-one studies met the inclusion criteria. Conversational AI (chatbots and large language models) and algorithmic curation tools using machine learning and natural language processing predominated. Most interventions supported health literacy, risk communication, and misinformation management; others addressed personalized learning, microtraining, and clinical simulation for students and health professionals. Delivery channels included mobile applications, messaging platforms, websites/YouTube, and clinical AI systems. Human oversight (expert validation and curation) was consistently reported as essential for safety and reliability. Interventions mainly targeted the response phase, with emerging applications for preparedness. Major gaps included standardized learning measures, cost-effectiveness evaluations, equity analyses, and governance frameworks ensuring privacy, transparency, and bias control. <i>Conclusions:</i> AI-enabled educational technologies can strengthen rapid, scalable, and personalized learning during health emergencies. Future research should prioritize multicenter studies using standardized indicators, economic and equity assessments, and robust governance frameworks to ensure ethical, safe, and inclusive adoption.","affiliation":"Universidade Federal de Mato Grosso do Sul (UFMS), Três Lagoas Campus, MS, 79600-080, Brazil.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Public Health","meshQualifierList":{"meshQualifier":[{"abbreviation":"ED","qualifierName":"education","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Health Education","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Artificial Intelligence"},{"majorTopic_YN":"Y","descriptorName":"Pandemics","meshQualifierList":{"meshQualifier":[{"abbreviation":"PC","qualifierName":"prevention & control","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"COVID-19"},{"majorTopic_YN":"Y","descriptorName":"Pandemic Preparedness"}]},"keywordList":{"keyword":["Artificial intelligence","Misinformation","Public Health Education","Pandemics","Machine Learning","Chatbots"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.5334/aogh.5130"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12927464"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12927464?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-07-09","dateOfCreation":"2026-02-25","firstIndexDate":"2026-02-25","fullTextReceivedDate":"2026-02-24","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-02-20","firstPublicationDate":"2026-02-20"},{"id":"42327622","source":"MED","pmid":"42327622","pmcid":"PMC13278831","fullTextIdList":{"fullTextId":["PMC13278831"]},"doi":"10.1093/jamiaopen/ooag106","title":"Large language model chatbot-based text-to-SQL application for database analyses in liver diseases and hepatology research.","authorString":"Far AT, Sun S, Jutras G, Wang MB, Burns S, Owens J, Galvez V, Somsouk M, Lai JC, Lai K, Ge J.","authorList":{"author":[{"fullName":"Far AT","firstName":"Aryana T","lastName":"Far","initials":"AT","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Gastroenterology and Hepatology, Department of Medicine at the University of California, San Francisco, San Francisco, CA, United States."}]}},{"fullName":"Sun S","firstName":"Steve","lastName":"Sun","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"UCSF Health Information Technology at the University of California, San Francisco, San Francisco, CA, United States."}]}},{"fullName":"Jutras G","firstName":"Gabrielle","lastName":"Jutras","initials":"G","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Gastroenterology and Hepatology, Department of Medicine at the University of California, San Francisco, San Francisco, CA, United States."}]}},{"fullName":"Wang MB","firstName":"Melinda B","lastName":"Wang","initials":"MB","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Gastroenterology and Hepatology, Department of Medicine at the University of California, San Francisco, San Francisco, CA, United States."}]}},{"fullName":"Burns S","firstName":"Shohei","lastName":"Burns","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Gastroenterology and Hepatology, Department of Medicine at the University of California, San Francisco, San Francisco, CA, United States."}]}},{"fullName":"Owens J","firstName":"Joseph","lastName":"Owens","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"UCSF Health Information Technology at the University of California, San Francisco, San Francisco, CA, United States."}]}},{"fullName":"Galvez V","firstName":"Victor","lastName":"Galvez","initials":"V","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"UCSF Health Information Technology at the University of California, San Francisco, San Francisco, CA, United States."}]}},{"fullName":"Somsouk M","firstName":"Ma","lastName":"Somsouk","initials":"M","authorId":{"type":"ORCID","value":"0000-0001-6116-3645"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Gastroenterology and Hepatology, Department of Medicine at the University of California, San Francisco, San Francisco, CA, United States."}]}},{"fullName":"Lai JC","firstName":"Jennifer C","lastName":"Lai","initials":"JC","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Gastroenterology and Hepatology, Department of Medicine at the University of California, San Francisco, San Francisco, CA, United States."}]}},{"fullName":"Lai K","firstName":"Ki","lastName":"Lai","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"UCSF Health Information Technology at the University of California, San Francisco, San Francisco, CA, United States."}]}},{"fullName":"Ge J","firstName":"Jin","lastName":"Ge","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Gastroenterology and Hepatology, Department of Medicine at the University of California, San Francisco, San Francisco, CA, United States."},{"affiliation":"Bakar Computational Health Sciences Institute at the University of California, San Francisco, San Francisco, CA, United States."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-6116-3645"}]},"dataLinksTagsList":{"dataLinkstag":["related_data","supporting_data"]},"journalInfo":{"issue":"3","volume":"9","journalIssueId":4191184,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"printPublicationDate":"2026-06-01","journal":{"title":"JAMIA open","medlineAbbreviation":"JAMIA Open","isoabbreviation":"JAMIA Open","nlmid":"101730643","essn":"2574-2531","issn":"2574-2531"}},"pubYear":"2026","pageInfo":"ooag106","abstractText":"<h4>Objective</h4>Large language models (LLMs) may improve analysis of structured clinical data by enabling natural language (NL) queries. We developed an interactive, PHI-compliant \"Text2SQL\" chatbot as a proof-of-concept for hepatocellular carcinoma (HCC) research.<h4>Materials and methods</h4>Using the University of California, San Francisco's secure artificial intelligence platform, we configured the chatbot to translate NL queries into Structured Query Language (SQL), execute them, and return both code and results. Clinicians posed 30 questions, and outputs were compared with SQL written by a data scientist. We assessed prompt interpretation, SQL accuracy, output accuracy, and error types according to strict binary criteria.<h4>Results</h4>Prompt interpretation accuracy was 73.3%, SQL accuracy ranged from 53% to 63%, and output accuracy from 53% to 63%. Frequent errors included group comparisons, ambiguous variables, and exploratory questions.<h4>Discussion</h4>Text2SQL enables PHI-compliant interaction with clinical datasets without coding, though performance varies across query types.<h4>Conclusion</h4>LLM-powered Text2SQL offers a promising approach for clinician-friendly clinical data access.","affiliation":"Division of Gastroenterology and Hepatology, Department of Medicine at the University of California, San Francisco, San Francisco, CA, United States.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["brief-report","Journal Article"]},"grantsList":{"grant":[{"grantId":"P30 DK026743","agency":"NIDDK NIH HHS","acronym":"DK","orderIn":0}]},"keywordList":{"keyword":["Data analysis","Liver diseases","Gastroenterology","Generative Artificial Intelligence","Large Language Models"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1093/jamiaopen/ooag106"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13278831"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13278831?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-06-22","dateOfCreation":"2026-06-22","firstIndexDate":"2026-06-23","fullTextReceivedDate":"2026-06-26","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-19","firstPublicationDate":"2026-06-19"},{"id":"41938607","source":"MED","pmid":"41938607","pmcid":"PMC13044073","fullTextIdList":{"fullTextId":["PMC13044073"]},"doi":"10.3389/fdgth.2026.1777667","title":"Chatbots as frontline educators in sexual reproductive health rights: evidence, limitations, and ethical considerations.","authorString":"Uzoma C, Chukwuedo G, Isaac E, Uzoma V, Eneh SC, Chinyere FP, Precious OM, Onukansi FO.","authorList":{"author":[{"fullName":"Uzoma C","firstName":"Chioma","lastName":"Uzoma","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Medvax Health, FCT, Abuja, Nigeria."}]}},{"fullName":"Chukwuedo G","firstName":"Goldie","lastName":"Chukwuedo","initials":"G","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Medvax Health, FCT, Abuja, Nigeria."}]}},{"fullName":"Isaac E","firstName":"Ejeh","lastName":"Isaac","initials":"E","authorId":{"type":"ORCID","value":"0009-0008-4641-1901"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Medvax Health, FCT, Abuja, Nigeria."}]}},{"fullName":"Uzoma V","firstName":"Victory","lastName":"Uzoma","initials":"V","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Medvax Health, FCT, Abuja, Nigeria."}]}},{"fullName":"Eneh SC","firstName":"Stanley Chinedu","lastName":"Eneh","initials":"SC","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Community Health Department, Faculty of Clinical Sciences, Obafemi Awolowo University, Osun State, Ile-Ife, Nigeria."},{"affiliation":"Interdisciplinary Health Sciences, University of Texas at El Paso, El Paso, TX, United States."}]}},{"fullName":"Chinyere FP","firstName":"Felix Peace","lastName":"Chinyere","initials":"FP","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Nursing Science, University of Benin, Benin City, Nigeria."}]}},{"fullName":"Precious OM","firstName":"Oluchi Mmesoma","lastName":"Precious","initials":"OM","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Pharmacy, Nnamdi Azikiwe University, Awka, Anambra State, Nigeria."}]}},{"fullName":"Onukansi FO","firstName":"Francisca Ogochukwu","lastName":"Onukansi","initials":"FO","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Public Health, Federal University of Technology Owerri, Owerri, Imo State, Nigeria."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0009-0008-4641-1901"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics"]},"journalInfo":{"volume":"8","journalIssueId":4117475,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Frontiers in digital health","medlineAbbreviation":"Front Digit Health","isoabbreviation":"Front Digit Health","nlmid":"101771889","essn":"2673-253X","issn":"2673-253X"}},"pubYear":"2026","pageInfo":"1777667","abstractText":"Chatbots are increasingly used in digital health to expand access to information and support user engagement. In sexual and reproductive health and rights (SRHR), where stigma, privacy concerns, and health system constraints often limit timely access to accurate information, chatbots have been proposed as scalable tools for delivering education and facilitating service navigation. This perspective examines the role of chatbots as frontline educators in SRHR, drawing insights from existing evidence to assess the effectiveness of chatbots, practical implications, key limitations, and ethical considerations. Available evidence suggests that chatbots can enhance access to SRHR information, support user engagement, and contribute to improved knowledge, confidence, and linkage to services. However, the current evidence base remains uneven, with limited rigorous evaluation of long-term behavioural or health outcomes. Challenges related to accuracy, contextual responsiveness, privacy, equity, and accountability persist, underscoring the need for careful design and governance. Positioning chatbots as complementary components within integrated SRHR strategies, rather than standalone solutions, may offer a pragmatic pathway to harness their potential while safeguarding user rights and health outcomes.","affiliation":"Medvax Health, FCT, Abuja, Nigeria.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["brief-report","Journal Article"]},"keywordList":{"keyword":["Health education","Ethics","Data Privacy","Digital Health","Sexual And Reproductive Health And Rights","Chatbots","Artificial Intelligence In Health Care"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/fdgth.2026.1777667"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13044073"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13044073?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-04-06","dateOfCreation":"2026-04-06","firstIndexDate":"2026-04-07","fullTextReceivedDate":"2026-04-03","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-03-19","firstPublicationDate":"2026-03-19"},{"id":"42377556","source":"MED","pmid":"42377556","pmcid":"PMC13319698","fullTextIdList":{"fullTextId":["PMC13319698"]},"doi":"10.1007/s00296-026-06182-5","title":"Artificial intelligence in rheumatology: a cross-sectional Scopus-based analysis.","authorString":"Otebay D, Kapanova G, Nurmashev B, Mukhamediyarov M, Kocyigit BF.","authorList":{"author":[{"fullName":"Otebay D","firstName":"Dinmukhammed","lastName":"Otebay","initials":"D","authorId":{"type":"ORCID","value":"0000-0003-3940-7978"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Public Health, Asfendiyarov Kazakh National Medical University, Almaty, Kazakhstan."}]}},{"fullName":"Kapanova G","firstName":"Gulnara","lastName":"Kapanova","initials":"G","authorId":{"type":"ORCID","value":"0000-0002-6521-6836"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Health Policy and Organization, Al-Farabi Kazakh National University, Almaty, Kazakhstan."}]}},{"fullName":"Nurmashev B","firstName":"Bekaidar","lastName":"Nurmashev","initials":"B","authorId":{"type":"ORCID","value":"0000-0003-3949-2543"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Chemical Disciplines, Biology and Biochemistry, South Kazakhstan Medical Academy, Shymkent, Kazakhstan."}]}},{"fullName":"Mukhamediyarov M","firstName":"Maidan","lastName":"Mukhamediyarov","initials":"M","authorId":{"type":"ORCID","value":"0000-0003-0153-3741"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Chemical Disciplines, Biology and Biochemistry, South Kazakhstan Medical Academy, Shymkent, Kazakhstan."}]}},{"fullName":"Kocyigit BF","firstName":"Burhan Fatih","lastName":"Kocyigit","initials":"BF","authorId":{"type":"ORCID","value":"0000-0002-6065-8002"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Physical Medicine and Rehabilitation, Adana City Research and Training Hospital, University of Health Sciences, Adana, Türkiye. bfk2701@hotmail.com."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-6065-8002"},{"type":"ORCID","value":"0000-0002-6521-6836"},{"type":"ORCID","value":"0000-0003-0153-3741"},{"type":"ORCID","value":"0000-0003-3940-7978"},{"type":"ORCID","value":"0000-0003-3949-2543"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"7","volume":"46","journalIssueId":4215116,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"printPublicationDate":"2026-06-01","journal":{"title":"Rheumatology international","medlineAbbreviation":"Rheumatol Int","isoabbreviation":"Rheumatol Int","nlmid":"8206885","essn":"1437-160X","issn":"0172-8172"}},"pubYear":"2026","pageInfo":"175","abstractText":"Artificial intelligence (AI) is increasingly used in clinical medicine. Rheumatology is well-suited to AI applications due to diagnostic complexity of rheumatic diseases, variable disease presentations, and multisystem involvement. This cross-sectional study examines global AI research in rheumatology through bibliometric analysis of Scopus data. The Scopus database was searched on May 5, 2026, using the terms \"artificial intelligence\" AND \"rheum*\" in the title, abstract, and keyword fields. No temporal restrictions were applied, and all English documents were analyzed. Bibliometric data, including publication year, country, institution, author, journal, and keywords, were extracted. Retracted articles were identified using Scopus tags and were manually verified through related journal editorial notices. Disease-specific publication counts were determined through independent searches for rheumatic diseases. Survey-based studies were identified through manual review. Linear regression analysis was conducted to assess temporal trends. A total of 1,057 publications were identified. Annual output remained below 10 until 2018, then rose sharply to a peak of 282 in 2025. Linear regression confirmed a significant upward trend (p < 0.001). The United States produced the most publications (n = 249), followed by the United Kingdom (n = 141) and India (n = 138). Harvard Medical School was the leading institution (n = 33), and Knitza, J., was the most prolific author (n = 17). Rheumatology International published the most articles (n = 27). Osteoarthritis (n = 1,017) and rheumatoid arthritis (n = 646) dominated the field, while systemic vasculitis (n = 40), Behçet disease (n = 29), and familial Mediterranean fever (n = 16) were underrepresented. Eleven survey-based studies were identified, mostly published between 2024 and 2025. Two articles were retracted due to peer review irregularities. AI research in rheumatology has increased significantly, with research outputs stemming from a limited number of countries, institutions, and disease categories. Osteoarthritis and rheumatoid arthritis are the most frequently explored diseases in the field. The increasing number of survey-based studies indicates heightened attention to clinician and patient perspectives. Future research should focus on expanding international collaboration, addressing gaps in AI research on underrepresented diseases, and strengthening ethical and methodological standards to facilitate broader AI adoption in rheumatology.","affiliation":"Department of Public Health, Asfendiyarov Kazakh National Medical University, Almaty, Kazakhstan.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"grantsList":{"grant":[{"agency":"University of Health Sciences","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Rheumatic Diseases","meshQualifierList":{"meshQualifier":[{"abbreviation":"DI","qualifierName":"diagnosis","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Cross-Sectional Studies"},{"majorTopic_YN":"Y","descriptorName":"Rheumatology","meshQualifierList":{"meshQualifier":[{"abbreviation":"TD","qualifierName":"trends","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Bibliometrics"},{"majorTopic_YN":"Y","descriptorName":"Artificial Intelligence","meshQualifierList":{"meshQualifier":[{"abbreviation":"TD","qualifierName":"trends","majorTopic_YN":"N"}]}}]},"keywordList":{"keyword":["Artificial intelligence","bibliometrics","Rheumatology","Rheumatic Diseases","Bibliometric Analysis","Surveys And Questionnaires"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1007/s00296-026-06182-5"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13319698"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13319698?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-06-30","dateOfCreation":"2026-06-30","firstIndexDate":"2026-07-02","fullTextReceivedDate":"2026-08-19","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-30","firstPublicationDate":"2026-06-30"},{"id":"42262014","source":"MED","pmid":"42262014","pmcid":"PMC13291734","fullTextIdList":{"fullTextId":["PMC13291734"]},"doi":"10.2196/91741","title":"Evolution of Chatbots as an Educational and Supportive Digital Intervention for Family Caregivers of People With Dementia: Protocol for a Systematic Integrative Review.","authorString":"Rathnayake S, Barbosa A, Tu J, Randell R.","authorList":{"author":[{"fullName":"Rathnayake S","firstName":"Sarath","lastName":"Rathnayake","initials":"S","authorId":{"type":"ORCID","value":"0000-0003-2379-1610"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Centre for Digital Innovations in Health and Social Care, University of Bradford, Bradford, West Yorkshire, United Kingdom."}]}},{"fullName":"Barbosa A","firstName":"Ana","lastName":"Barbosa","initials":"A","authorId":{"type":"ORCID","value":"0000-0001-9644-8237"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Centre for Digital Innovations in Health and Social Care, University of Bradford, Bradford, West Yorkshire, United Kingdom."}]}},{"fullName":"Tu J","firstName":"Jiada","lastName":"Tu","initials":"J","authorId":{"type":"ORCID","value":"0000-0002-8300-4861"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Centre for Digital Innovations in Health and Social Care, University of Bradford, Bradford, West Yorkshire, United Kingdom."}]}},{"fullName":"Randell R","firstName":"Rebecca","lastName":"Randell","initials":"R","authorId":{"type":"ORCID","value":"0000-0002-5856-4912"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Centre for Digital Innovations in Health and Social Care, University of Bradford, Bradford, West Yorkshire, United Kingdom."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-9644-8237"},{"type":"ORCID","value":"0000-0002-5856-4912"},{"type":"ORCID","value":"0000-0002-8300-4861"},{"type":"ORCID","value":"0000-0003-2379-1610"}]},"journalInfo":{"volume":"15","journalIssueId":4204571,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"printPublicationDate":"2026-06-01","journal":{"title":"JMIR research protocols","medlineAbbreviation":"JMIR Res Protoc","isoabbreviation":"JMIR Res Protoc","nlmid":"101599504","essn":"1929-0748","issn":"1929-0748"}},"pubYear":"2026","pageInfo":"e91741","abstractText":"<h4>Background</h4>Most people with dementia reside in the community and are cared for by family members. Family caregivers play an essential role in supporting their loved ones with dementia and require adequate education and support to address their care needs. In recent years, there has been growing interest in the use of chatbot technologies in health care, particularly to provide education and support for caregivers. However, evidence on the development, use, and effectiveness of these technologies in dementia care remains limited.<h4>Objective</h4>This systematic integrative review aims to synthesize evidence on chatbot applications as an educational and supportive tool for family caregivers of people with dementia.<h4>Methods</h4>A systematic integrative literature review will be conducted following a validated framework. The findings will be reported in accordance with PRISMA (Preferred Reporting Items for Systematic Reviews and Meta-Analyses) guidelines. The search strategy will be structured around 3 broad concepts: \"dementia,\" \"caregiver,\" and \"chatbot applications.\" Full-text articles based on empirical studies published in English from inception to 2026 that address the design, development, or evaluation of chatbot applications for family caregivers of people with dementia will be included. Editorials, study protocols, review articles, opinion and perspective papers, technical notes, and non-English publications will be excluded. Covidence software will be used to manage study screening. At least 2 independent reviewers will screen titles, abstracts, and full texts and extract data using a pretested data extraction form. Methodological quality will be assessed using Mixed Methods Appraisal Tool (version 2018), and data relevance will be evaluated using a 2-point scale (high or low).<h4>Results</h4>The literature search will commence in May 2026, and the findings are expected to be published as a systematic integrative review, with submission planned for January 2027.<h4>Conclusions</h4>This systematic integrative review aims to synthesize evidence from qualitative, quantitative, and mixed methods studies to provide a comprehensive understanding of how chatbot interventions are conceptualized, developed, and evaluated within dementia caregiving contexts. In addition, this review will identify key barriers and challenges as well as ethical and safety concerns associated with the design, development, and implementation of chatbot applications for family caregivers of people with dementia.<h4>Trial registration</h4>PROSPERO CRD420261288076; https://www.crd.york.ac.uk/PROSPERO/view/CRD420261288076.<h4>International registered report identifier (irrid)</h4>PRR1-10.2196/91741.","affiliation":"Centre for Digital Innovations in Health and Social Care, University of Bradford, Bradford, West Yorkshire, United Kingdom.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Dementia","meshQualifierList":{"meshQualifier":[{"abbreviation":"NU","qualifierName":"nursing","majorTopic_YN":"N"},{"abbreviation":"PX","qualifierName":"psychology","majorTopic_YN":"N"},{"abbreviation":"TH","qualifierName":"therapy","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Caregivers","meshQualifierList":{"meshQualifier":[{"abbreviation":"ED","qualifierName":"education","majorTopic_YN":"N"},{"abbreviation":"PX","qualifierName":"psychology","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Systematic Reviews as Topic"}]},"keywordList":{"keyword":["Artificial intelligence","Support","Dementia","AI","Education","Family Caregivers","Integrative Review","Conversational Agent","Chatbot"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/91741"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13291734"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13291734?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-06-13","dateOfCreation":"2026-06-09","firstIndexDate":"2026-06-10","fullTextReceivedDate":"2026-06-26","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-09","firstPublicationDate":"2026-06-09"},{"id":"42005406","source":"MED","pmid":"42005406","pmcid":"PMC13091501","fullTextIdList":{"fullTextId":["PMC13091501"]},"doi":"10.1016/j.mcpdig.2026.100353","title":"Psychiatry's Blind Spot: Independent Use of General-Purpose Large Language Models by Individuals With Psychopathology.","authorString":"Vinh T, Goodman G, Sherrill AM.","authorList":{"author":[{"fullName":"Vinh T","firstName":"Tuan","lastName":"Vinh","initials":"T","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Medical Sciences Division, University of Oxford, Oxford, United Kingdom."}]}},{"fullName":"Goodman G","firstName":"Geoff","lastName":"Goodman","initials":"G","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry and Behavioral Sciences, Emory University School of Medicine, Atlanta, GA."}]}},{"fullName":"Sherrill AM","firstName":"Andrew M","lastName":"Sherrill","initials":"AM","authorId":{"type":"ORCID","value":"0000-0002-7743-745X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry and Behavioral Sciences, Emory University School of Medicine, Atlanta, GA."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-7743-745X"}]},"journalInfo":{"issue":"2","volume":"4","journalIssueId":4154301,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"printPublicationDate":"2026-06-01","journal":{"title":"Mayo Clinic proceedings. Digital health","medlineAbbreviation":"Mayo Clin Proc Digit Health","isoabbreviation":"Mayo Clin Proc Digit Health","nlmid":"9918662584506676","essn":"2949-7612","issn":"2949-7612"}},"pubYear":"2026","pageInfo":"100353","affiliation":"Medical Sciences Division, University of Oxford, Oxford, United Kingdom.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"grantsList":{"grant":[{"grantId":"2326144","agency":"National Science Foundation","orderIn":0}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1016/j.mcpdig.2026.100353"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13091501"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13091501?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"N","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by-nc-nd","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-04-20","dateOfCreation":"2026-04-20","firstIndexDate":"2026-04-20","fullTextReceivedDate":"2026-04-22","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-03-14","firstPublicationDate":"2026-03-14"},{"id":"PMC13301336","source":"PMC","pmcid":"PMC13301336","fullTextIdList":{"fullTextId":["PMC13301336"]},"title":"Perioperative Risk Stratification with AI-Powered Chatbots: A Systematic Review and Meta-Analysis","authorString":"Bellini V, Panizzi M, Delrio S, Berdini M, Sapountzakis V, dos Santos Diego L, Bignami E.","authorList":{"author":[{"fullName":"Bellini V","firstName":"Valentina","lastName":"Bellini","initials":"V","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Anesthesiology, Critical Care and Pain Medicine Division, Department of Medicine and Surgery, University of Parma, Viale Gramsci 14, 43126 Parma, Italy; (V.B.); (M.P.); (S.D.); (M.B.)"}]}},{"fullName":"Panizzi M","firstName":"Matteo","lastName":"Panizzi","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Anesthesiology, Critical Care and Pain Medicine Division, Department of Medicine and Surgery, University of Parma, Viale Gramsci 14, 43126 Parma, Italy; (V.B.); (M.P.); (S.D.); (M.B.)"}]}},{"fullName":"Delrio S","firstName":"Stefano","lastName":"Delrio","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Anesthesiology, Critical Care and Pain Medicine Division, Department of Medicine and Surgery, University of Parma, Viale Gramsci 14, 43126 Parma, Italy; (V.B.); (M.P.); (S.D.); (M.B.)"}]}},{"fullName":"Berdini M","firstName":"Michele","lastName":"Berdini","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Anesthesiology, Critical Care and Pain Medicine Division, Department of Medicine and Surgery, University of Parma, Viale Gramsci 14, 43126 Parma, Italy; (V.B.); (M.P.); (S.D.); (M.B.)"}]}},{"fullName":"Sapountzakis V","firstName":"Victor","lastName":"Sapountzakis","initials":"V","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Anesthesiology and Perioperative Medicine Division, Servicos Medicos de Anestesia (SMA), Rua Conselheiro Brotero 1486, São Paulo 01232-910, Brazil;"}]}},{"fullName":"dos Santos Diego L","firstName":"Luis Antonio","lastName":"dos Santos Diego","initials":"L","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Departamento de Anestesiologia, Universidade Federal Fluminense (UFF), Rio de Janeiro 24070-090, Brazil;"}]}},{"fullName":"Bignami E","firstName":"Elena Giovanna","lastName":"Bignami","initials":"E","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Anesthesiology, Critical Care and Pain Medicine Division, Department of Medicine and Surgery, University of Parma, Viale Gramsci 14, 43126 Parma, Italy; (V.B.); (M.P.); (S.D.); (M.B.)"}]}}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"12","volume":"15","journalIssueId":4221242,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"printPublicationDate":"2026-06-01","journal":{"title":"Journal of clinical medicine","medlineAbbreviation":"J Clin Med","isoabbreviation":"J Clin Med","nlmid":"101606588","essn":"2077-0383","issn":"2077-0383"}},"pubYear":"2026","language":"eng","pubModel":"Undetermined","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"keywordList":{"keyword":["Artificial intelligence","Risk stratification","risk management","risk assessment","Clinical Decision Support","Perioperative","Chatbot","Anesthesia Planning"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Free","availabilityCode":"F","documentStyle":"html","site":"PubMedCentral","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC13301336/?tool=EBI"},{"availability":"Free","availabilityCode":"F","documentStyle":"pdf","site":"PubMedCentral","url":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC13301336/pdf/?tool=EBI"},{"availability":"Free","availabilityCode":"F","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13301336"},{"availability":"Free","availabilityCode":"F","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13301336?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"N","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCreation":"2026-06-26","firstIndexDate":"2026-06-26","fullTextReceivedDate":"2026-06-26","dateOfRevision":"2026-06-26","electronicPublicationDate":"2026-06-01","firstPublicationDate":"2026-06-01"},{"id":"42205209","source":"MED","pmid":"42205209","pmcid":"PMC13201925","fullTextIdList":{"fullTextId":["PMC13201925"]},"doi":"10.1177/20552076261455239","title":"Generative artificial intelligence in depression research: A bibliometric analysis of WoSCC-Indexed literature.","authorString":"Chen H, Chen L, Yang J, Tang A, Yang Y.","authorList":{"author":[{"fullName":"Chen H","firstName":"Hongfei","lastName":"Chen","initials":"H","authorId":{"type":"ORCID","value":"0009-0002-0848-5076"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Clinical Medical College & Affiliated Hospital of Chengdu University, Chengdu, Sichuan, China."}]}},{"fullName":"Chen L","firstName":"Lin","lastName":"Chen","initials":"L","authorId":{"type":"ORCID","value":"0000-0002-0109-2651"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Clinical Medical College & Affiliated Hospital of Chengdu University, Chengdu, Sichuan, China."}]}},{"fullName":"Yang J","firstName":"Jin","lastName":"Yang","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Clinical Medical College & Affiliated Hospital of Chengdu University, Chengdu, Sichuan, China."}]}},{"fullName":"Tang A","firstName":"Aifa","lastName":"Tang","initials":"A","authorId":{"type":"ORCID","value":"0000-0002-7516-0506"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of General Practice Medicine, Shenzhen University, The Third Affiliated Hospital of Shenzhen University(Luohu Hospital Group), Shenzhen, Guangdong, China."}]}},{"fullName":"Yang Y","firstName":"Yafei","lastName":"Yang","initials":"Y","authorId":{"type":"ORCID","value":"0000-0002-6208-8007"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Urology, Shenzhen University, The Third Affiliated Hospital of Shenzhen University (Luohu Hospital Group), Shenzhen, Guangdong, China."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-0109-2651"},{"type":"ORCID","value":"0000-0002-6208-8007"},{"type":"ORCID","value":"0000-0002-7516-0506"},{"type":"ORCID","value":"0009-0002-0848-5076"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"12","journalIssueId":4085000,"dateOfPublication":"2026 Jan-Dec","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Digital health","medlineAbbreviation":"Digit Health","isoabbreviation":"Digit Health","nlmid":"101690863","essn":"2055-2076","issn":"2055-2076"}},"pubYear":"2026","pageInfo":"20552076261455239","abstractText":"<h4>Background</h4>Depression is a leading global cause of disability. The rapid emergence of generative artificial intelligence (GenAI), particularly large language models (LLMs) like ChatGPT, offers new opportunities for digital psychiatry. However, the Web of Science Core Collection (WoSCC) -indexed research landscape of GenAI in depression has not yet been systematically mapped.<h4>Objective</h4>This study aimed to systematically evaluate the WoSCC-indexed research landscape, hotspots, and emerging trends of GenAI in depression through bibliometric analysis.<h4>Methods</h4>A bibliometric analysis was conducted on publications from the WoSCC (January 2023-July 2025). Additionally, PubMed was searched to identify relevant clinical and translational studies for contextual interpretation. Analyses utilized CiteSpace, VOSviewer, and Bibliometrix.<h4>Results</h4>We identified 115 publications, with publication output increasing markedly from 2023 to mid-2025. The United States and China led in volume, with Harvard University as a key contributor. International collaboration involved 39 countries but remained regionally concentrated. Co-citation analysis revealed 10 clusters, including depression management, deep learning, and NLP. Keyword bursts highlighted trends in \"large language models,\" \"ChatGPT,\" and \"digital health.\" Top-cited works focused on conversational agents and LLM evaluation.<h4>Conclusion</h4>This study provides one of the first bibliometric analyses of WoSCC-indexed research on GenAI in depression, highlighting increasing scholarly attention to conversational agents, large language models, and digital mental health applications. Future research should prioritize clinical validation, safety, and interdisciplinary collaboration to strengthen the evidence base for responsible implementation.","affiliation":"Clinical Medical College & Affiliated Hospital of Chengdu University, Chengdu, Sichuan, China.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["research-article","Journal Article"]},"grantsList":{"grant":[{"grantId":"2024-YF05-00989-SN","agency":"Chengdu Science and Technology Bureau Technology Innovation R &amp; D Project","orderIn":0},{"grantId":"2023343","agency":"Chengdu Medical Research Projects","orderIn":0},{"grantId":"S22049","agency":"Sichuan Medical (Youth Innovative) Scientific Research Projects","orderIn":0},{"grantId":"2023128","agency":"Chengdu Medical Research Projects","orderIn":0},{"grantId":"S22002","agency":"Sichuan Medical (Youth Innovative) Scientific Research Projects","orderIn":0},{"grantId":"Y202204","agency":"Young Talents Program of the Affiliated Hospital of Chengdu University and the Program of the Affiliated Hospital of Chengdu University","orderIn":0},{"grantId":"2022051","agency":"Chengdu Medical Research Projects","orderIn":0},{"grantId":"2023087","agency":"Chengdu Medical Research Projects","orderIn":0},{"grantId":"CDFYCX202207","agency":"Innovation Team Project of the Affiliated Hospital of Chengdu University","orderIn":0},{"grantId":"24QNMP083","agency":"Health Commission of Sichuan Province Medical Science and Technology Program","orderIn":0},{"grantId":"82300869","agency":"National Natural Science Foundation of China","orderIn":0},{"grantId":"Y202207","agency":"Young Talents Program of the Affiliated Hospital of Chengdu University and the Program of the Affiliated Hospital of Chengdu University","orderIn":0},{"grantId":"2022181","agency":"Chengdu Medical Research Projects","orderIn":0},{"grantId":"Q23002","agency":"Sichuan Medical (Youth Innovative) Scientific Research Projects","orderIn":0},{"grantId":"SASM202201024","agency":"The Sanming Project of Medicine in Shenzhen","orderIn":0},{"grantId":"2020YZZ08","agency":"Young Talents Program of the Affiliated Hospital of Chengdu University and the Program of the Affiliated Hospital of Chengdu University","orderIn":0},{"grantId":"2025M782291","agency":"78th Batch of General Funding Projects of China Postdoctoral Science Foundation","orderIn":0},{"grantId":"Q20013","agency":"Sichuan Medical (Youth Innovative) Scientific Research Projects","orderIn":0}]},"keywordList":{"keyword":["Depression","Bibliometric Analysis","Digital Mental Health","Large Language Models (Llms)","Generative Artificial Intelligence (Genai)"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1177/20552076261455239"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13201925"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13201925?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by-nc","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["nct","doi"]},"dateOfCompletion":"2026-05-28","dateOfCreation":"2026-05-28","firstIndexDate":"2026-05-29","fullTextReceivedDate":"2026-05-27","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-05-25","firstPublicationDate":"2026-01-01"},{"id":"42303759","source":"MED","pmid":"42303759","pmcid":"PMC13272657","fullTextIdList":{"fullTextId":["PMC13272657"]},"doi":"10.1038/s44271-026-00486-9","title":"Why sycophantic LLMs may imperil interactive norms between humans.","authorString":"Gu R, Chen Z, Peng M, Liu C, Lin Z.","authorList":{"author":[{"fullName":"Gu R","firstName":"Ruolei","lastName":"Gu","initials":"R","authorId":{"type":"ORCID","value":"0000-0001-8722-2172"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"State Key Laboratory of Cognitive Science and Mental Health, Institute of Psychology, Chinese Academy of Sciences, Beijing, China."},{"affiliation":"Department of Psychology, University of Chinese Academy of Sciences, Beijing, China."}]}},{"fullName":"Chen Z","firstName":"Zhiyi","lastName":"Chen","initials":"Z","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Experimental Research Center for Medical and Psychological Science, School of Psychology, Third Military Medical University, Chongqing, China."},{"affiliation":"Key Laboratory of Cognition and Personality, Ministry of Education, Chongqing, China."}]}},{"fullName":"Peng M","firstName":"Ming","lastName":"Peng","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Psychology, Central China Normal University, Wuhan, China."}]}},{"fullName":"Liu C","firstName":"Chao","lastName":"Liu","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"State Key Laboratory of Cognitive Neuroscience and Learning and IDG/McGovern Institute for Brain Research, Beijing Normal University, Beijing, China."},{"affiliation":"Beijing Key Laboratory of Safe AI and Superalignment, Beijing, China."}]}},{"fullName":"Lin Z","firstName":"Zhicheng","lastName":"Lin","initials":"Z","authorId":{"type":"ORCID","value":"0000-0002-6864-6559"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychology, Yonsei University, Seoul, Republic of Korea. zhichenglin@gmail.com."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-8722-2172"},{"type":"ORCID","value":"0000-0002-6864-6559"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"1","volume":"4","journalIssueId":4209453,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"printPublicationDate":"2026-06-01","journal":{"title":"Communications psychology","medlineAbbreviation":"Commun Psychol","isoabbreviation":"Commun Psychol","nlmid":"9918716686206676","essn":"2731-9121","issn":"2731-9121"}},"pubYear":"2026","pageInfo":"96","abstractText":"Interactions with conversational AI are effortless by design-instant, compliant, and largely consequence-free. Human communication norms, by contrast, evolved under conditions of reciprocity and social accountability. We propose that repeated engagement with conversational AI systems may produce norm leakage: the cross-context carryover of instrumental communicative habits acquired in human-AI exchanges into subsequent human-human interaction. Emerging experimental evidence suggests short-term spillover effects on social judgment and behavior, including harsher evaluations, reduced cooperation, and diminished perceived humanness. Preliminary longitudinal findings are consistent with the possibility that such exposure may shape communicative habits over time, although the durability and real-world magnitude of these effects remain unclear. We further propose that sycophantic alignment may amplify norm leakage by reinforcing instrumental interaction styles. At stake, then, is the possibility that repeated engagement with highly compliant artificial agents could subtly influence users' communicative expectations and interpersonal judgments.","affiliation":"State Key Laboratory of Cognitive Science and Mental Health, Institute of Psychology, Chinese Academy of Sciences, Beijing, China.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1038/s44271-026-00486-9"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13272657"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13272657?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by-nc-nd","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-06-16","dateOfCreation":"2026-06-16","firstIndexDate":"2026-06-18","fullTextReceivedDate":"2026-06-24","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-16","firstPublicationDate":"2026-06-16"},{"id":"41635794","source":"MED","pmid":"41635794","pmcid":"PMC12862967","fullTextIdList":{"fullTextId":["PMC12862967"]},"doi":"10.1093/oodh/oqag001","title":"Designing conversational intelligence: effect of large language models (GPT-driven) platforms for precision maternal and newborn health engagement: a systematic review.","authorString":"Rasoli R, Ebrahimisadrabadi F, Khedri Z, Sohrabei S.","authorList":{"author":[{"fullName":"Rasoli R","firstName":"Robab","lastName":"Rasoli","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Nursing and Midwifery, Department of Midwifery, Zanjan University of Medical Sciences, Zanjan, Iran."}]}},{"fullName":"Ebrahimisadrabadi F","firstName":"Fahimeh","lastName":"Ebrahimisadrabadi","initials":"F","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Economics, University of New Hampshire, Durham, NH, USA."}]}},{"fullName":"Khedri Z","firstName":"Zahra","lastName":"Khedri","initials":"Z","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Obstetrics and Gynecology, Ziaeian Hospital, Tehran University of Medical Sciences, Tehran, Iran."}]}},{"fullName":"Sohrabei S","firstName":"Solmaz","lastName":"Sohrabei","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Student Research Committee, Department and Faculty of Health Information Technology and Management, Medical Informatics, School of Allied Medical Sciences, Shahid Beheshti University of Medical Sciences, Tehran, Iran."}]}}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"4","journalIssueId":4096484,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Oxford open digital health","medlineAbbreviation":"Oxf Open Digit Health","isoabbreviation":"Oxf Open Digit Health","nlmid":"9918716088606676","essn":"2754-4591","issn":"2754-4591"}},"pubYear":"2026","pageInfo":"oqag001","abstractText":"Maternal and newborn mortality remain stubbornly high in low-resource settings, driven by limited access to timely, personalized and emotionally supportive care during pregnancy. Large language models/generative pre-trained transformer (LLM/GPTs), particularly GPT-driven conversational agents, have emerged as scalable, versatile digital health tools capable of delivering evidence-based information, mental health support and risk stratification for complications such as preeclampsia, gestational diabetes and preterm birth. This systematic review aimed to synthesize global evidence on the design, implementation and effectiveness of LLM/GPT-powered chatbots for precision maternal and newborn health engagement. Following PRISMA 2020 guidelines, we searched MEDLINE, Embase, CINAHL, Web of Science, Inspec and IEEE Xplore from January 2015 to November 2025. We included 15 peer-reviewed studies (published 2021-2025) that developed or evaluated GPT-based or equivalent generative conversational agents for pregnant individuals or their partners. Quality appraisal used EQUATOR tools and artificial intelligence-specific frameworks; two reviewers independently assessed risk of bias. The 15 studies (total participants >12 000) covered 12 countries. LLM/GPT-powered chatbots outperformed LLM/GPT systems in conversational naturalness, topic diversity and user satisfaction (mean acceptability scores 85-94%). Core functions included real-time psychoeducation (<i>n</i> = 14 studies), mental health screening and behavioral activation (<i>n</i> = 11/15), partner engagement (<i>n</i> = 6/15), and predictive risk modeling for adverse outcomes (<i>n</i> = 9). LLM models achieved high diagnostic concordance with clinicians for gestational diabetes (area under the curve 0.88 to 0.94) and preeclampsia warning signs. User retention ranged from 62 to 78% over 6 months, with the strongest engagement among prim parous and underserved populations. No serious harms were reported. LLM/GPT-driven conversational agents represent a breakthrough in accessible, personalized maternal and newborn health support. They effectively bridge gaps in high-risk pregnancy, emotional care, risk detection and partner involvement while maintaining safety and cultural adaptability. These findings strongly support rapid integration of LLM/GPT-powered chatbots into routine antenatal care pathways, particularly in low- and middle-income settings. The study was registered with PROSPERO (CRD420251230253).","affiliation":"School of Nursing and Midwifery, Department of Midwifery, Zanjan University of Medical Sciences, Zanjan, Iran.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"keywordList":{"keyword":["Pregnancy","GPT","Systematic review","Maternal Health","Digital Health","Newborn Health","Chatbots","Large Language Models","Precision Engagement","Conversational Ai (Artificial Intelligence)"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1093/oodh/oqag001"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12862967"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12862967?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-02-04","dateOfCreation":"2026-02-04","firstIndexDate":"2026-02-09","fullTextReceivedDate":"2026-02-12","dateOfRevision":"2026-07-26","electronicPublicationDate":"2026-01-07","firstPublicationDate":"2026-01-07"},{"id":"41688781","source":"MED","pmid":"41688781","pmcid":"PMC13009442","fullTextIdList":{"fullTextId":["PMC13009442"]},"doi":"10.1007/s44192-026-00391-x","title":"A review of artificial intelligence enhanced cognitive behavioural therapy using the BECK AI BOT for mental health interventions.","authorString":"Savio A, Srivastava M, Jose MR, Kumar N, Elanjickal CS, Singh K.","authorList":{"author":[{"fullName":"Savio A","firstName":"Abel","lastName":"Savio","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychology, School of Social Sciences, Christ University, New Delhi, Delhi-NCR, 201003, India."}]}},{"fullName":"Srivastava M","firstName":"Manshvi","lastName":"Srivastava","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychology, School of Social Sciences, Christ University, New Delhi, Delhi-NCR, 201003, India."}]}},{"fullName":"Jose MR","firstName":"Maria Rose","lastName":"Jose","initials":"MR","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychology, School of Social Sciences, Christ University, New Delhi, Delhi-NCR, 201003, India."}]}},{"fullName":"Kumar N","firstName":"Nikita","lastName":"Kumar","initials":"N","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychology, School of Social Sciences, Christ University, New Delhi, Delhi-NCR, 201003, India."}]}},{"fullName":"Elanjickal CS","firstName":"Crissin Sojan","lastName":"Elanjickal","initials":"CS","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Business and Management, Christ University, Delhi-NCR, New Delhi, 201003, India."}]}},{"fullName":"Singh K","firstName":"Kuljeet","lastName":"Singh","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Computer Science, School of Sciences, Christ University, Delhi-NCR, New Delhi, 201003, India. kuljeet.singh@christuniversity.in."}]}}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"1","volume":"6","journalIssueId":4139551,"dateOfPublication":"2026 Feb","monthOfPublication":2,"yearOfPublication":2026,"printPublicationDate":"2026-02-01","journal":{"title":"Discover mental health","medlineAbbreviation":"Discov Ment Health","isoabbreviation":"Discov Ment Health","nlmid":"9918350483906676","essn":"2731-4383","issn":"2731-4383"}},"pubYear":"2026","pageInfo":"43","abstractText":"The integration of artificial intelligence (AI) and cognitive behaviour therapy (CBT) is a revolutionary solution to the global mental health issue, characterized by increasing need and decreased access to treatment. This research investigates the potential of AI-fortified cognitive behavioural therapy technologies, including chatbots, virtual reality, and adaptive learning modules, to enhance the efficacy, accessibility, and individualization of treatment for anxiety, depression, and PTSD. The study evaluates the scalability, ethical issues, and therapeutic efficacy of the therapies by combining peer-reviewed and experimental data. The suggested methodology combines AI-driven conversational therapy with predictive modelling to deliver individualized, real-time mental health treatment. In this study, a conceptual chatbot prototype, designated BECK-AI BOT, was developed to illustrate the application’s interface and functionality, enhancing accessibility for both patients and therapists in the future. This study does not present new clinical trial data. All reported symptom-reduction and engagement findings are drawn from previously published studies of existing AI-driven CBT systems (e.g., Woebot, Wysa, Eleos, Limbic). The present work offers a narrative synthesis of current evidence and introduces a conceptual architecture and prototype (BECK-AI BOT), without evaluating it clinically. Notwithstanding these difficulties, problems persist, including a lack of long-term efficacy statistics, cultural sensitivity issues, and moral reservations about over-reliance on AI during emergencies. The argument comes in the form of AI possibly improving, not replacing, human therapists, emphasizing hybrid systems for fair treatment. Future research needs to advance emotional intelligence within AI, which combines AI-driven conversational therapy and predictive modelling to deliver real-time, personalized mental health services.","affiliation":"Department of Psychology, School of Social Sciences, Christ University, New Delhi, Delhi-NCR, 201003, India.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"keywordList":{"keyword":["Depression","Mental health","Post-traumatic Stress Disorder (Ptsd)","Cognitive Behavioural Therapy (Cbt)","Artificial Intelligence (Ai)"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1007/s44192-026-00391-x"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13009442"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13009442?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by-nc-nd","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-06-27","dateOfCreation":"2026-02-13","firstIndexDate":"2026-02-14","fullTextReceivedDate":"2026-03-25","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-02-14","firstPublicationDate":"2026-02-14"},{"id":"41952825","source":"MED","pmid":"41952825","pmcid":"PMC13054807","fullTextIdList":{"fullTextId":["PMC13054807"]},"doi":"10.3389/fpubh.2026.1603238","title":"Toward clinical integration of generative AI in mental health: personalization, multimodality and inter-entity experience.","authorString":"Frisone F, Pupillo C, Rossi C, Riva G.","authorList":{"author":[{"fullName":"Frisone F","firstName":"Fabio","lastName":"Frisone","initials":"F","authorId":{"type":"ORCID","value":"0000-0002-1766-831X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Humane Technology Laboratory, Catholic University of the Sacred Heart, Milan, Italy."},{"affiliation":"Sophia University Institute, Figline e Incisa Valdarno (Firenze), Italy."}]}},{"fullName":"Pupillo C","firstName":"Chiara","lastName":"Pupillo","initials":"C","authorId":{"type":"ORCID","value":"0009-0007-5764-1211"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Humane Technology Laboratory, Catholic University of the Sacred Heart, Milan, Italy."},{"affiliation":"Department of Computer Science, University of Pisa, Pisa, Italy."}]}},{"fullName":"Rossi C","firstName":"Chiara","lastName":"Rossi","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Humane Technology Laboratory, Catholic University of the Sacred Heart, Milan, Italy."},{"affiliation":"Department of Human Sciences, Guglielmo Marconi University, Rome, Italy."}]}},{"fullName":"Riva G","firstName":"Giuseppe","lastName":"Riva","initials":"G","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Humane Technology Laboratory, Catholic University of the Sacred Heart, Milan, Italy."},{"affiliation":"Applied Technology for Neuro-Psychology Laboratory, IRCCS Istituto Auxologico Italiano, Milan, Italy."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-1766-831X"},{"type":"ORCID","value":"0009-0007-5764-1211"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"14","journalIssueId":4110762,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Frontiers in public health","medlineAbbreviation":"Front Public Health","isoabbreviation":"Front Public Health","nlmid":"101616579","essn":"2296-2565","issn":"2296-2565"}},"pubYear":"2026","pageInfo":"1603238","abstractText":"The integration of conversational agents (CAs) into mental health care presents a promising yet complex frontier. These systems have demonstrated potential in expanding access, enhancing user engagement and providing scalable support, particularly in contexts where human clinicians are unavailable. Despite these advantages, CAs face two fundamental limitations: their quality of interaction and the ability to facilitate self-reflection. This perspective article provides a theoretical framework with clinical relevance, identifying the critical challenges that must be addressed to transition Generative Artificial Intelligence (GenAI) from a conversational tool to an adjunctive psychological support. Firstly, personalization is essential. Advances in retrieval-augmented generation (RAG), fine-tuning, and emotional reasoning are necessary to enable context-aware and ethically grounded responses tailored to individual users. In addition, multimodal interaction (particularly through improvements in speech synthesis, prosody, and expressive dialogue) can help bridge the gap between human and AI communication, fostering greater emotional resonance and natural flow. Lastly, immersive environments, including embodied CA and virtual reality settings, may amplify presence, potentially engaging neural and psychological mechanisms typically associated with human-to-human interaction. These innovations must be accompanied by a strong ethical and regulatory foundation. Systems must ensure transparency, informed consent, and compliance with data privacy standards such as GDPR and HIPAA. Crucially, AI should not be viewed as a replacement for psychologists, but as an adaptive and supportive layer within a broader care ecosystem. By aligning technological capabilities with clinical intent, the future of GenAI in mental health may lie in its ability to complement human expertise and meaningfully extend psychological support.","affiliation":"Humane Technology Laboratory, Catholic University of the Sacred Heart, Milan, Italy.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["brief-report","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Communication"},{"majorTopic_YN":"Y","descriptorName":"Mental Health"},{"majorTopic_YN":"Y","descriptorName":"Artificial Intelligence"},{"majorTopic_YN":"Y","descriptorName":"Generative Artificial Intelligence"}]},"keywordList":{"keyword":["Virtual reality","Mental health","Psychological Support","General Psychology","Clinical Psychology","Generative Artificial Intelligence"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/fpubh.2026.1603238"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13054807"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13054807?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":2,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-07-14","dateOfCreation":"2026-04-09","firstIndexDate":"2026-04-10","fullTextReceivedDate":"2026-04-08","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-03-24","firstPublicationDate":"2026-03-24"},{"id":"41897273","source":"MED","pmid":"41897273","pmcid":"PMC13026511","fullTextIdList":{"fullTextId":["PMC13026511"]},"doi":"10.3390/healthcare14060820","title":"From Tool to Agent: A Semi-Systematic Review of Human-AI Alignment and a Proposed Tiered Healing Ecosystem for Mental Health.","authorString":"Ma A, Chen J, Yang Z.","authorList":{"author":[{"fullName":"Ma A","firstName":"Anran","lastName":"Ma","initials":"A","authorId":{"type":"ORCID","value":"0009-0009-4552-440X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"National Engineering Research Center for E-Learning, Faculty of Artificial Intelligence in Education, Central China Normal University, Wuhan 430079, China."}]}},{"fullName":"Chen J","firstName":"Jingying","lastName":"Chen","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"National Engineering Research Center for E-Learning, Faculty of Artificial Intelligence in Education, Central China Normal University, Wuhan 430079, China."}]}},{"fullName":"Yang Z","firstName":"Zhiyi","lastName":"Yang","initials":"Z","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"National Engineering Research Center for E-Learning, Faculty of Artificial Intelligence in Education, Central China Normal University, Wuhan 430079, China."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0009-0009-4552-440X"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"6","volume":"14","journalIssueId":4161913,"dateOfPublication":"2026 Mar","monthOfPublication":3,"yearOfPublication":2026,"printPublicationDate":"2026-03-01","journal":{"title":"Healthcare (Basel, Switzerland)","medlineAbbreviation":"Healthcare (Basel)","isoabbreviation":"Healthcare (Basel)","nlmid":"101666525","essn":"2227-9032","issn":"2227-9032"}},"pubYear":"2026","pageInfo":"820","abstractText":"<b>Background</b>: This study aims to systematically analyze the structural transition of AI in mental health, differentiating between passive tools and autonomous agents, and to propose a governance framework to facilitate responsible integration or mitigate integration risks. <b>Methods</b>: Employing a semi-systematic approach, we screened records from IEEE Xplore, PubMed, and ACM DL, ultimately analyzing 61 included studies. We track the transition from the first paradigm, AI-as-Tool (AI-T) to the second paradigm, AI-as-Agent (AI-A). <b>Results</b>: Early empirical evidence suggests that AI-A systems may assist in fostering preliminary working alliances and demonstrate potential for symptom reduction in controlled settings; however, their efficacy cannot currently be equated with, nor serve as a replacement for, standard low-intensity clinical care. <b>Conclusions</b>: To mitigate these risks, we propose the Tiered Human-AI Healing Ecosystem (THHE) for mental health. This framework utilizes dynamic autonomy modulation-automatically restricting AI agency based on real-time risk markers-to manage transitions between AI-led support and human-led care, promoting clinical safety.","affiliation":"National Engineering Research Center for E-Learning, Faculty of Artificial Intelligence in Education, Central China Normal University, Wuhan 430079, China.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"grantsList":{"grant":[{"grantId":"62377018","agency":"National Natural Science Foundation of China","orderIn":0}]},"keywordList":{"keyword":["Therapeutic Alliance","Paradigm Shift","Artificial Intelligence In Mental Health","Ai Agents And Large Language Models","Human–Ai Alignment","Tiered Human–Ai Healing Ecosystem (Thhe)"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3390/healthcare14060820"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13026511"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13026511?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-03-28","dateOfCreation":"2026-03-28","firstIndexDate":"2026-03-29","fullTextReceivedDate":"2026-03-28","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-03-23","firstPublicationDate":"2026-03-23"},{"id":"42100219","source":"MED","pmid":"42100219","pmcid":"PMC13143618","fullTextIdList":{"fullTextId":["PMC13143618"]},"doi":"10.3389/fvets.2026.1801756","title":"Curriculum framework for artificial intelligence literacy in veterinary education.","authorString":"Huang YT, Chu CP.","authorList":{"author":[{"fullName":"Huang YT","firstName":"Yi-Ting","lastName":"Huang","initials":"YT","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Veterinary Pathobiology, College of Veterinary Medicine & Biomedical Sciences, Texas A&M University, College Station, TX, United States."}]}},{"fullName":"Chu CP","firstName":"Candice P","lastName":"Chu","initials":"CP","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Veterinary Pathobiology, College of Veterinary Medicine & Biomedical Sciences, Texas A&M University, College Station, TX, United States."}]}}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics"]},"journalInfo":{"volume":"13","journalIssueId":4116564,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Frontiers in veterinary science","medlineAbbreviation":"Front Vet Sci","isoabbreviation":"Front Vet Sci","nlmid":"101666658","essn":"2297-1769","issn":"2297-1769"}},"pubYear":"2026","pageInfo":"1801756","abstractText":"Artificial intelligence (AI) is a rapidly evolving technology increasingly incorporated into veterinary medicine. Given the demand for AI integration and the accountability placed on licensed veterinarians for AI-assisted medical decisions, there is an urgent need to integrate AI literacy into the Doctor of Veterinary Medicine (DVM) curriculum in the United States. Here, we proposed five core modules for a comprehensive AI literacy curriculum for DVM students that can serve as a foundation for institution-specific course development. We also urge institutions to provide the resources outlined in this article to facilitate the development of AI literacy courses in veterinary schools.","affiliation":"Department of Veterinary Pathobiology, College of Veterinary Medicine & Biomedical Sciences, Texas A&M University, College Station, TX, United States.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["brief-report","Journal Article"]},"keywordList":{"keyword":["Artificial intelligence","AI","Machine Learning","Veterinary Student","Veterinary Curriculum","Ai Literacy","Large Language Model","Dvm Education"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/fvets.2026.1801756"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13143618"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13143618?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":1,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-05-08","dateOfCreation":"2026-05-08","firstIndexDate":"2026-05-13","fullTextReceivedDate":"2026-05-20","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-04-22","firstPublicationDate":"2026-04-22"},{"id":"42348542","source":"MED","pmid":"42348542","pmcid":"PMC13298971","fullTextIdList":{"fullTextId":["PMC13298971"]},"doi":"10.1371/journal.pdig.0001446","title":"Feasibility and user evaluation of HopeBot: An LLM-powered conversational chatbot for depression screening.","authorString":"Guo Z, Lai A, Ive J, Petcu A, Wang Y, Qi L, Thygesen JH, Li K.","authorList":{"author":[{"fullName":"Guo Z","firstName":"Zhijun","lastName":"Guo","initials":"Z","authorId":{"type":"ORCID","value":"0009-0006-1901-5191"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute of Health Informatics University College, London, London, United Kingdom."}]}},{"fullName":"Lai A","firstName":"Alvina","lastName":"Lai","initials":"A","authorId":{"type":"ORCID","value":"0000-0001-8960-8095"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute of Health Informatics University College, London, London, United Kingdom."}]}},{"fullName":"Ive J","firstName":"Julia","lastName":"Ive","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute of Health Informatics University College, London, London, United Kingdom."}]}},{"fullName":"Petcu A","firstName":"Alexandru","lastName":"Petcu","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Lancashire & South Cumbria NHS Foundation Trust, Bamber Bridge, ‌United Kingdom."}]}},{"fullName":"Wang Y","firstName":"Yutong","lastName":"Wang","initials":"Y","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute of Health Informatics University College, London, London, United Kingdom."}]}},{"fullName":"Qi L","firstName":"Luyuan","lastName":"Qi","initials":"L","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute of Health Informatics University College, London, London, United Kingdom."}]}},{"fullName":"Thygesen JH","firstName":"Johan H","lastName":"Thygesen","initials":"JH","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute of Health Informatics University College, London, London, United Kingdom."}]}},{"fullName":"Li K","firstName":"Kezhi","lastName":"Li","initials":"K","authorId":{"type":"ORCID","value":"0000-0003-3073-3128"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute of Health Informatics University College, London, London, United Kingdom."},{"affiliation":"University College London Hospital NHS Foundation Trust, London, United Kingdom."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-8960-8095"},{"type":"ORCID","value":"0000-0003-3073-3128"},{"type":"ORCID","value":"0009-0006-1901-5191"}]},"journalInfo":{"issue":"6","volume":"5","journalIssueId":4204541,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"printPublicationDate":"2026-06-01","journal":{"title":"PLOS digital health","medlineAbbreviation":"PLOS Digit Health","isoabbreviation":"PLOS Digit Health","nlmid":"9918335064206676","essn":"2767-3170","issn":"2767-3170"}},"pubYear":"2026","pageInfo":"e0001446","abstractText":"Clinician-administered Patient Health Questionnaire-9 (PHQ-9) interviews allow clarification of ambiguous responses but are resource-intensive and difficult to scale for routine use. Self-administered versions are widely adopted for depression screening yet offer little opportunity for interaction or clarification, which may limit engagement and scoring accuracy. We developed HopeBot, a conversational chatbot powered by a large language model (LLM) that delivers the PHQ-9 via text or voice, providing real-time clarification and safety guidance through a retrieval-augmented generation (RAG) layer drawing on validated psychological and helpline resources. The system aims to extend access to structured screening rather than replace clinician judgment. In a within-subject feasibility study, 132 adults from two countries completed both self-administered and chatbot-assisted PHQ-9 assessments followed by a 25-item evaluation survey. Chatbot and self-report scores showed high concordance (intraclass correlation coefficient = 0.92; median absolute difference = 1 point), indicating faithful replication of scoring. Of these participants, 75 completed a comparative feedback module (most with identical scores were not prompted for comparison); 71% (n = 53) reported greater confidence in chatbot-assisted scores, citing clearer structure, interpretive guidance, and a supportive tone. Mean usability ratings (0-10) were 8.4 for comfort, 7.7 for voice clarity, 7.6 for handling sensitive topics, and 7.4 for recommendation helpfulness; the latter varied significantly by employment status and prior experience with mental-health services. The self-administered PHQ-9 served as a pragmatic comparator reflecting real-world digital screening, allowing evaluation of whether the chatbot could faithfully reproduce the questionnaire's structure and scoring accuracy rather than diagnostic validity. These findings indicate that an LLM-powered conversational agent with RAG-based grounding can feasibly and acceptably administer the PHQ-9 with strong score concordance relative to self-report, suggesting potential as a scalable adjunct for early, low-burden depression screening. Further validation against clinician-administered assessments in real-world workflows is warranted. Trial registration ClinicalTrials.gov Identifier NCT06801925.","affiliation":"Institute of Health Informatics University College, London, London, United Kingdom.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["research-article","Journal Article"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1371/journal.pdig.0001446"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13298971"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13298971?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"N","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-06-25","dateOfCreation":"2026-06-25","firstIndexDate":"2026-06-26","fullTextReceivedDate":"2026-06-27","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-25","firstPublicationDate":"2026-06-25"},{"id":"42271527","source":"MED","pmid":"42271527","doi":"10.1186/s41077-026-00448-5","title":"AI integration in healthcare simulation debriefing: support or substitute?","authorString":"Stocks L, Place M, Brazil V, Kainth R, Lowe B, Khan I, Kumar P.","authorList":{"author":[{"fullName":"Stocks L","firstName":"Lucy","lastName":"Stocks","initials":"L","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medical Education, NHS Lanarkshire, Bothwell, Scotland, UK. Lucy.Stocks@lanarkshire.scot.nhs.uk."},{"affiliation":"School of Medicine, Dentistry & Nursing, University of Glasgow, Glasgow, Scotland, UK. Lucy.Stocks@lanarkshire.scot.nhs.uk."}]}},{"fullName":"Place M","firstName":"Marc","lastName":"Place","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Anaesthesia, NHS Forth Valley, Larber, Scotland, UK."}]}},{"fullName":"Brazil V","firstName":"Victoria","lastName":"Brazil","initials":"V","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Health Sciences and Medicine, Bond University, Gold Coast, Australia."}]}},{"fullName":"Kainth R","firstName":"Ranjev","lastName":"Kainth","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Life Sciences and Medicine, King's College London, London, UK."}]}},{"fullName":"Lowe B","firstName":"Belinda","lastName":"Lowe","initials":"B","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Health Sciences and Medicine, Bond University, Gold Coast, Australia."},{"affiliation":"Gold Coast Hospital Health Service, Gold Coast, Australia."}]}},{"fullName":"Khan I","firstName":"Ibraaheem","lastName":"Khan","initials":"I","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Anaesthesia, NHS Greater Glasgow & Clyde, Glasgow, Scotland, UK."}]}},{"fullName":"Kumar P","firstName":"Prashant","lastName":"Kumar","initials":"P","authorId":{"type":"ORCID","value":"0000-0002-8745-2151"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Medicine, Dentistry & Nursing, University of Glasgow, Glasgow, Scotland, UK."},{"affiliation":"Department of Anaesthesia, NHS Greater Glasgow & Clyde, Glasgow, Scotland, UK."},{"affiliation":"School of Medicine, University of Dundee, Dundee, Scotland, UK."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-8745-2151"}]},"journalInfo":{"journalIssueId":4209501,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"printPublicationDate":"2026-06-01","journal":{"title":"Advances in simulation (London, England)","medlineAbbreviation":"Adv Simul (Lond)","isoabbreviation":"Adv Simul (Lond)","nlmid":"101700425","essn":"2059-0628","issn":"2059-0628"}},"pubYear":"2026","abstractText":"Debriefing is widely recognised as a central mechanism for learning within healthcare simulation, enabling learners to reflect on clinical actions, decision-making, and team interactions. However, high-quality debriefing is resource-intensive, dependent on facilitator expertise, and increasingly challenged by the growing complexity and volume of data generated during modern simulation activities. Artificial intelligence (AI) offers emerging opportunities to augment aspects of debriefing by analysing performance data, structuring reflective dialogue, and supporting learning environments. This article explores the emerging role of AI within debriefing. Drawing on the current literature, we describe four modes of AI being integrated into debriefing practice: metric-based AI tutors, large language model-assisted debriefing tools, conversational chatbot debriefers and hybrid integrated AI systems. For each mode, we examine their underlying mechanisms, current applications, and current contributions to, and limitations within, debriefing. Using these four modes as a scaffold, we offer practical guidance for simulation practitioners considering the integration of AI tools within their own practice, including considerations related to faculty AI literacy, educational alignment, governance, and implementation. While the empirical evidence base is evolving, AI-driven approaches offer new ways of supporting facilitators in augmenting reflective practice. When implemented thoughtfully and with appropriate human oversight, the integration of AI into debriefing portends a new era supporting reflective learning within healthcare simulation.","affiliation":"Department of Medical Education, NHS Lanarkshire, Bothwell, Scotland, UK. Lucy.Stocks@lanarkshire.scot.nhs.uk.","publicationStatus":"aheadofprint","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Journal Article"]},"keywordList":{"keyword":["Simulation","Learning","Artificial intelligence","AI","Debriefing","Reflection","Generative Ai","Large Language Models","Llms"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1186/s41077-026-00448-5"}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"N","hasReferences":"N","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCreation":"2026-06-11","firstIndexDate":"2026-06-11","dateOfRevision":"2026-06-11","electronicPublicationDate":"2026-06-10","firstPublicationDate":"2026-06-10"},{"id":"42284599","source":"MED","pmid":"42284599","pmcid":"PMC13263014","fullTextIdList":{"fullTextId":["PMC13263014"]},"doi":"10.2196/84296","title":"Breaking Barriers in Student Mental Health Care With AI-Enhanced Group Cognitive Behavioral Therapy: Pilot Feasibility Study.","authorString":"Tulbure BT, Spătaru B, Rusu A, Faur D, Precupaș D, Trancă LM, Popa ȘG, Spătaru A.","authorList":{"author":[{"fullName":"Tulbure BT","firstName":"Bogdan Tudor","lastName":"Tulbure","initials":"BT","authorId":{"type":"ORCID","value":"0000-0001-8101-1753"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychology, West University of Timisoara, 4 Vasile Parvan Bvd, Timisoara, 300223, Romania, 40 745-753-061."}]}},{"fullName":"Spătaru B","firstName":"Bianca","lastName":"Spătaru","initials":"B","authorId":{"type":"ORCID","value":"0000-0003-4039-385X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Institute for Advanced Environmental Research, West University of Timisoara, Timisoara, Romania."}]}},{"fullName":"Rusu A","firstName":"Andrei","lastName":"Rusu","initials":"A","authorId":{"type":"ORCID","value":"0000-0003-0036-4149"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychology, West University of Timisoara, 4 Vasile Parvan Bvd, Timisoara, 300223, Romania, 40 745-753-061."}]}},{"fullName":"Faur D","firstName":"Darian","lastName":"Faur","initials":"D","authorId":{"type":"ORCID","value":"0000-0002-7086-9444"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychology, West University of Timisoara, 4 Vasile Parvan Bvd, Timisoara, 300223, Romania, 40 745-753-061."}]}},{"fullName":"Precupaș D","firstName":"Daniel","lastName":"Precupaș","initials":"D","authorId":{"type":"ORCID","value":"0009-0006-6995-9932"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Computer Science, West University of Timisoara, Timisoara, Romania."}]}},{"fullName":"Trancă LM","firstName":"Loredana Marcela","lastName":"Trancă","initials":"LM","authorId":{"type":"ORCID","value":"0000-0003-4560-0571"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Social Work, West University of Timisoara, Timisoara, Romania."}]}},{"fullName":"Popa ȘG","firstName":"Șerban Gabriel","lastName":"Popa","initials":"ȘG","authorId":{"type":"ORCID","value":"0009-0005-4816-3372"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychology, West University of Timisoara, 4 Vasile Parvan Bvd, Timisoara, 300223, Romania, 40 745-753-061."}]}},{"fullName":"Spătaru A","firstName":"Adrian","lastName":"Spătaru","initials":"A","authorId":{"type":"ORCID","value":"0000-0002-0702-6276"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Computer Science, West University of Timisoara, Timisoara, Romania."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-8101-1753"},{"type":"ORCID","value":"0000-0002-0702-6276"},{"type":"ORCID","value":"0000-0002-7086-9444"},{"type":"ORCID","value":"0000-0003-0036-4149"},{"type":"ORCID","value":"0000-0003-4039-385X"},{"type":"ORCID","value":"0000-0003-4560-0571"},{"type":"ORCID","value":"0009-0005-4816-3372"},{"type":"ORCID","value":"0009-0006-6995-9932"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"10","journalIssueId":4204625,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"printPublicationDate":"2026-06-01","journal":{"title":"JMIR formative research","medlineAbbreviation":"JMIR Form Res","isoabbreviation":"JMIR Form Res","nlmid":"101726394","essn":"2561-326X","issn":"2561-326X"}},"pubYear":"2026","pageInfo":"e84296","abstractText":"<h4>Background</h4>University students experience elevated psychological distress, with limited access to mental health services. While cognitive behavioral therapy (CBT) demonstrates efficacy for anxiety and depression, treatment gaps persist due to access barriers and insufficient between-session support. Large language model (LLM) chatbots could improve and scale CBT delivery. However, the scientific evaluation of chatbot-enhanced protocols is just emerging.<h4>Objective</h4>This pilot study aimed to assess the feasibility, acceptability, and preliminary efficacy of an LLM-based ChatBot as an adjunct to group Unified Protocol (UP) therapy for between-session support in university students with subclinical anxiety and depression symptoms.<h4>Methods</h4>A single-arm feasibility trial recruited university students aged 18 years and older with moderate subclinical symptoms (Social Phobia Inventory: 21-40, Patient Health Questionnaire-9: 5-14, or Generalized Anxiety Disorder-7: 5-14), excluding those with current psychiatric disorders, suicidal ideation, or psychotropic medication use. The intervention comprised 4 weekly group UP counseling sessions complemented by an adjunctive Claude 3.7-Sonnet LLM ChatBot programmed with UP-based therapeutic prompts for between-session support rather than a stand-alone therapeutic agent. Primary feasibility outcomes included treatment adherence, chatbot engagement metrics, and system usability (System Usability Scale). Secondary outcomes assessed changes in generalized anxiety (Generalized Anxiety Disorder-7 Scale), social anxiety (Social Phobia Inventory), depression (Patient Health Questionnaire-9), and well-being (Short Warwick-Edinburgh Mental Wellbeing Scale) using paired t tests. Qualitative feedback was collected through focus group interviews and analyzed using thematic analysis.<h4>Results</h4>Of 72 screened participants, 37 met eligibility criteria and 19 initiated treatment (mean age 22.06, SD 1.78 years; 70.6% female). Retention was high with 17 completers (10.5% dropout rate). Among completers, 94.1% (16/17) attended ≥3 group sessions. The engagement with the CBT ChatBot was substantial: participants were active on a median of 23 days during the 34-day study period and exchanged a median of 15 messages in total. System usability was rated as excellent (mean 84.94, SD 10.98 out of 100). Pre-to-post comparisons revealed significant improvements in generalized anxiety (mean change -3.00, SD 3.46; t16=3.01, P=.004; Cohen d=0.71) and mental well-being (mean change +2.29, SD 3.65; t16=-2.17, P=.02; Cohen d=0.69). Social anxiety and depression showed nonsignificant trends toward improvement. Qualitative feedback highlighted the CBT ChatBot's accessibility and nonjudgmental support while noting limitations in personalization. No adverse events or inappropriate chatbot interactions occurred.<h4>Conclusions</h4>Augmenting a group UP therapy with an LLM ChatBot demonstrated high feasibility, acceptability, and preliminary efficacy signals for university students with subclinical symptoms. The hybrid intervention package achieved strong retention and engagement while maintaining safety. These findings support progression to a randomized controlled trial to definitively evaluate this technology-enhanced approach for expanding access to evidence-based mental health interventions.","affiliation":"Department of Psychology, West University of Timisoara, 4 Vasile Parvan Bvd, Timisoara, 300223, Romania, 40 745-753-061.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Feasibility Studies"},{"majorTopic_YN":"N","descriptorName":"Pilot Projects"},{"majorTopic_YN":"Y","descriptorName":"Mental Health Services","meshQualifierList":{"meshQualifier":[{"abbreviation":"SN","qualifierName":"statistics & numerical data","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Psychotherapy, Group","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Students","meshQualifierList":{"meshQualifier":[{"abbreviation":"PX","qualifierName":"psychology","majorTopic_YN":"N"},{"abbreviation":"SN","qualifierName":"statistics & numerical data","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Universities","meshQualifierList":{"meshQualifier":[{"abbreviation":"OG","qualifierName":"organization & administration","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Female"},{"majorTopic_YN":"N","descriptorName":"Male"},{"majorTopic_YN":"N","descriptorName":"Young Adult"},{"majorTopic_YN":"N","descriptorName":"Surveys and Questionnaires"},{"majorTopic_YN":"Y","descriptorName":"Cognitive Behavioral Therapy","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"},{"abbreviation":"ST","qualifierName":"standards","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Mental Health Teletherapy"},{"majorTopic_YN":"N","descriptorName":"Large Language Models"}]},"keywordList":{"keyword":["Artificial intelligence","Cognitive Behavioral Therapy","university students","Transdiagnostic","Chatbots","Large Language Models"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/84296"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13263014"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13263014?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-06-14","dateOfCreation":"2026-06-12","firstIndexDate":"2026-06-13","fullTextReceivedDate":"2026-06-13","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-12","firstPublicationDate":"2026-06-12"},{"id":"41202205","source":"MED","pmid":"41202205","pmcid":"PMC12594504","fullTextIdList":{"fullTextId":["PMC12594504"]},"doi":"10.2196/75078","title":"A Prompt Engineering Framework for Large Language Model-Based Mental Health Chatbots: Conceptual Framework.","authorString":"Boit S, Patil R.","authorList":{"author":[{"fullName":"Boit S","firstName":"Sorio","lastName":"Boit","initials":"S","authorId":{"type":"ORCID","value":"0009-0003-1833-4068"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Computer Science, College of Computing, Grand Valley State University, 1 Campus Dr, Allendale, MI, 49401, United States, 1 616-331-4375."}]}},{"fullName":"Patil R","firstName":"Rajvardhan","lastName":"Patil","initials":"R","authorId":{"type":"ORCID","value":"0000-0002-6944-4692"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Computer Science, College of Computing, Grand Valley State University, 1 Campus Dr, Allendale, MI, 49401, United States, 1 616-331-4375."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-6944-4692"},{"type":"ORCID","value":"0009-0003-1833-4068"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"12","journalIssueId":4041540,"dateOfPublication":"2025 Nov","monthOfPublication":11,"yearOfPublication":2025,"printPublicationDate":"2025-11-01","journal":{"title":"JMIR mental health","medlineAbbreviation":"JMIR Ment Health","isoabbreviation":"JMIR Ment Health","nlmid":"101658926","essn":"2368-7959","issn":"2368-7959"}},"pubYear":"2025","pageInfo":"e75078","abstractText":"<h4>Background</h4>Artificial intelligence (AI), particularly large language models (LLMs), presents a significant opportunity to transform mental health care through scalable, on-demand support. While LLM-powered chatbots may help reduce barriers to care, their integration into clinical settings raises critical concerns regarding safety, reliability, and ethical oversight. A structured framework is needed to capture their benefits while addressing inherent risks. This paper introduces a conceptual model for prompt engineering, outlining core design principles for the responsible development of LLM-based mental health chatbots.<h4>Objective</h4>This paper proposes the Mental Well-Being Through Dialogue - Safeguarded and Adaptive Framework for Ethics (MIND-SAFE), a comprehensive, layered framework for prompt engineering that integrates evidence-based therapeutic models, adaptive technology, and ethical safeguards. The objective is to propose and outline a practical foundation for developing AI-driven mental health interventions that are safe, effective, and clinically relevant.<h4>Methods</h4>We outline a layered architecture for an LLM-based mental health chatbot. The design incorporates (1) an input layer with proactive risk detection; (2) a dialogue engine featuring a user state database for personalization and retrieval-augmented generation to ground responses in evidence-based therapies such as cognitive behavioral therapy, acceptance and commitment therapy, and dialectical behavior therapy; and (3) a multitiered safety system, including a postgeneration ethical filter and a continuous learning loop with therapist oversight.<h4>Results</h4>The primary contribution is the framework itself, which systematically embeds clinical principles and ethical safeguards into system design. We also propose a comparative validation strategy to evaluate the framework's added value against a baseline model. Its components are explicitly mapped to the Framework for AI Tool Assessment in Mental Health and Readiness Evaluation for AI-Mental Health Deployment and Implementation frameworks, ensuring alignment with current scholarly standards for responsible AI development.<h4>Conclusions</h4>The framework offers a practical foundation for the responsible development of LLM-based mental health support. By outlining a layered architecture and aligning it with established evaluation standards, this work offers guidance for developing AI tools that are technically capable, safe, effective, and ethically sound. Future research should prioritize empirical validation of the framework through the phased, comparative approach introduced in this paper.","affiliation":"Department of Computer Science, College of Computing, Grand Valley State University, 1 Campus Dr, Allendale, MI, 49401, United States, 1 616-331-4375.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Language"},{"majorTopic_YN":"Y","descriptorName":"Mental Health"},{"majorTopic_YN":"Y","descriptorName":"Mental Health Services"},{"majorTopic_YN":"N","descriptorName":"Telemedicine"},{"majorTopic_YN":"Y","descriptorName":"Artificial Intelligence"},{"majorTopic_YN":"N","descriptorName":"Generative Artificial Intelligence"},{"majorTopic_YN":"N","descriptorName":"Large Language Models"}]},"keywordList":{"keyword":["Artificial intelligence","Digital Mental Health","Conversational Ai","Ethical Ai","Prompt Engineering","Large Language Model","Ai In Mental Health Care","Mind-safe Framework","Mental Health Chatbot"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/75078"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12594504"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12594504?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":3,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2025-11-07","dateOfCreation":"2025-11-07","firstIndexDate":"2025-11-07","fullTextReceivedDate":"2025-12-04","dateOfRevision":"2025-11-12","electronicPublicationDate":"2025-11-07","firstPublicationDate":"2025-11-07"},{"id":"41948698","source":"MED","pmid":"41948698","pmcid":"PMC13050895","fullTextIdList":{"fullTextId":["PMC13050895"]},"doi":"10.3389/frai.2026.1750978","title":"Navigating opportunities and challenges of generative AI in higher education: towards responsible, equitable, and human-centered integration.","authorString":"Coman C, Gherheș V, Bucs A, Coman E, Victoria-Rodica C, Bódi DC, Șerbănescu RM.","authorList":{"author":[{"fullName":"Coman C","firstName":"Claudiu","lastName":"Coman","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Sociology and Communication, Transylvania University of Brasov, Brașov, Romania."},{"affiliation":"The Academy of Romanian Scientists, Bucharest, Romania."}]}},{"fullName":"Gherheș V","firstName":"Vasile","lastName":"Gherheș","initials":"V","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Communication and Foreign Languages, Politehnica University of Timisoara, Timisoara, Romania."}]}},{"fullName":"Bucs A","firstName":"Anna","lastName":"Bucs","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Sociology and Social Sciences, University of Craiova, Craiova, Romania."}]}},{"fullName":"Coman E","firstName":"Ecaterina","lastName":"Coman","initials":"E","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Economics and Business Administration, Transylvania University of Brasov, Brașov, Romania."}]}},{"fullName":"Victoria-Rodica C","firstName":"Cioca","lastName":"Victoria-Rodica","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Psychology and Educational Sciences, Babeș-Bolyai University, Calea Moților, Cluj-Napoca, Romania."}]}},{"fullName":"Bódi DC","firstName":"Diana-Cristina","lastName":"Bódi","initials":"DC","authorId":{"type":"ORCID","value":"0009-0007-1178-2510"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Sociology and Communication, Transylvania University of Brasov, Brașov, Romania."},{"affiliation":"The Academy of Romanian Scientists, Bucharest, Romania."}]}},{"fullName":"Șerbănescu RM","firstName":"Raluca-Maria","lastName":"Șerbănescu","initials":"RM","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Sociology and Communication, Transylvania University of Brasov, Brașov, Romania."},{"affiliation":"The Academy of Romanian Scientists, Bucharest, Romania."},{"affiliation":"Faculty of Economics and Business Administration, Transylvania University of Brasov, Brașov, Romania."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0009-0002-0847-0181"},{"type":"ORCID","value":"0009-0007-1178-2510"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"volume":"9","journalIssueId":4117457,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Frontiers in artificial intelligence","medlineAbbreviation":"Front Artif Intell","isoabbreviation":"Front Artif Intell","nlmid":"101770551","essn":"2624-8212","issn":"2624-8212"}},"pubYear":"2026","pageInfo":"1750978","abstractText":"The rapid emergence of generative AI (GenAI) tools, such as ChatGPT, presents transformative potential for higher education (HE) while also raising significant ethical, pedagogical, and policy- related concerns. This systematic and thematic review, based on 46 documents from the Web of Science (WoS), narrows its qualitative analysis to 27 peer-reviewed articles to explore key trends in implementation. Findings highlight GenAI's benefits in improving personalized learning, self-regulated strategies, and adaptive feedback. However, critical issues persist, particularly regarding academic integrity, data privacy, equity, and responsible governance. Core themes include AI literacy, technology acceptance, ethical oversight, and the imperative for culturally responsive integration. The study underscores the need for stakeholder collaboration to ensure the ethical and effective integration of GenAI in education. When applied thoughtfully, GenAI holds significant promise in reshaping educational practices while safeguarding fundamental academic values.","affiliation":"Faculty of Sociology and Communication, Transylvania University of Brasov, Brașov, Romania.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["research-article","Journal Article"]},"keywordList":{"keyword":["Regulations","Higher Education","Policies","Academic Integrity","Ai Literacy","Regulatory Gaps","Human-Centered Ai","Genai"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/frai.2026.1750978"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13050895"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13050895?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":2,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-04-08","dateOfCreation":"2026-04-08","firstIndexDate":"2026-04-08","fullTextReceivedDate":"2026-04-07","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-03-23","firstPublicationDate":"2026-03-23"},{"id":"41536114","source":"MED","pmid":"41536114","pmcid":"PMC12805049","fullTextIdList":{"fullTextId":["PMC12805049"]},"doi":"10.1002/wps.70017","title":"Do generative AI chatbots increase psychosis risk?","authorString":"Keshavan M, Torous J, Yassin W.","authorList":{"author":[{"fullName":"Keshavan M","firstName":"Matcheri","lastName":"Keshavan","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Beth Israel Deaconess Medical Center and Harvard Medical School, Boston, MA, USA."}]}},{"fullName":"Torous J","firstName":"John","lastName":"Torous","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Beth Israel Deaconess Medical Center and Harvard Medical School, Boston, MA, USA."}]}},{"fullName":"Yassin W","firstName":"Walid","lastName":"Yassin","initials":"W","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Beth Israel Deaconess Medical Center and Harvard Medical School, Boston, MA, USA."}]}}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics"]},"journalInfo":{"issue":"1","volume":"25","journalIssueId":4092317,"dateOfPublication":"2026 Feb","monthOfPublication":2,"yearOfPublication":2026,"printPublicationDate":"2026-02-01","journal":{"title":"World psychiatry : official journal of the World Psychiatric Association (WPA)","medlineAbbreviation":"World Psychiatry","isoabbreviation":"World Psychiatry","nlmid":"101189643","essn":"2051-5545","issn":"1723-8617"}},"pubYear":"2026","pageInfo":"150-151","affiliation":"Beth Israel Deaconess Medical Center and Harvard Medical School, Boston, MA, USA.","publicationStatus":"ppublish","language":"eng","pubModel":"Print","pubTypeList":{"pubType":["Letter"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1002/wps.70017"},{"availability":"Free","availabilityCode":"F","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12805049"},{"availability":"Free","availabilityCode":"F","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12805049?pdf=render"},{"availability":"Free","availabilityCode":"F","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1002/wps.70017"}]},"isOpenAccess":"N","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":6,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-01-15","dateOfCreation":"2026-01-15","firstIndexDate":"2026-01-15","fullTextReceivedDate":"2026-01-22","dateOfRevision":"2026-01-18","firstPublicationDate":"2026-02-01"},{"id":"41606555","source":"MED","pmid":"41606555","pmcid":"PMC12924558","fullTextIdList":{"fullTextId":["PMC12924558"]},"doi":"10.1186/s12889-025-26148-9","title":"Generative AI and health misinformation: production, propagation, and mitigation-a systematic review.","authorString":"Saeidnia HR, Jahani S, Ghiasi N, Keshavarz H.","authorList":{"author":[{"fullName":"Saeidnia HR","firstName":"Hamid Reza","lastName":"Saeidnia","initials":"HR","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Knowledge and Information Science, Tarbiat Modares University, (TMU), Tehran, Iran."}]}},{"fullName":"Jahani S","firstName":"Shamim","lastName":"Jahani","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Research Committee, Babol University of Medical Sciences, Babol, Iran."}]}},{"fullName":"Ghiasi N","firstName":"Nasrin","lastName":"Ghiasi","initials":"N","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Public Health, School of Health, Ilam University of Medical Sciences, Ilam, Iran. ghnazi93@gmail.com."}]}},{"fullName":"Keshavarz H","firstName":"Hamid","lastName":"Keshavarz","initials":"H","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Knowledge and Information Science, Shahid Beheshti University, Tehran, Iran."}]}}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"1","volume":"26","journalIssueId":4082921,"dateOfPublication":"2026 Jan","monthOfPublication":1,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"BMC public health","medlineAbbreviation":"BMC Public Health","isoabbreviation":"BMC Public Health","nlmid":"100968562","essn":"1471-2458","issn":"1471-2458"}},"pubYear":"2026","pageInfo":"693","abstractText":"<h4>Background</h4>Generative artificial intelligence technologies have disrupted information ecosystems, posing new threats to public health by enabling rapid, scalable manufacture of convincing but false health stories. This systematic review synthesizes evidence on how generative AI reconfigures health misinformation creation, dissemination, and moderation.<h4>Methods</h4>In line with PRISMA 2020, 15 empirical studies published between January 2023 and August 2025 were included. Databases consulted were MEDLINE (via PubMed), Embase, Scopus, Web of Science Core Collection, ACM Digital Library, IEEE Xplore, PsycINFO, Communication & Mass Media Complete, arXiv, and medRxiv/SSRN. Studies were contrasted on the basis of production capacity, propagation dynamics, and efficacy of mitigation at technical, sociotechnical, and governance layers.<h4>Results</h4>The synthesis indicates that generative AI substantially increases the volume, speed, and perceived credibility of health disinformation production, while altering its propagation dynamics. Users often struggle to distinguish AI‑generated from human‑authored health misinformation, and their sharing intentions are not tightly coupled with perceived accuracy. Existing detection systems show limited performance against AI‑generated content, and while labeling interventions can reduce perceived accuracy, their effects are context‑dependent.<h4>Conclusion</h4>Generative AI transforms the health misinformation landscape by lowering barriers to creation and exploiting platform and behavioral dynamics. Current mitigation strategies-spanning technical, sociotechnical, and governance layers-are promising but remain nascent and unevenly evaluated. Future work must prioritize multimodal, multilingual, and health‑specific verification, as well as real‑world testing of interventions, to build equitable and resilient health information ecosystems.","affiliation":"Department of Knowledge and Information Science, Tarbiat Modares University, (TMU), Tehran, Iran.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["Systematic Review","review-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Communication"},{"majorTopic_YN":"Y","descriptorName":"Information Dissemination","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Health Communication"},{"majorTopic_YN":"Y","descriptorName":"Generative Artificial Intelligence"}]},"keywordList":{"keyword":["Systematic review","Mitigation Strategies","Health Misinformation","Deepfakes","Generative Ai"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1186/s12889-025-26148-9"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12924558"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12924558?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":2,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by-nc-nd","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-07-01","dateOfCreation":"2026-01-28","firstIndexDate":"2026-02-06","fullTextReceivedDate":"2026-02-22","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-01-29","firstPublicationDate":"2026-01-29"},{"id":"41976876","source":"MED","pmid":"41976876","pmcid":"PMC13073393","fullTextIdList":{"fullTextId":["PMC13073393"]},"doi":"10.3390/jcm15072576","title":"Clinical Artificial Intelligence Agents in Nephrology: From Prediction to Action Through Workflow-Native Intelligence-A Roadmap for Workflow-Integrated Care.","authorString":"Thongprayoon C, Pesce F, Cheungpasitporn W.","authorList":{"author":[{"fullName":"Thongprayoon C","firstName":"Charat","lastName":"Thongprayoon","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Nephrology and Hypertension, Department of Medicine, Mayo Clinic, Rochester, MN 55905, USA."}]}},{"fullName":"Pesce F","firstName":"Francesco","lastName":"Pesce","initials":"F","authorId":{"type":"ORCID","value":"0000-0002-2882-4226"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Renal Medicine, Ospedale Isola Tiberina-Gemelli Isola, 00168 Rome, Italy."},{"affiliation":"Department of Translational Medicine and Surgery, Università Cattolica del Sacro Cuore, 00168 Rome, Italy."}]}},{"fullName":"Cheungpasitporn W","firstName":"Wisit","lastName":"Cheungpasitporn","initials":"W","authorId":{"type":"ORCID","value":"0000-0001-9954-9711"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Nephrology and Hypertension, Department of Medicine, Mayo Clinic, Rochester, MN 55905, USA."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-9954-9711"},{"type":"ORCID","value":"0000-0002-2882-4226"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"7","volume":"15","journalIssueId":4179667,"dateOfPublication":"2026 Mar","monthOfPublication":3,"yearOfPublication":2026,"printPublicationDate":"2026-03-01","journal":{"title":"Journal of clinical medicine","medlineAbbreviation":"J Clin Med","isoabbreviation":"J Clin Med","nlmid":"101606588","essn":"2077-0383","issn":"2077-0383"}},"pubYear":"2026","pageInfo":"2576","abstractText":"<b>Background</b>: Artificial intelligence in nephrology has largely focused on predictive models for outcomes such as acute kidney injury (AKI), chronic kidney disease (CKD) progression, and transplant complications. Although these models demonstrate technical performance, their real-world clinical impact has remained limited because prediction alone rarely translates into coordinated clinical action. Clinical artificial intelligence agents represent workflow-native systems that operate in real time, interact bidirectionally with clinical environments, adapt to evolving patient and workflow states, and support coordinated clinical action rather than generating isolated predictions. This review proposes clinical artificial intelligence agents as a new paradigm for integrating artificial intelligence directly into nephrology workflows. <b>Methods</b>: We conducted a narrative synthesis of emerging literature on artificial intelligence systems, agentic artificial intelligence architectures, clinical decision support, and digital health infrastructures relevant to kidney care. Drawing from interdisciplinary sources in medicine, health informatics, and artificial intelligence research, we developed a conceptual framework describing the architecture, governance requirements, and evaluation principles of clinical artificial intelligence agents in nephrology. <b>Results</b>: Clinical artificial intelligence agents represent workflow-integrated systems capable of continuously perceiving patient data, reasoning under clinical constraints, planning tasks, and supporting coordinated clinical actions over time. We describe a layered architecture consisting of perception, cognition, planning and control, action, and learning components. Potential applications span the nephrology care continuum, including CKD management, AKI monitoring, dialysis and continuous renal replacement therapy (CRRT) optimization, kidney transplantation care coordination, glomerulonephritis management, and supervised patient-facing systems. <b>Conclusions</b>: Clinical artificial intelligence agents shift the role of artificial intelligence from isolated prediction toward longitudinal clinical orchestration. Future evaluation should prioritize workflow integration, time-to-action, clinician oversight, safety, and patient-centered outcomes rather than relying solely on traditional model performance metrics. This roadmap provides a conceptual foundation for the responsible development and clinical integration of agentic artificial intelligence systems in nephrology.","affiliation":"Division of Nephrology and Hypertension, Department of Medicine, Mayo Clinic, Rochester, MN 55905, USA.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"keywordList":{"keyword":["Artificial intelligence","Nephrology","Clinical Workflow Integration","Clinical Artificial Intelligence Agents","Conceptual Roadmap"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3390/jcm15072576"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13073393"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13073393?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":1,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-04-14","dateOfCreation":"2026-04-14","firstIndexDate":"2026-04-14","fullTextReceivedDate":"2026-04-20","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-03-27","firstPublicationDate":"2026-03-27"},{"id":"41899141","source":"MED","pmid":"41899141","pmcid":"PMC13026613","fullTextIdList":{"fullTextId":["PMC13026613"]},"doi":"10.3390/jcm15062218","title":"Safety-First Framework for AI-Enabled Anamnesis in Head and Neck Surgery: Evidence Synthesis from a Narrative Review.","authorString":"Vaira LA, Qadeer H, Lechien JR, Maniaci A, Maglitto F, Troise S, Chiesa-Estomba CM, Consorti G, Cirignaco G, Iannella G, Navarro-Cuéllar C, Salzano G, Soro GM, Boscolo-Rizzo P, Vellone V, De Riu G.","authorList":{"author":[{"fullName":"Vaira LA","firstName":"Luigi Angelo","lastName":"Vaira","initials":"LA","authorId":{"type":"ORCID","value":"0000-0002-7789-145X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Maxillofacial Surgery Operative Unit, Department of Medicine, Surgery and Pharmacy, University of Sassari, 07100 Sassari, Italy."}]}},{"fullName":"Qadeer H","firstName":"Hareem","lastName":"Qadeer","initials":"H","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Maxillofacial Surgery Operative Unit, Department of Medicine, Surgery and Pharmacy, University of Sassari, 07100 Sassari, Italy."},{"affiliation":"PhD School of Biomedical Sciences, Department of Biomedical Science, University of Sassari, 07100 Sassari, Italy."}]}},{"fullName":"Lechien JR","firstName":"Jerome R","lastName":"Lechien","initials":"JR","authorId":{"type":"ORCID","value":"0000-0002-0845-0845"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Surgery, Mons School of Medicine, Research Institute for Health Sciences and Technology, University of Mons (UMons), 7000 Mons, Belgium."},{"affiliation":"Department of Otolaryngology-Head Neck Surgery, Elsan Polyclinic of Poitiers, 86000 Poitiers, France."}]}},{"fullName":"Maniaci A","firstName":"Antonino","lastName":"Maniaci","initials":"A","authorId":{"type":"ORCID","value":"0000-0002-1251-0185"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medicine and Surgery, University of Enna Kore, 94100 Enna, Italy."}]}},{"fullName":"Maglitto F","firstName":"Fabio","lastName":"Maglitto","initials":"F","authorId":{"type":"ORCID","value":"0000-0002-1080-4067"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Head and Neck Section, Department of Neurosciences, Reproductive and Odontostomatological Science, Federico II University of Naples, 80131 Naples, Italy."}]}},{"fullName":"Troise S","firstName":"Stefania","lastName":"Troise","initials":"S","authorId":{"type":"ORCID","value":"0000-0001-8421-0328"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Head and Neck Section, Department of Neurosciences, Reproductive and Odontostomatological Science, Federico II University of Naples, 80131 Naples, Italy."}]}},{"fullName":"Chiesa-Estomba CM","firstName":"Carlos M","lastName":"Chiesa-Estomba","initials":"CM","authorId":{"type":"ORCID","value":"0000-0001-9454-9464"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Otorhinolaryngology-Head & Neck Surgery, Hospital Universitario Donostia, 20014 San Sebastian, Spain."}]}},{"fullName":"Consorti G","firstName":"Giuseppe","lastName":"Consorti","initials":"G","authorId":{"type":"ORCID","value":"0000-0002-3508-5847"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Maxillofacial Surgery, Department of Neurological Sciences, Marche University Hospitals-Umberto I, 60121 Ancona, Italy."},{"affiliation":"Department of Biomedical Sciences and Public Health, Polytechnic University of Marche, 60121 Ancona, Italy."}]}},{"fullName":"Cirignaco G","firstName":"Giulio","lastName":"Cirignaco","initials":"G","authorId":{"type":"ORCID","value":"0000-0002-6830-9309"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Maxillofacial Surgery, Department of Neurological Sciences, Marche University Hospitals-Umberto I, 60121 Ancona, Italy."},{"affiliation":"Department of Medicine, Section of Maxillo-Facial Surgery, University of Siena, Viale Bracci, 53100 Siena, Italy."}]}},{"fullName":"Iannella G","firstName":"Giannicola","lastName":"Iannella","initials":"G","authorId":{"type":"ORCID","value":"0000-0003-1781-2809"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of 'Organi di Senso', University \"Sapienza\", Viale dell'Università, 33, 00185 Rome, Italy."}]}},{"fullName":"Navarro-Cuéllar C","firstName":"Carlos","lastName":"Navarro-Cuéllar","initials":"C","authorId":{"type":"ORCID","value":"0000-0001-9869-9240"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Maxillofacial Surgery Department, Hospital Gregorio Marañon, Universidad Complutense de Madrid, 28040 Madrid, Spain."}]}},{"fullName":"Salzano G","firstName":"Giovanni","lastName":"Salzano","initials":"G","authorId":{"type":"ORCID","value":"0000-0003-3947-8733"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Head and Neck Section, Department of Neurosciences, Reproductive and Odontostomatological Science, Federico II University of Naples, 80131 Naples, Italy."}]}},{"fullName":"Soro GM","firstName":"Giovanni Maria","lastName":"Soro","initials":"GM","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Administrative Direction, University of Sassari, 07100 Sassari, Italy."}]}},{"fullName":"Boscolo-Rizzo P","firstName":"Paolo","lastName":"Boscolo-Rizzo","initials":"P","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Medical, Surgical and Health Sciences, Section of Otolaryngology, University of Trieste, 34127 Trieste, Italy."}]}},{"fullName":"Vellone V","firstName":"Valentino","lastName":"Vellone","initials":"V","authorId":{"type":"ORCID","value":"0000-0001-6048-1190"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Life Science, Health, and Health Professions, Università degli Studi \"Link\", 00165 Rome, Italy."}]}},{"fullName":"De Riu G","firstName":"Giacomo","lastName":"De Riu","initials":"G","authorId":{"type":"ORCID","value":"0000-0002-7201-6445"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Maxillofacial Surgery Operative Unit, Department of Medicine, Surgery and Pharmacy, University of Sassari, 07100 Sassari, Italy."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-6048-1190"},{"type":"ORCID","value":"0000-0001-8421-0328"},{"type":"ORCID","value":"0000-0001-9454-9464"},{"type":"ORCID","value":"0000-0001-9869-9240"},{"type":"ORCID","value":"0000-0002-0845-0845"},{"type":"ORCID","value":"0000-0002-1080-4067"},{"type":"ORCID","value":"0000-0002-1251-0185"},{"type":"ORCID","value":"0000-0002-3508-5847"},{"type":"ORCID","value":"0000-0002-6830-9309"},{"type":"ORCID","value":"0000-0002-7201-6445"},{"type":"ORCID","value":"0000-0002-7789-145X"},{"type":"ORCID","value":"0000-0003-1781-2809"},{"type":"ORCID","value":"0000-0003-3947-8733"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"6","volume":"15","journalIssueId":4161796,"dateOfPublication":"2026 Mar","monthOfPublication":3,"yearOfPublication":2026,"printPublicationDate":"2026-03-01","journal":{"title":"Journal of clinical medicine","medlineAbbreviation":"J Clin Med","isoabbreviation":"J Clin Med","nlmid":"101606588","essn":"2077-0383","issn":"2077-0383"}},"pubYear":"2026","pageInfo":"2218","abstractText":"<b>Objectives</b>: To synthesize evidence on artificial intelligence (AI)-enabled medical history taking (anamnesis)-beyond large language models (LLMs) alone-and to translate findings into implications and research priorities for head and neck surgery. <b>Methods</b>: We performed a PRISMA-informed narrative review. Searches from database inception to 31 December 2025 (updated 3 January 2026) were conducted in MEDLINE (PubMed), Embase, Scopus, Web of Science Core Collection, IEEE Xplore, and ACM Digital Library, supplemented by medRxiv/arXiv screening and citation chasing. We included studies evaluating or describing AI-supported history capture/summarization, conversational interviewing, symptom checker/digital triage, EHR-integrated intake-to-decision support pipelines, voice interviewing, education/training systems, and governance/ethical considerations related to digital anamnesis. Findings were synthesized by system category and by cross-cutting outcome domains, with a head and neck surgery interpretive lens. <b>Results</b>: Fifty studies (2014-2025) were included. Evidence most consistently suggested feasibility and acceptability of pre-consultation computer-assisted history taking and the potential to reduce documentation burden and improve structured capture. In contrast, symptom checkers and digital triage tools showed highly variable diagnostic/triage performance and prominent safety concerns, highlighting the importance of conservative red-flag escalation strategies, continuous monitoring, and clear accountability. LLM-based diagnostic dialogue demonstrated strong performance in controlled evaluations, but prospective real-world validation, governance, and workflow integration remain limited. <b>Conclusions</b>: AI-enabled anamnesis comprises heterogeneous tools with uneven evidence. For head and neck surgery, potential near-term applications may include structured pre-visit intake, clinician-facing summarization, and training applications, whereas autonomous triage warrants harm-oriented, specialty-calibrated validation and robust governance prior to broader clinical reliance.","affiliation":"Maxillofacial Surgery Operative Unit, Department of Medicine, Surgery and Pharmacy, University of Sassari, 07100 Sassari, Italy.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"grantsList":{"grant":[{"grantId":"ECS 00000038","agency":"Ministero dell'università e della ricerca","orderIn":0}]},"keywordList":{"keyword":["Artificial intelligence","Clinical Decision Support Systems","Anamnesis","Head And Neck Surgery","Medical History Taking","Symptom Checker","Chatbots","Conversational Ai","Digital Triage","Large Language Models"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3390/jcm15062218"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13026613"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13026613?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-03-28","dateOfCreation":"2026-03-28","firstIndexDate":"2026-03-29","fullTextReceivedDate":"2026-03-28","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-03-14","firstPublicationDate":"2026-03-14"},{"id":"42147983","source":"MED","pmid":"42147983","pmcid":"PMC13179146","fullTextIdList":{"fullTextId":["PMC13179146"]},"doi":"10.2147/idr.s601126","title":"A Theoretical Framework for &lt;i&gt;Shared Reasoning Fragility&lt;/i&gt; in Clinician-Chatbot Interactions Through the Example of Antibiotic Prescribing.","authorString":"Giacobbe DR, Grossi AA, Marelli C, Muccio M, Guastavino S, Murgia Y, Mora S, Signori A, Rosso N, Giacomini M, Campi C, Piana M, Bassetti M.","authorList":{"author":[{"fullName":"Giacobbe DR","firstName":"Daniele Roberto","lastName":"Giacobbe","initials":"DR","authorId":{"type":"ORCID","value":"0000-0003-2385-1759"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"UO Clinica Malattie Infettive, IRCCS Azienda Ospedaliera Metropolitana, Genoa, Italy."},{"affiliation":"Department of Health Sciences (DISSAL), University of Genoa, Genoa, Italy."}]}},{"fullName":"Grossi AA","firstName":"Alessandra Agnese","lastName":"Grossi","initials":"AA","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Human Sciences and Innovation for the Territory, University of Insubria, Varese, Italy."},{"affiliation":"Department of Biotechnologies and Life Sciences, Center for Clinical Ethics, University of Insubria, Varese, Italy."}]}},{"fullName":"Marelli C","firstName":"Cristina","lastName":"Marelli","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"CESP - INSERM U1018, Oncostat, Labeled Ligue Contre le Cancer, Gustave Roussy, Université Paris-Saclay, Villejuif, France."},{"affiliation":"Institut Curie - INSERM U1331, Team Statistics Applied to Personalized Medicine, Paris, France."}]}},{"fullName":"Muccio M","firstName":"Marco","lastName":"Muccio","initials":"M","authorId":{"type":"ORCID","value":"0009-0004-0297-1019"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"UO Clinica Malattie Infettive, IRCCS Azienda Ospedaliera Metropolitana, Genoa, Italy."}]}},{"fullName":"Guastavino S","firstName":"Sabrina","lastName":"Guastavino","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Mathematics (DIMA), University of Genoa, Genoa, Italy."}]}},{"fullName":"Murgia Y","firstName":"Ylenia","lastName":"Murgia","initials":"Y","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Informatics, Bioengineering, Robotics and System Engineering (DIBRIS), University of Genoa, Genoa, Italy."}]}},{"fullName":"Mora S","firstName":"Sara","lastName":"Mora","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"UO Information and Communication Technologies, IRCCS Azienda Ospedaliera Metropolitana, Genoa, Italy."}]}},{"fullName":"Signori A","firstName":"Alessio","lastName":"Signori","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Health Sciences (DISSAL), Section of Biostatistics, University of Genoa, Genoa, Italy."},{"affiliation":"Ospedale Policlinico San Martino, IRCCS Azienda Ospedaliera Metropolitana, Genoa, Italy."}]}},{"fullName":"Rosso N","firstName":"Nicola","lastName":"Rosso","initials":"N","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"UO Information and Communication Technologies, IRCCS Azienda Ospedaliera Metropolitana, Genoa, Italy."}]}},{"fullName":"Giacomini M","firstName":"Mauro","lastName":"Giacomini","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Informatics, Bioengineering, Robotics and System Engineering (DIBRIS), University of Genoa, Genoa, Italy."}]}},{"fullName":"Campi C","firstName":"Cristina","lastName":"Campi","initials":"C","authorId":{"type":"ORCID","value":"0000-0003-2105-8554"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Mathematics (DIMA), University of Genoa, Genoa, Italy."},{"affiliation":"Life Science Computational Laboratory (LISCOMP), IRCCS Azienda Ospedaliera Metropolitana, Genoa, Italy."}]}},{"fullName":"Piana M","firstName":"Michele","lastName":"Piana","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Mathematics (DIMA), University of Genoa, Genoa, Italy."},{"affiliation":"Life Science Computational Laboratory (LISCOMP), IRCCS Azienda Ospedaliera Metropolitana, Genoa, Italy."}]}},{"fullName":"Bassetti M","firstName":"Matteo","lastName":"Bassetti","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"UO Clinica Malattie Infettive, IRCCS Azienda Ospedaliera Metropolitana, Genoa, Italy."},{"affiliation":"Department of Health Sciences (DISSAL), University of Genoa, Genoa, Italy."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0003-2105-8554"},{"type":"ORCID","value":"0000-0003-2385-1759"},{"type":"ORCID","value":"0009-0004-0297-1019"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"19","journalIssueId":4091437,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Infection and drug resistance","medlineAbbreviation":"Infect Drug Resist","isoabbreviation":"Infect Drug Resist","nlmid":"101550216","essn":"1178-6973","issn":"1178-6973"}},"pubYear":"2026","pageInfo":"601126","abstractText":"General-purpose large language model (LLM)-based chatbots are increasingly used by clinicians to discuss medical problems, including antibiotic prescribing. Their use creates an unprecedented setting for clinical reasoning in which diagnostic and therapeutic thinking becomes dynamically shared between human and machine. Here, we propose a theoretical framework, intended for subsequent empirical assessment, around the concept of <i>shared reasoning fragility</i>, defined as the potential instability arising from the interaction between clinician reasoning and the chatbot's opaque, association-based processes, which are structurally different from classical human reasoning. The theoretical framework is based on the conceptual argument that, while the black box dilemma is often discussed for classification-oriented clinical decision support systems with an emphasis on explainability versus external validation, chatbot-assisted practice introduces a distinct problem: chatbots can accompany clinicians throughout the entire reasoning pathway rather than being consulted only at the final decision point. In the present perspective, we argue more explicitly that the fragility of this continuous co-reasoning primarily stems from its novelty and pervasiveness. Using strictly illustrative examples in antibiotic prescribing, we suggest the theoretical possibility that fluent and convincing outputs may redirect attention, mask omissions in work-up, and subtly shift hypothesis selection during shared clinical reasoning processes. While it is important to stress that our framework is purely theoretical and thus cannot be confirmed at the present stage, our considerations are intended to motivate the required quantitative research to confirm or refute <i>shared reasoning fragility</i>, measure its extent, and evaluate downstream implications for patient care.","affiliation":"UO Clinica Malattie Infettive, IRCCS Azienda Ospedaliera Metropolitana, Genoa, Italy.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["discussion","Journal Article"]},"keywordList":{"keyword":["Infection","Artificial intelligence","Machine Learning","Healthcare","Natural Language Processing","Antibiotic Prescribing","Deep Learning"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2147/IDR.S601126"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13179146"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13179146?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by-nc","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-05-18","dateOfCreation":"2026-05-18","firstIndexDate":"2026-05-19","fullTextReceivedDate":"2026-05-20","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-05-11","firstPublicationDate":"2026-05-11"},{"id":"42181555","source":"MED","pmid":"42181555","pmcid":"PMC13195604","fullTextIdList":{"fullTextId":["PMC13195604"]},"doi":"10.1016/j.mcpdig.2026.100356","title":"Arkangel AI, OpenEvidence, ChatGPT, Medisearch: Are They Objectively up to Medical Standards? A Real-Life Assessment of LLM Chatbots in Health Care.","authorString":"Castaño-Villegas N, Villa MC, Barrientos KM, Llano I, Velásquez L, Zea J.","authorList":{"author":[{"fullName":"Castaño-Villegas N","firstName":"Natalia","lastName":"Castaño-Villegas","initials":"N","authorId":{"type":"ORCID","value":"0000-0002-3687-4039"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Arkangel AI, Bogotá, Colombia."}]}},{"fullName":"Villa MC","firstName":"María Camila","lastName":"Villa","initials":"MC","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Arkangel AI, Bogotá, Colombia."}]}},{"fullName":"Barrientos KM","firstName":"Katherine Monsalve","lastName":"Barrientos","initials":"KM","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Arkangel AI, Bogotá, Colombia."}]}},{"fullName":"Llano I","firstName":"Isabella","lastName":"Llano","initials":"I","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Arkangel AI, Bogotá, Colombia."}]}},{"fullName":"Velásquez L","firstName":"Laura","lastName":"Velásquez","initials":"L","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Arkangel AI, Bogotá, Colombia."}]}},{"fullName":"Zea J","firstName":"José","lastName":"Zea","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Arkangel AI, Bogotá, Colombia."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-3687-4039"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"2","volume":"4","journalIssueId":4154301,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"printPublicationDate":"2026-06-01","journal":{"title":"Mayo Clinic proceedings. Digital health","medlineAbbreviation":"Mayo Clin Proc Digit Health","isoabbreviation":"Mayo Clin Proc Digit Health","nlmid":"9918662584506676","essn":"2949-7612","issn":"2949-7612"}},"pubYear":"2026","pageInfo":"100356","abstractText":"<h4>Objective</h4>To compare the performance of 4 large language model chatbots in response time and quality of clinical answers, evaluated by specialists using predefined validity criteria.<h4>Participants and methods</h4>Between June 1 and September 20, 2025, four clinical vignettes (orthopedics, pediatrics, gynecology, and psychiatry) were developed by independent experts and answered by 4 conversational agents: Arkangel AI, OpenEvidence, ChatGPT, and Medisearch. Each vignette included 4 questions (diagnosis, clinical management, research, and general knowledge). Responses were independently evaluated by external clinicians using an 8-criterion Likert scale assessing correctness, consensus agreement, absence of bias, adherence to standards of care, timeliness, patient safety, authenticity of cited references, and contextual appropriateness. Response times were summarized using medians and interquartile ranges.<h4>Results</h4>A total of 128 question-answer pairs (1024 evaluations) were analyzed. Overall satisfaction ranged from 71.1% (727) to 93% (952) across agents, with statistically significant differences (Kruskal-Wallis <i>P</i><.001). Dissatisfaction was most frequent for reference authenticity in some ChatGPT modes (75% [n 91/128]-97% [n 119/128]), whereas Arkangel AI-Deep, ChatGPT-Deep, and OpenEvidence showed 100% satisfaction for this criterion. Satisfaction was high for correctness and consensus, with greater variability for bias and patient safety. Satisfaction differed by specialty, with higher scores in gynecology and lower scores in pediatrics (<i>P</i><.001). Median response times ranged from 18 seconds to 12.8 minutes, with significant differences across agents and modes (Wilcoxon <i>P</i><.05).<h4>Conclusion</h4>Large language model chatbots showed substantial variability across validity dimensions when assessed using expert clinical judgment, supporting the need for standardized, multidimensional evaluation frameworks.","affiliation":"Arkangel AI, Bogotá, Colombia.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["research-article","Journal Article"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1016/j.mcpdig.2026.100356"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13195604"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13195604?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by-nc-nd","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-05-25","dateOfCreation":"2026-05-25","firstIndexDate":"2026-05-25","fullTextReceivedDate":"2026-05-27","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-04-02","firstPublicationDate":"2026-04-02"},{"id":"41972116","source":"MED","pmid":"41972116","pmcid":"PMC13061868","fullTextIdList":{"fullTextId":["PMC13061868"]},"doi":"10.3389/jaws.2026.16349","title":"Large Language Models in Surgery: Promise, Pitfalls, and Practical Use.","authorString":"Denham DT, Wang CY, Maric E, Hinton LR, Heniford BT.","authorList":{"author":[{"fullName":"Denham DT","firstName":"Danette T","lastName":"Denham","initials":"DT","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Gastrointestinal and General Surgery, Department of Surgery, Endeavor Health, Evanston, IL, United States."}]}},{"fullName":"Wang CY","firstName":"Colin Y","lastName":"Wang","initials":"CY","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Gastrointestinal and General Surgery, Department of Surgery, Endeavor Health, Evanston, IL, United States."}]}},{"fullName":"Maric E","firstName":"Emil","lastName":"Maric","initials":"E","authorId":{"type":"ORCID","value":"0000-0002-2826-0934"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Gastrointestinal and General Surgery, Department of Surgery, Endeavor Health, Evanston, IL, United States."}]}},{"fullName":"Hinton LR","firstName":"Lucy R","lastName":"Hinton","initials":"LR","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Gastrointestinal and General Surgery, Department of Surgery, Endeavor Health, Evanston, IL, United States."}]}},{"fullName":"Heniford BT","firstName":"B Todd","lastName":"Heniford","initials":"BT","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Gastrointestinal and General Surgery, Department of Surgery, Endeavor Health, Evanston, IL, United States."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-2826-0934"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"5","journalIssueId":4119730,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Journal of abdominal wall surgery : JAWS","medlineAbbreviation":"J Abdom Wall Surg","isoabbreviation":"J Abdom Wall Surg","nlmid":"9918713888406676","essn":"2813-2092","issn":"2813-2092"}},"pubYear":"2026","pageInfo":"16349","abstractText":"<h4>Background</h4>Large Language Models (LLMs) represent a transformative advancement in artificial intelligence (AI) with rapidly expanding applications in medicine. While AI-related medical publications increased 36-fold between 2000-2022, practical guidance for surgeons remains limited. This mini-review delineates pragmatic applications of LLMs in surgical practice while addressing key limitations, implementation considerations, and ethical considerations.<h4>Methods</h4>We reviewed contemporary LLM platforms and their integration into clinical workflows, patient communication, surgical research and academic writing, evaluating both benefits, constraints and risk mitigation relevant to practicing surgeons.<h4>Findings</h4>LLMs demonstrate significant utility across multiple domains. In clinical workflows, ambient documentation and chart summarization may reduce documentation burden and support rapid synthesis of complex patient data. For patient communication, these tools can simplify complex medical information, tailor or translate patient instructions to appropriate reading levels or languages, and generate empathetic responses to patient messages with improved efficiency. In research, LLMs assist with literature summarization, study design optimization, and risk of bias assessment in RCT, allowing surgeons to focus on higher-level scientific reasoning. Despite promising applications, several constraints demand attention. Effective prompting requires specific techniques including clear clinical objectives, explicit instructions, and iterative refinement. LLM outputs require verification to prevent \"hallucinations\" - fabricated or inaccurate information. Protected health information (PHI) must never be entered into public LLM platforms to maintain HIPAA compliance. Liability frameworks for AI-generated errors remain ambiguous, with unclear responsibility deferred amongst providers, institutions, and developers.<h4>Conclusion</h4>LLMs offer surgeons valuable tools for enhancing workflow efficiency and patient communication when deployed with appropriate oversight. Success requires understanding prompt engineering principles, maintaining rigorous fact-checking protocols, protecting patient privacy, and recognizing that human judgment remains irreplaceable in clinical decision-making.","affiliation":"Division of Gastrointestinal and General Surgery, Department of Surgery, Endeavor Health, Evanston, IL, United States.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"keywordList":{"keyword":["Surgery","Academic Research","Patient Outcomes","Artificial Intelligence (Ai)","Large Language Models"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/jaws.2026.16349"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13061868"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13061868?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-04-13","dateOfCreation":"2026-04-13","firstIndexDate":"2026-04-13","fullTextReceivedDate":"2026-04-10","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-03-26","firstPublicationDate":"2026-03-26"},{"id":"41930312","source":"MED","pmid":"41930312","pmcid":"PMC13040924","fullTextIdList":{"fullTextId":["PMC13040924"]},"doi":"10.1016/j.esmorw.2026.100683","title":"Digital symptom monitoring and activity tracking in chemoradiation-lessons from the CAM experience.","authorString":"Fu J, Pepin A, Hollawell C, Tang K, Bryer JS, Munter A, Sinha S, Goel A.","authorList":{"author":[{"fullName":"Fu J","firstName":"J","lastName":"Fu","initials":"J","authorId":{"type":"ORCID","value":"0009-0000-3578-9425"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Radiation Oncology, University of Pennsylvania, Philadelphia, USA."}]}},{"fullName":"Pepin A","firstName":"A","lastName":"Pepin","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Radiation Oncology, University of Pennsylvania, Philadelphia, USA."}]}},{"fullName":"Hollawell C","firstName":"C","lastName":"Hollawell","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Radiation Oncology, University of Pennsylvania, Philadelphia, USA."}]}},{"fullName":"Tang K","firstName":"K","lastName":"Tang","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Radiation Oncology, University of Pennsylvania, Philadelphia, USA."}]}},{"fullName":"Bryer JS","firstName":"J S","lastName":"Bryer","initials":"JS","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Radiation Oncology, University of Pennsylvania, Philadelphia, USA."}]}},{"fullName":"Munter A","firstName":"A","lastName":"Munter","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Radiation Oncology, University of Pennsylvania, Philadelphia, USA."}]}},{"fullName":"Sinha S","firstName":"S","lastName":"Sinha","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biomedical and Health Informatics, Children's Hospital of Philadelphia, Philadelphia, USA."}]}},{"fullName":"Goel A","firstName":"A","lastName":"Goel","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Radiation Oncology, University of Pennsylvania, Philadelphia, USA."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0009-0000-3578-9425"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"volume":"11","journalIssueId":4133860,"dateOfPublication":"2026 Mar","monthOfPublication":3,"yearOfPublication":2026,"printPublicationDate":"2026-03-01","journal":{"title":"ESMO real world data and digital oncology","medlineAbbreviation":"ESMO Real World Data Digit Oncol","isoabbreviation":"ESMO Real World Data Digit Oncol","nlmid":"9919053637506676","essn":"2949-8201","issn":"2949-8201"}},"pubYear":"2026","pageInfo":"100683","abstractText":"Artificial intelligence (AI) is increasingly being explored as a way to improve supportive care during chemoradiotherapy (CRT). Through our CAM 1.0 and CAM 2.0 studies, we examined how AI-supported remote patient monitoring could be integrated into CRT care, revealing both its potential benefits and its challenges in real-world implementation. We observed how AI can facilitate remote patient monitoring beyond routine visits, yet also how it may create additional tasks for providers, magnify digital inequities, and leave patients still seeking human connection. These experiences underscore that AI's impact in oncology will be defined not only by its technical capabilities but by how it fits into workflows, addresses barriers to access, and preserves the relational aspects of care. This perspectives piece aims to highlight the practical insights from CAM 1.0 and 2.0 that may inform how oncologists, developers, and health systems approach future AI integration into oncology workflows, particularly in the context of CRT. NCT: NCT05318027.","affiliation":"Department of Radiation Oncology, University of Pennsylvania, Philadelphia, USA.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"keywordList":{"keyword":["Artificial intelligence","Thoracic Cancer","Head And Neck Cancer","Chemoradiotherapy","Gastrointestinal Cancer","Remote Patient Monitoring","Chatbot","Continuous Activity Monitoring","Digital Oncology"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1016/j.esmorw.2026.100683"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13040924"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13040924?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by-nc-nd","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["nct","doi"]},"dateOfCompletion":"2026-04-03","dateOfCreation":"2026-04-03","firstIndexDate":"2026-04-03","fullTextReceivedDate":"2026-04-02","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-01-23","firstPublicationDate":"2026-01-23"},{"id":"41925600","source":"MED","pmid":"41925600","pmcid":"PMC13058505","fullTextIdList":{"fullTextId":["PMC13058505"]},"doi":"10.4102/safp.v68i1.6340","title":"Augmenting care, not replacing it: Generative artificial intelligence and equitable primary care in Southern Africa.","authorString":"Von Pressentin KB, Nair A, Rabe M, De Jong M, Kaswa R, Govender I.","authorList":{"author":[{"fullName":"Von Pressentin KB","firstName":"Klaus B","lastName":"Von Pressentin","initials":"KB","authorId":{"type":"ORCID","value":"0000-0001-5965-9721"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Division of Family Medicine, Department of Family, Community and Emergency Care, Faculty of Health Sciences, University of Cape Town, Cape Town. editor@safpj.co.za."}]}},{"fullName":"Nair A","firstName":"Arun","lastName":"Nair","initials":"A"},{"fullName":"Rabe M","firstName":"Mareike","lastName":"Rabe","initials":"M","authorId":{"type":"ORCID","value":"0000-0001-9476-7867"}},{"fullName":"De Jong M","firstName":"Marischka","lastName":"De Jong","initials":"M","authorId":{"type":"ORCID","value":"0000-0002-1162-9547"}},{"fullName":"Kaswa R","firstName":"Ramprakash","lastName":"Kaswa","initials":"R","authorId":{"type":"ORCID","value":"0000-0001-9658-3826"}},{"fullName":"Govender I","firstName":"Indiran","lastName":"Govender","initials":"I","authorId":{"type":"ORCID","value":"0000-0003-0126-8087"}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5965-9721"},{"type":"ORCID","value":"0000-0001-9476-7867"},{"type":"ORCID","value":"0000-0001-9658-3826"},{"type":"ORCID","value":"0000-0002-1162-9547"},{"type":"ORCID","value":"0000-0003-0126-8087"}]},"journalInfo":{"issue":"1","volume":"68","journalIssueId":4138377,"dateOfPublication":"2026 Mar","monthOfPublication":3,"yearOfPublication":2026,"printPublicationDate":"2026-03-01","journal":{"title":"South African family practice : official journal of the South African Academy of Family Practice/Primary Care","medlineAbbreviation":"S Afr Fam Pract (2004)","isoabbreviation":"S Afr Fam Pract (2004)","nlmid":"9701104","essn":"2078-6204","issn":"2078-6190"}},"pubYear":"2026","pageInfo":"6340","abstractText":"No abstract available.","affiliation":"Division of Family Medicine, Department of Family, Community and Emergency Care, Faculty of Health Sciences, University of Cape Town, Cape Town. editor@safpj.co.za.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["editorial","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Primary Health Care","meshQualifierList":{"meshQualifier":[{"abbreviation":"OG","qualifierName":"organization & administration","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"South Africa"},{"majorTopic_YN":"N","descriptorName":"Generative Artificial Intelligence"}]},"keywordList":{"keyword":["Artificial intelligence","Primary Care","Family Medicine."]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.4102/safp.v68i1.6340"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13058505"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13058505?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"N","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-07-14","dateOfCreation":"2026-04-02","firstIndexDate":"2026-04-03","fullTextReceivedDate":"2026-04-09","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-03-20","firstPublicationDate":"2026-03-20"},{"id":"42318585","source":"MED","pmid":"42318585","pmcid":"PMC13272403","fullTextIdList":{"fullTextId":["PMC13272403"]},"doi":"10.3389/frai.2026.1818128","title":"Evidence-based AI: from trailblazer to trustblazer?","authorString":"Luechtefeld T, Hartung T.","authorList":{"author":[{"fullName":"Luechtefeld T","firstName":"Thomas","lastName":"Luechtefeld","initials":"T","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Insilica Inc., Rockville, MD, United States."}]}},{"fullName":"Hartung T","firstName":"Thomas","lastName":"Hartung","initials":"T","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Alternatives to Animal Testing (CAAT), Johns Hopkins Bloomberg School of Public Health, Baltimore, MD, United States."},{"affiliation":"CAAT-Europe, University of Konstanz, Konstanz, Germany."}]}}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"9","journalIssueId":4117457,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Frontiers in artificial intelligence","medlineAbbreviation":"Front Artif Intell","isoabbreviation":"Front Artif Intell","nlmid":"101770551","essn":"2624-8212","issn":"2624-8212"}},"pubYear":"2026","pageInfo":"1818128","abstractText":"Agentic AI systems can plan, call tools, and coordinate specialized sub-agents, enabling multi-step scientific workflows that exceed what single-model text generation can reliably deliver. Yet in high-stakes domains such as regulatory science and toxicology, fluent outputs are not sufficient: adoption hinges on traceability, reproducibility, context-of-use validity, and explicit uncertainty communication. This perspective argues that evidence-based medicine and evidence-based toxicology provide a mature epistemic scaffold for making agentic AI trustworthy by design. We propose an Evidence-based Agent Stack that decomposes end-to-end tasks into protocolized roles (question framing, retrieval, screening, extraction, risk-of-bias appraisal, synthesis, mechanistic/causal integration, uncertainty assessment, and evidence-to-decision translation) with mandatory provenance and versioning. Anchoring agentic workflows in systematic review practice, risk-of-bias frameworks, and emerging regulatory principles (e.g., TREAT and e-validation) can turn \"<i>trailblazing</i>\" AI into \"<i>trustblazing</i>\" AI: systems whose outputs are auditable, updateable, and aligned with decision accountability.","affiliation":"Insilica Inc., Rockville, MD, United States.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["brief-report","Journal Article"]},"keywordList":{"keyword":["Systematic review","Regulatory Science","Evidence-based Toxicology","Risk Of Bias","Retrieval-augmented Generation","Agentic Ai","E-validation","Evidence-based Edicine"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/frai.2026.1818128"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13272403"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13272403?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-06-19","dateOfCreation":"2026-06-19","firstIndexDate":"2026-06-20","fullTextReceivedDate":"2026-06-24","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-03","firstPublicationDate":"2026-06-03"},{"id":"42373921","source":"MED","pmid":"42373921","pmcid":"PMC13314726","fullTextIdList":{"fullTextId":["PMC13314726"]},"doi":"10.3758/s13428-026-03091-0","title":"Talking surveys: How photorealistic embodied conversational agents shape response quality, engagement, and satisfaction.","authorString":"Krajcovic M, Demcak P, Kuric E.","authorList":{"author":[{"fullName":"Krajcovic M","firstName":"Matus","lastName":"Krajcovic","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"UXtweak Research, UXtweak j.s.a., Cajakova 18, Bratislava, 81105, Slovakia."},{"affiliation":"Faculty of Informatics and Information Technologies, Slovak University of Technology, Ilkovicova 2, Bratislava, 84216, Slovakia."}]}},{"fullName":"Demcak P","firstName":"Peter","lastName":"Demcak","initials":"P","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"UXtweak Research, UXtweak j.s.a., Cajakova 18, Bratislava, 81105, Slovakia."}]}},{"fullName":"Kuric E","firstName":"Eduard","lastName":"Kuric","initials":"E","authorId":{"type":"ORCID","value":"0000-0002-7371-5512"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"UXtweak Research, UXtweak j.s.a., Cajakova 18, Bratislava, 81105, Slovakia. eduard.kuric@stuba.sk."},{"affiliation":"Faculty of Informatics and Information Technologies, Slovak University of Technology, Ilkovicova 2, Bratislava, 84216, Slovakia. eduard.kuric@stuba.sk."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-7371-5512"}]},"journalInfo":{"issue":"8","volume":"58","journalIssueId":4219414,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"printPublicationDate":"2026-06-01","journal":{"title":"Behavior research methods","medlineAbbreviation":"Behav Res Methods","isoabbreviation":"Behav Res Methods","nlmid":"101244316","essn":"1554-3528","issn":"1554-351X"}},"pubYear":"2026","pageInfo":"212","abstractText":"Embodied conversational agents (ECAs) are increasingly more realistic and capable of dynamic conversations. In online surveys, anthropomorphic agents could help address issues like careless responding and satisficing, which originate from the lack of personal engagement and perceived accountability. However, there is a lack of understanding of how ECAs in user experience research may affect participant engagement, satisfaction, and the quality of responses. We introduce a method, Virtual Agent Interviewer, and validate it in a randomized study. Our proof-of-concept method enables the incorporation of conversations with a virtual avatar into surveys using AI-driven video generation, speech recognition, and Large Language Models. In our between-subjects study, 80 participants (UK, stratified random sample of the general population) either talked to a voice-based agent with an animated video avatar, or interacted with a chatbot. Our evaluation entails 2265 conversation responses obtained across surveys based on two self-reported psychometric tests. Statistical comparison of the results indicates that embodied agents can contribute significantly to more informative, detailed responses, as well as higher yet more time-efficient engagement. Furthermore, qualitative analysis provides valuable insights about the causes of no significant change to satisfaction, linked to personal preferences, turn-taking delays, and Uncanny Valley reactions. These findings support and inform the development of new AI-driven embodiment-based methods for the transformation of online surveys into more natural interactions resembling in-person interviews.","affiliation":"UXtweak Research, UXtweak j.s.a., Cajakova 18, Bratislava, 81105, Slovakia.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"grantsList":{"grant":[{"grantId":"17I04-04-V05-00029","agency":"EU NextGenerationEU through the Recovery and Resilience Plan for Slovakia","orderIn":0},{"grantId":"APVV-23-0408","agency":"Agentúra na Podporu Výskumu a Vývoja","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Communication"},{"majorTopic_YN":"Y","descriptorName":"Speech"},{"majorTopic_YN":"Y","descriptorName":"Personal Satisfaction"},{"majorTopic_YN":"N","descriptorName":"Adult"},{"majorTopic_YN":"N","descriptorName":"Middle Aged"},{"majorTopic_YN":"N","descriptorName":"Female"},{"majorTopic_YN":"N","descriptorName":"Male"},{"majorTopic_YN":"N","descriptorName":"Young Adult"},{"majorTopic_YN":"N","descriptorName":"Surveys and Questionnaires"},{"majorTopic_YN":"N","descriptorName":"Avatar"}]},"keywordList":{"keyword":["Virtual Human","Conversational Agent","Chatbot","Ai-mediated Communication","Photorealistic Avatar","User Engagement And Satisfaction"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3758/s13428-026-03091-0"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13314726"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13314726?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-06-29","dateOfCreation":"2026-06-29","firstIndexDate":"2026-07-02","fullTextReceivedDate":"2026-08-19","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-29","firstPublicationDate":"2026-06-29"},{"id":"41924178","source":"MED","pmid":"41924178","pmcid":"PMC13035794","fullTextIdList":{"fullTextId":["PMC13035794"]},"doi":"10.3389/fdgth.2026.1772274","title":"Promises and challenges of applying large language models in the healthcare domain.","authorString":"Wang Q, Gong Z, Lai Z, Bu L, Dahlweid FM, Sun H.","authorList":{"author":[{"fullName":"Wang Q","firstName":"Qingyu","lastName":"Wang","initials":"Q","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Provincial Key Laboratory of Multimodal Perceiving and Intelligent Systems, Jiaxing University, Jiaxing, China."},{"affiliation":"Sino-European Joint Lab for Health Information Processing and Applications, Jiaxing University, Jiaxing, China."}]}},{"fullName":"Gong Z","firstName":"Ziheng","lastName":"Gong","initials":"Z","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Provincial Key Laboratory of Multimodal Perceiving and Intelligent Systems, Jiaxing University, Jiaxing, China."},{"affiliation":"Sino-European Joint Lab for Health Information Processing and Applications, Jiaxing University, Jiaxing, China."}]}},{"fullName":"Lai Z","firstName":"Zou","lastName":"Lai","initials":"Z","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Provincial Key Laboratory of Multimodal Perceiving and Intelligent Systems, Jiaxing University, Jiaxing, China."},{"affiliation":"Sino-European Joint Lab for Health Information Processing and Applications, Jiaxing University, Jiaxing, China."}]}},{"fullName":"Bu L","firstName":"Lina","lastName":"Bu","initials":"L","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Provincial Key Laboratory of Multimodal Perceiving and Intelligent Systems, Jiaxing University, Jiaxing, China."},{"affiliation":"Sino-European Joint Lab for Health Information Processing and Applications, Jiaxing University, Jiaxing, China."}]}},{"fullName":"Dahlweid FM","firstName":"Fried-Michael","lastName":"Dahlweid","initials":"FM","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Sino-European Joint Lab for Health Information Processing and Applications, Jiaxing University, Jiaxing, China."},{"affiliation":"Dedalus Healthcare, Milan, Italy."}]}},{"fullName":"Sun H","firstName":"Hong","lastName":"Sun","initials":"H","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Provincial Key Laboratory of Multimodal Perceiving and Intelligent Systems, Jiaxing University, Jiaxing, China."},{"affiliation":"Sino-European Joint Lab for Health Information Processing and Applications, Jiaxing University, Jiaxing, China."}]}}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics"]},"journalInfo":{"volume":"8","journalIssueId":4117475,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Frontiers in digital health","medlineAbbreviation":"Front Digit Health","isoabbreviation":"Front Digit Health","nlmid":"101771889","essn":"2673-253X","issn":"2673-253X"}},"pubYear":"2026","pageInfo":"1772274","abstractText":"Large language models are rapidly moving from theoretical concepts to active clinical pilots. Current approaches diverge between general-purpose models, which adapt to healthcare via prompt engineering, and domain-specific models, which prioritize deep alignment with medical knowledge graphs to ensure safety. Despite reported benefits in documentation efficiency and diagnostic reasoning, significant challenges remain regarding hallucination, privacy, and the validity of evaluation metrics. This Mini Review synthesizes current evidence, contrasts these two modeling paradigms, highlights key controversies, and maps out future development routes including retrieval-augmented generation and agentic architectures.","affiliation":"Provincial Key Laboratory of Multimodal Perceiving and Intelligent Systems, Jiaxing University, Jiaxing, China.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"keywordList":{"keyword":["Artificial intelligence","Clinical Decision Support","Multimodal","Large Language Models","Model Hallucinations"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/fdgth.2026.1772274"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13035794"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13035794?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-04-02","dateOfCreation":"2026-04-02","firstIndexDate":"2026-04-03","fullTextReceivedDate":"2026-04-01","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-03-17","firstPublicationDate":"2026-03-17"},{"id":"42193635","source":"MED","pmid":"42193635","pmcid":"PMC13203178","fullTextIdList":{"fullTextId":["PMC13203178"]},"doi":"10.3390/bs16050756","title":"Conversational AI and Personal Growth: Insights from a Critical Integrative Review.","authorString":"Sharma S, Vohra P, Vowels LM.","authorList":{"author":[{"fullName":"Sharma S","firstName":"Shivali","lastName":"Sharma","initials":"S","authorId":{"type":"ORCID","value":"0009-0004-0622-7203"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Psychology, University of Roehampton, London SW15 4JD, UK."}]}},{"fullName":"Vohra P","firstName":"Pranika","lastName":"Vohra","initials":"P","authorId":{"type":"ORCID","value":"0009-0003-2449-0198"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychology, North Dakota State University, Fargo, ND 58108, USA."}]}},{"fullName":"Vowels LM","firstName":"Laura M","lastName":"Vowels","initials":"LM","authorId":{"type":"ORCID","value":"0000-0001-5594-2095"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Psychology, University of Roehampton, London SW15 4JD, UK."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5594-2095"},{"type":"ORCID","value":"0009-0003-2449-0198"},{"type":"ORCID","value":"0009-0004-0622-7203"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"5","volume":"16","journalIssueId":4201800,"dateOfPublication":"2026 May","monthOfPublication":5,"yearOfPublication":2026,"printPublicationDate":"2026-05-01","journal":{"title":"Behavioral sciences (Basel, Switzerland)","medlineAbbreviation":"Behav Sci (Basel)","isoabbreviation":"Behav Sci (Basel)","nlmid":"101576826","essn":"2076-328X","issn":"2076-328X"}},"pubYear":"2026","pageInfo":"756","abstractText":"Conversational AI systems are increasingly integrated into individuals' emotional and relational lives, yet whether such interactions can meaningfully support personal growth remains poorly understood. This critical integrative review synthesises theoretical frameworks from humanistic psychology, self-determination theory, attachment theory, and relationship science with empirical research on human-AI interaction to address this question directly. Drawing on 130 studies spanning therapeutic, companion, and educational AI contexts, the review identifies four interdependent domains that together shape growth outcomes in human-AI contexts: user-related characteristics, AI design features, human-AI relational dynamics, and broader contextual factors. The evidence supports a position of bounded optimism: conversational AI can scaffold early emotional stabilisation, structured self-reflection, and therapeutic skill rehearsal, yet it remains structurally limited in replicating the reciprocal vulnerability, rupture-and-repair processes, and calibrated ideal-self affirmation that underpin enduring psychological development. Engagement-optimised design-including flattery, progressive intimacy escalation, and unconditional validation-is consistently identified as a systematic barrier to growth across multiple domains of the framework. An integrative four-domain conceptual framework is proposed to guide both future research and the ethical design of AI systems that support, rather than undermine, the relational mechanisms fundamental to human flourishing.","affiliation":"School of Psychology, University of Roehampton, London SW15 4JD, UK.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"keywordList":{"keyword":["Attachment","Therapeutic Alliance","Self-development","Personal Growth","Chatbots","Conversational Ai"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3390/bs16050756"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13203178"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13203178?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-05-27","dateOfCreation":"2026-05-27","firstIndexDate":"2026-05-28","fullTextReceivedDate":"2026-05-27","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-05-12","firstPublicationDate":"2026-05-12"},{"id":"42536834","source":"MED","pmid":"42536834","doi":"10.2196/98822","title":"Perspectives of Individuals With Obsessive-Compulsive Disorder on the Role of Artificial Intelligence in Therapy and Treatment: Thematic Qualitative Study.","authorString":"Mokhtar D, Wang H, Garland EC, Shakya D, Occhino-Moede L, Liu X, Frank AC.","authorList":{"author":[{"fullName":"Mokhtar D","firstName":"Daniel","lastName":"Mokhtar","initials":"D","authorId":{"type":"ORCID","value":"0009-0008-0011-5963"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry and Behavioral Sciences, Keck School of Medicine, University of Southern California, 2500 Alcazar St, Suite 2200, Los Angeles, CA, 90033, United States, 1 323-442-6000, 1 323-442-6001."}]}},{"fullName":"Wang H","firstName":"Harrison","lastName":"Wang","initials":"H","authorId":{"type":"ORCID","value":"0000-0002-9941-6895"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry and Behavioral Sciences, Keck School of Medicine, University of Southern California, 2500 Alcazar St, Suite 2200, Los Angeles, CA, 90033, United States, 1 323-442-6000, 1 323-442-6001."}]}},{"fullName":"Garland EC","firstName":"Emma C","lastName":"Garland","initials":"EC","authorId":{"type":"ORCID","value":"0009-0007-6799-925X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry and Behavioral Sciences, Keck School of Medicine, University of Southern California, 2500 Alcazar St, Suite 2200, Los Angeles, CA, 90033, United States, 1 323-442-6000, 1 323-442-6001."}]}},{"fullName":"Shakya D","firstName":"Dejan","lastName":"Shakya","initials":"D","authorId":{"type":"ORCID","value":"0000-0003-0281-3534"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry and Behavioral Sciences, Keck School of Medicine, University of Southern California, 2500 Alcazar St, Suite 2200, Los Angeles, CA, 90033, United States, 1 323-442-6000, 1 323-442-6001."}]}},{"fullName":"Occhino-Moede L","firstName":"Lucas","lastName":"Occhino-Moede","initials":"L","authorId":{"type":"ORCID","value":"0009-0002-8450-5534"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry and Behavioral Sciences, Keck School of Medicine, University of Southern California, 2500 Alcazar St, Suite 2200, Los Angeles, CA, 90033, United States, 1 323-442-6000, 1 323-442-6001."}]}},{"fullName":"Liu X","firstName":"Xiao","lastName":"Liu","initials":"X","authorId":{"type":"ORCID","value":"0009-0001-9406-5301"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry and Behavioral Sciences, Keck School of Medicine, University of Southern California, 2500 Alcazar St, Suite 2200, Los Angeles, CA, 90033, United States, 1 323-442-6000, 1 323-442-6001."}]}},{"fullName":"Frank AC","firstName":"Adam Charles","lastName":"Frank","initials":"AC","authorId":{"type":"ORCID","value":"0000-0001-8203-8480"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Psychiatry and Behavioral Sciences, Keck School of Medicine, University of Southern California, 2500 Alcazar St, Suite 2200, Los Angeles, CA, 90033, United States, 1 323-442-6000, 1 323-442-6001."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-8203-8480"},{"type":"ORCID","value":"0000-0002-9941-6895"},{"type":"ORCID","value":"0000-0003-0281-3534"},{"type":"ORCID","value":"0009-0001-9406-5301"},{"type":"ORCID","value":"0009-0002-8450-5534"},{"type":"ORCID","value":"0009-0007-6799-925X"},{"type":"ORCID","value":"0009-0008-0011-5963"}]},"journalInfo":{"volume":"18","journalIssueId":4229067,"dateOfPublication":"2026 Jul","monthOfPublication":7,"yearOfPublication":2026,"printPublicationDate":"2026-07-01","journal":{"title":"Journal of participatory medicine","medlineAbbreviation":"J Particip Med","isoabbreviation":"J Particip Med","nlmid":"101539422","essn":"2152-7202","issn":"2152-7202"}},"pubYear":"2026","pageInfo":"e98822","abstractText":"<h4>Background</h4>AI has become increasingly used in mental health care for applications such as diagnosis, monitoring, and treatment support. These include tools like clinician support systems, large language models, and conversational agents used to augment psychotherapy and clinical decision-making. While prior research suggests potential benefits of and concerns with AI, little is known within the domain of obsessive-compulsive disorder (OCD). Given the expanding role of AI in psychiatry, understanding these perspectives is essential to ensuring AI implementation aligns with patient priorities and values.<h4>Objective</h4>This study aims to explore the perspectives of individuals with OCD on the use of AI in health care, including perceived benefits, risks, and its role in relation to human clinicians.<h4>Methods</h4>We conducted semistructured interviews with 24 adults self-reporting OCD, recruited through online communities and advocacy networks. Eligible individuals (≥18 y with self-reported OCD) completed screening, provided informed consent, and participated in remote Health Insurance Portability and Accountability Act (HIPAA)-compliant Zoom (Zoom Communications, Inc) interviews (May-December 2024). Transcripts were deidentified, open-coded, and used to develop a codebook. Focused codes were applied using a thematic analysis framework in Dedoose (v9.2.22; Sociocultural Research Consultants, LLC). Each transcript was independently coded by 2 reviewers, with discrepancies resolved through consensus. Themes were developed through iterative interpretive analysis of code clusters.<h4>Results</h4>Participants' perspectives encompassed concerns and benefits of AI in mental health care. Participants expressed concerns about the accuracy and efficacy of information provided by AI, as well as a limited ability for clinical judgment in psychiatric care. Additionally, participants emphasized the importance of human connection, particularly therapeutic alliance, empathy, and reassurance provided by clinicians, which they felt AI could not replicate. Concerns about data privacy, security, and downstream use of information were also highlighted. Despite concerns, many endorsed the use of AI as an adjunct rather than a replacement for clinicians, noting potential benefits in symptom monitoring, preliminary information gathering, and support for administrative tasks, provided that human oversight is maintained.<h4>Conclusions</h4>Individuals with OCD expressed nuanced views on AI in mental health care, balancing cautious optimism with several concerns. While AI may improve efficiency, standardization, and symptom monitoring, participants highlighted risks related to deindividualization, accuracy, and erosion of human connection. These findings underscore the importance of patient-centered, ethically guided AI integration that preserves the therapeutic alliance while leveraging technological benefits.","affiliation":"Department of Psychiatry and Behavioral Sciences, Keck School of Medicine, University of Southern California, 2500 Alcazar St, Suite 2200, Los Angeles, CA, 90033, United States, 1 323-442-6000, 1 323-442-6001.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["Journal Article"]},"keywordList":{"keyword":["Artificial intelligence","Qualitative","AI","Ocd","Obsessive-compulsive Disorder","Patient Experience","Thematic Analysis","Llm","Chatbot","Large Language Model"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/98822"}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-07-31","dateOfCreation":"2026-07-31","firstIndexDate":"2026-08-03","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-07-31","firstPublicationDate":"2026-07-31"},{"id":"42297358","source":"MED","pmid":"42297358","pmcid":"PMC13315997","fullTextIdList":{"fullTextId":["PMC13315997"]},"doi":"10.2196/76924","title":"Developing a Large Language Model-Based Feedback System for Case Report Writing in Rehabilitation Education: Tutorial.","authorString":"Tonouchi Y, Nakai S, Murakami K, Kataoka Y.","authorList":{"author":[{"fullName":"Tonouchi Y","firstName":"Yuuto","lastName":"Tonouchi","initials":"Y","authorId":{"type":"ORCID","value":"0009-0009-4813-4829"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Rehabilitation, Kyoto Min-iren Asukai Hospital, Kyoto, Kyoto, Japan."}]}},{"fullName":"Nakai S","firstName":"Shunsuke","lastName":"Nakai","initials":"S","authorId":{"type":"ORCID","value":"0009-0008-8775-0715"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Occupational Therapy, Faculty of Rehabilitation, Morinomiya University of Medical Sciences, Osaka, Osaka, Japan."},{"affiliation":"Graduate School of Rehabilitation Science, Osaka Metropolitan University, Osaka, Osaka, Japan."}]}},{"fullName":"Murakami K","firstName":"Kayo","lastName":"Murakami","initials":"K","authorId":{"type":"ORCID","value":"0009-0004-1516-8452"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Rehabilitation, Kyoto Min-iren Asukai Hospital, Kyoto, Kyoto, Japan."}]}},{"fullName":"Kataoka Y","firstName":"Yuki","lastName":"Kataoka","initials":"Y","authorId":{"type":"ORCID","value":"0000-0001-7982-5213"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Center for Postgraduate Clinical Training and Career Development, Nagoya University Hospital, Nagoya, Aichi, Japan."},{"affiliation":"Center for Medical Education, Graduate School of Medicine, Nagoya University, Nagoya, Aichi, Japan."},{"affiliation":"Department of Healthcare Epidemiology, Graduate School of Medicine and Public Health, Kyoto University, Kyoto, Kyoto, Japan."},{"affiliation":"Department of Systematic Reviewers, Scientific Research Works Peer Support Group (SRWS-PSG), Osaka, Osaka, Japan."},{"affiliation":"Department of Internal Medicine, Kyoto Min-iren Asukai Hospital, Kyoto, Kyoto, Japan."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-7982-5213"},{"type":"ORCID","value":"0009-0004-1516-8452"},{"type":"ORCID","value":"0009-0008-8775-0715"},{"type":"ORCID","value":"0009-0009-4813-4829"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"volume":"12","journalIssueId":4204590,"dateOfPublication":"2026 Jun","monthOfPublication":6,"yearOfPublication":2026,"printPublicationDate":"2026-06-01","journal":{"title":"JMIR medical education","medlineAbbreviation":"JMIR Med Educ","isoabbreviation":"JMIR Med Educ","nlmid":"101684518","essn":"2369-3762","issn":"2369-3762"}},"pubYear":"2026","pageInfo":"e76924","abstractText":"<h4>Background</h4>Novice health care staff often write case reports during early clinical training. However, many institutions lack structured feedback systems because of time constraints and instructor shortages. Large language models, a form of artificial intelligence (AI), offer new opportunities to enhance educational feedback, yet their application in clinical training requires careful design to ensure pedagogically appropriate and ethically sound outputs.<h4>Objective</h4>This tutorial provides a practical guide for educators without programming experience to develop an AI-based feedback system using 3 accessible tools: Dify (an AI workflow platform), Slack (a messaging app), and Google Apps Script. The system balances educational quality with operational efficiency while incorporating data privacy safeguards for clinical educational content.<h4>Methods</h4>We developed a feedback system comprising 4 AI chatbots with 2 distinct approaches: \"loop-based\" bots that promote clinical reasoning through iterative, comment-based feedback and \"single-shot\" bots for efficient proofreading and summarization tasks. The tutorial describes the system architecture; feedback design principles grounded in formative assessment theory; a step-by-step implementation guide; and data privacy safeguards, including a deidentification protocol and application programming interface-based data protection measures. To illustrate feasibility, we conducted a pilot implementation at a community care hospital from April to June 2024, involving 5 novice staff members and 5 instructors.<h4>Results</h4>A pilot implementation at a community care hospital demonstrated that the system was feasible to deploy and operate within routine clinical education workflows. Participant feedback indicated high usability and suggested that the iterative, comment-based feedback approach supported learner engagement while also identifying areas where feedback criteria required refinement to better match institutional educational goals.<h4>Conclusions</h4>This tutorial provides a reproducible framework for building a customized AI feedback system that combines comment-based iterative feedback with human-in-the-loop oversight and a multilayered data privacy framework. By following this guide, educators can implement an adaptive system tailored to their institutional context and clinical domain.","affiliation":"Department of Rehabilitation, Kyoto Min-iren Asukai Hospital, Kyoto, Kyoto, Japan.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Rehabilitation","meshQualifierList":{"meshQualifier":[{"abbreviation":"ED","qualifierName":"education","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Feedback"},{"majorTopic_YN":"Y","descriptorName":"Writing"},{"majorTopic_YN":"Y","descriptorName":"Generative Artificial Intelligence"},{"majorTopic_YN":"Y","descriptorName":"Large Language Models"}]},"keywordList":{"keyword":["Artificial intelligence","Feedback","Rehabilitation","AI","Education","Case Report","Large Language Model"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/76924"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13315997"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13315997?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-06-15","dateOfCreation":"2026-06-15","firstIndexDate":"2026-06-16","fullTextReceivedDate":"2026-08-19","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-06-15","firstPublicationDate":"2026-06-15"},{"id":"41822817","source":"MED","pmid":"41822817","pmcid":"PMC12975421","fullTextIdList":{"fullTextId":["PMC12975421"]},"doi":"10.3389/frobt.2026.1765950","title":"Bridging art and AI in the global south: the development of the robot Zequinha considering the grand challenges of human-centered artificial intelligence.","authorString":"da Cunha AC, Lira EG, Dansa de Alencar SJ, Bartholo R, Caulliraux HM.","authorList":{"author":[{"fullName":"da Cunha AC","firstName":"Ana Claudia","lastName":"da Cunha","initials":"AC","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Laboratory of Technologies, Dialogues and Sites (LTDS), Production Engineering Program, Alberto Luiz Coimbra Institute for Graduate Studies and Research in Engineering (COPPE), Universidade Federal do Rio de Janeiro, Rio de Janeiro, Brazil."}]}},{"fullName":"Lira EG","firstName":"Elisa Granha","lastName":"Lira","initials":"EG","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Laboratory of Technologies, Dialogues and Sites (LTDS), Production Engineering Program, Alberto Luiz Coimbra Institute for Graduate Studies and Research in Engineering (COPPE), Universidade Federal do Rio de Janeiro, Rio de Janeiro, Brazil."}]}},{"fullName":"Dansa de Alencar SJ","firstName":"Saulo José","lastName":"Dansa de Alencar","initials":"SJ","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Laboratory of Technologies, Dialogues and Sites (LTDS), Production Engineering Program, Alberto Luiz Coimbra Institute for Graduate Studies and Research in Engineering (COPPE), Universidade Federal do Rio de Janeiro, Rio de Janeiro, Brazil."}]}},{"fullName":"Bartholo R","firstName":"Roberto","lastName":"Bartholo","initials":"R","authorId":{"type":"ORCID","value":"0000-0003-2258-2198"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Laboratory of Technologies, Dialogues and Sites (LTDS), Production Engineering Program, Alberto Luiz Coimbra Institute for Graduate Studies and Research in Engineering (COPPE), Universidade Federal do Rio de Janeiro, Rio de Janeiro, Brazil."}]}},{"fullName":"Caulliraux HM","firstName":"Heitor Mansur","lastName":"Caulliraux","initials":"HM","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Laboratory of Technologies, Dialogues and Sites (LTDS), Production Engineering Program, Alberto Luiz Coimbra Institute for Graduate Studies and Research in Engineering (COPPE), Universidade Federal do Rio de Janeiro, Rio de Janeiro, Brazil."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0003-2258-2198"},{"type":"ORCID","value":"0009-0002-3471-7205"},{"type":"ORCID","value":"0009-0002-7327-913X"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"13","journalIssueId":4110934,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Frontiers in robotics and AI","medlineAbbreviation":"Front Robot AI","isoabbreviation":"Front Robot AI","nlmid":"101749350","essn":"2296-9144","issn":"2296-9144"}},"pubYear":"2026","pageInfo":"1765950","abstractText":"This paper presents the design of a Brazilian robot, named Zequinha, for cultural and educational purposes in light of Human-Centered Artificial Intelligence challenges. Zequinha's development is a blend of art, robotics, and AI, evolving from MIDI-programmed animatronics to an autonomous entity integrating multiple local AIs. This shift to local processing inherently enhances privacy and governance, minimizing reliance on external APIs and enabling offline operability. The project's human-centered design approach is evident in its iterative methodology and its collaborative development with children. Zequinha promotes human wellbeing by enriching cultural mediation, engaging diverse audiences, and demonstrating potential in health and education. Moreover, the focus on local AI fosters responsible design and meaningful human-AI interaction, aiming to create a charismatic, safe, and useful robotic mediator.","affiliation":"Laboratory of Technologies, Dialogues and Sites (LTDS), Production Engineering Program, Alberto Luiz Coimbra Institute for Graduate Studies and Research in Engineering (COPPE), Universidade Federal do Rio de Janeiro, Rio de Janeiro, Brazil.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["brief-report","Journal Article"]},"keywordList":{"keyword":["Cultural Heritage","Advanced Technologies","Artificial Intelligence (Ai)","Human-ai Interaction","Human-Centered Artificial Intelligence","Hcai Challenges","Extended Reality (Xr)","Creative Media"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/frobt.2026.1765950"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12975421"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12975421?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"N","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-03-13","dateOfCreation":"2026-03-13","firstIndexDate":"2026-03-13","fullTextReceivedDate":"2026-03-14","dateOfRevision":"2026-03-13","electronicPublicationDate":"2026-02-25","firstPublicationDate":"2026-02-25"},{"id":"41623519","source":"MED","pmid":"41623519","pmcid":"PMC12852379","fullTextIdList":{"fullTextId":["PMC12852379"]},"doi":"10.3389/frhs.2025.1725425","title":"Rapid review on GenAI in nursing education.","authorString":"Hinsche L, Hasseler M, Tischendorf T, Schaal T.","authorList":{"author":[{"fullName":"Hinsche L","firstName":"Laura","lastName":"Hinsche","initials":"L","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Healthcare, Ostfalia University of Applied Sciences, Wolfsburg, Germany."}]}},{"fullName":"Hasseler M","firstName":"Martina","lastName":"Hasseler","initials":"M","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Healthcare, Ostfalia University of Applied Sciences, Wolfsburg, Germany."}]}},{"fullName":"Tischendorf T","firstName":"Tim","lastName":"Tischendorf","initials":"T","authorId":{"type":"ORCID","value":"0009-0006-5567-0134"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Westsachsische Hochschule Zwickau, Zwickau, Germany."}]}},{"fullName":"Schaal T","firstName":"Tom","lastName":"Schaal","initials":"T","authorId":{"type":"ORCID","value":"0000-0003-1122-2226"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Westsachsische Hochschule Zwickau, Zwickau, Germany."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0003-1122-2226"},{"type":"ORCID","value":"0009-0006-5567-0134"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"volume":"5","journalIssueId":3899935,"dateOfPublication":"2025 ","monthOfPublication":0,"yearOfPublication":2025,"printPublicationDate":"2025-01-01","journal":{"title":"Frontiers in health services","medlineAbbreviation":"Front Health Serv","isoabbreviation":"Front Health Serv","nlmid":"9918334887706676","essn":"2813-0146","issn":"2813-0146"}},"pubYear":"2025","pageInfo":"1725425","abstractText":"<h4>Backround</h4>The use of generative AI, as represented by ChatGPT, holds promising potential for nursing education. This manifests itself in various areas, including personalized learning, simulation training and teaching process support. However, its integration requires careful consideration of ethical implications, adaptation of curricula and a high level of digital competence on the part of teachers. Only in this way can potential risks, such as the distortion of knowledge, bias and educational inequalities, be avoided.<h4>Methodes</h4>Relevant publications were identified between 2019 and 2025 as part of a comprehensive literature search in the specialist databases PubMed, Embase, CINAHL and Scopus. The search was conducted using combined search terms that included the terms \"generative AI\", \"ChatGPT\" and \"nursing\". After removing duplicates and screening (PRISMA-guided), 140 full texts were analysed and divided into two publications. This rapid overview focuses on the topic of generative AI in nursing education.<h4>Results</h4>As part of the analysis of the included studies, five thematic areas were identified, which were divided into the categories of nursing education, competence development and nursing skills, implementation possibilities, examination quality and ethical considerations, and evaluated. A key theme is the dual potential of this technology: it can enrich learning through features such as virtual tutors and improved exam preparation, but it also requires critical consideration of ethical issues such as plagiarism, data bias and the need for human oversight.<h4>Outlook</h4>In this context, the conclusion emphasises the urgent need to adapt curricula and provide targeted further training for teachers so that GenAI can be used responsibly and effectively-rather than, as is often the case at present, by banning it altogether.","affiliation":"Faculty of Healthcare, Ostfalia University of Applied Sciences, Wolfsburg, Germany.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"keywordList":{"keyword":["Artificial intelligence","Nursing Education","Ethical Reflection","Digital Competence","Digital Nursing"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/frhs.2025.1725425"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12852379"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12852379?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":1,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-02-02","dateOfCreation":"2026-02-02","firstIndexDate":"2026-02-06","fullTextReceivedDate":"2026-01-30","dateOfRevision":"2026-02-04","electronicPublicationDate":"2026-01-15","firstPublicationDate":"2026-01-15"},{"id":"41092409","source":"MED","pmid":"41092409","pmcid":"PMC12527318","fullTextIdList":{"fullTextId":["PMC12527318"]},"doi":"10.2196/56090","title":"Development of a Conversational Artificial Intelligence-Based Web Application for Medical Consultations: Prototype Study.","authorString":"Pires JG.","authorList":{"author":[{"fullName":"Pires JG","firstName":"Jorge Guerra","lastName":"Pires","initials":"JG","authorId":{"type":"ORCID","value":"0000-0002-5786-0306"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"IdeaCoding Lab, Rua Timbopeba, 24, Ouro Preto, 35411000, Brazil, 55 31988624279."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-5786-0306"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"6","journalIssueId":4024900,"dateOfPublication":"2025 Oct","monthOfPublication":10,"yearOfPublication":2025,"printPublicationDate":"2025-10-01","journal":{"title":"JMIRx med","medlineAbbreviation":"JMIRx Med","isoabbreviation":"JMIRx Med","nlmid":"101776650","essn":"2563-6316","issn":"2563-6316"}},"pubYear":"2025","pageInfo":"e56090","abstractText":"<h4>Background</h4>Artificial intelligence (AI) has evolved through various trends, with different subfields gaining prominence over time. Currently, conversational AI-particularly generative AI-is at the forefront. Conversational AI models are primarily focused on text-based tasks and are commonly deployed as chatbots. Recent advancements by OpenAI have enabled the integration of external, independently developed models, allowing chatbots to perform specialized, task-oriented functions beyond general language processing.<h4>Objective</h4>This study aims to develop a smart chatbot that integrates large language models from OpenAI with specialized domain-specific models, such as those used in medical image diagnostics. The system leverages transfer learning via Google's Teachable Machine to construct image-based classifiers and incorporates a diabetes detection model developed in TensorFlow.js. A key innovation is the chatbot's ability to extract relevant parameters from user input, trigger the appropriate diagnostic model, interpret the output, and deliver responses in natural language. The overarching goal is to demonstrate the potential of combining large language models with external models to build multimodal, task-oriented conversational agents.<h4>Methods</h4>Two image-based models were developed and integrated into the chatbot system. The first analyzes chest X-rays to detect viral and bacterial pneumonia. The second uses optical coherence tomography images to identify ocular conditions such as drusen, choroidal neovascularization, and diabetic macular edema. Both models were incorporated into the chatbot to enable image-based medical query handling. In addition, a text-based model was constructed to process physiological measurements for diabetes prediction using TensorFlow.js. The architecture is modular; new diagnostic models can be added without redesigning the chatbot, enabling straightforward functional expansion.<h4>Results</h4>The findings demonstrate effective integration between the chatbot and the diagnostic models, with only minor deviations from expected behavior. Additionally, a stub function was implemented within the chatbot to schedule medical appointments based on the severity of a patient's condition, and it was specifically tested with the optical coherence tomography and X-ray models.<h4>Conclusions</h4>This study demonstrates the feasibility of developing advanced AI systems-including image-based diagnostic models and chatbot integration-by leveraging AI as a service. It also underscores the potential of AI to enhance user experiences in bioinformatics, paving the way for more intuitive and accessible interfaces in the field. Looking ahead, the modular nature of the chatbot allows for the integration of additional diagnostic models as the system evolves.","affiliation":"IdeaCoding Lab, Rua Timbopeba, 24, Ouro Preto, 35411000, Brazil, 55 31988624279.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"keywordList":{"keyword":["Artificial intelligence","Machine Learning","Conversational Agent","Chatbots","Chatgpt"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/56090"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12527318"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12527318?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2025-10-15","dateOfCreation":"2025-10-15","firstIndexDate":"2025-10-16","fullTextReceivedDate":"2025-11-24","dateOfRevision":"2025-10-19","electronicPublicationDate":"2025-10-15","firstPublicationDate":"2025-10-15"},{"id":"42536971","source":"MED","pmid":"42536971","doi":"10.2196/77307","title":"Impact of Large Language Model-Based AI Tools on Physician-Patient Communication: Systematic Review and Meta-Analysis.","authorString":"Richter S, Buszello CH, Prem M, Willkommen S, Hasani E, Uckermann O, Juratli TA, Eyüpoglu IY, Polanski WH, Polanski WH.","authorList":{"author":[{"fullName":"Richter S","firstName":"Sven","lastName":"Richter","initials":"S","authorId":{"type":"ORCID","value":"0000-0003-1648-5754"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Neurosurgery, Medical Faculty and University Hospital Carl Gustav Carus, Technische Universität Dresden, Fetscherstrasse 74, Dresden, 01307, Germany, 49 3514582883."},{"affiliation":"Else Kröner Fresenius Center for Digital Health, Medical Faculty and University Hospital Carl Gustav Carus, Technische Universität Dresden, Dresden, Germany."}]}},{"fullName":"Buszello CH","firstName":"Clara Helene","lastName":"Buszello","initials":"CH","authorId":{"type":"ORCID","value":"0009-0008-8230-1064"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Neurosurgery, Medical Faculty and University Hospital Carl Gustav Carus, Technische Universität Dresden, Fetscherstrasse 74, Dresden, 01307, Germany, 49 3514582883."}]}},{"fullName":"Prem M","firstName":"Markus","lastName":"Prem","initials":"M","authorId":{"type":"ORCID","value":"0009-0005-9888-1380"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Neurosurgery, Medical Faculty and University Hospital Carl Gustav Carus, Technische Universität Dresden, Fetscherstrasse 74, Dresden, 01307, Germany, 49 3514582883."}]}},{"fullName":"Willkommen S","firstName":"Sophia","lastName":"Willkommen","initials":"S","authorId":{"type":"ORCID","value":"0009-0003-8993-7720"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Neurosurgery, Medical Faculty and University Hospital Carl Gustav Carus, Technische Universität Dresden, Fetscherstrasse 74, Dresden, 01307, Germany, 49 3514582883."}]}},{"fullName":"Hasani E","firstName":"Elida","lastName":"Hasani","initials":"E","authorId":{"type":"ORCID","value":"0009-0002-0560-6741"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Neurosurgery, Medical Faculty and University Hospital Carl Gustav Carus, Technische Universität Dresden, Fetscherstrasse 74, Dresden, 01307, Germany, 49 3514582883."}]}},{"fullName":"Uckermann O","firstName":"Ortrud","lastName":"Uckermann","initials":"O","authorId":{"type":"ORCID","value":"0000-0001-8196-604X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Neurosurgery, Medical Faculty and University Hospital Carl Gustav Carus, Technische Universität Dresden, Fetscherstrasse 74, Dresden, 01307, Germany, 49 3514582883."}]}},{"fullName":"Juratli TA","firstName":"Tareq A","lastName":"Juratli","initials":"TA","authorId":{"type":"ORCID","value":"0000-0003-2236-6719"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Neurosurgery, Medical Faculty and University Hospital Carl Gustav Carus, Technische Universität Dresden, Fetscherstrasse 74, Dresden, 01307, Germany, 49 3514582883."}]}},{"fullName":"Eyüpoglu IY","firstName":"Ilker Y","lastName":"Eyüpoglu","initials":"IY","authorId":{"type":"ORCID","value":"0000-0002-8185-7764"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Neurosurgery, Medical Faculty and University Hospital Carl Gustav Carus, Technische Universität Dresden, Fetscherstrasse 74, Dresden, 01307, Germany, 49 3514582883."}]}},{"fullName":"Polanski WH","firstName":"Witold H","lastName":"Polanski","initials":"WH","authorId":{"type":"ORCID","value":"0000-0002-9214-150X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Neurosurgery, Medical Faculty and University Hospital Carl Gustav Carus, Technische Universität Dresden, Fetscherstrasse 74, Dresden, 01307, Germany, 49 3514582883."}]}},{"fullName":"Polanski WH","firstName":"Witold H","lastName":"Polanski","initials":"WH","authorId":{"type":"ORCID","value":"0000-0002-6603-5375"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Neurosurgery, Medical Faculty and University Hospital Carl Gustav Carus, Technische Universität Dresden, Fetscherstrasse 74, Dresden, 01307, Germany, 49 3514582883."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-8196-604X"},{"type":"ORCID","value":"0000-0002-6603-5375"},{"type":"ORCID","value":"0000-0002-8185-7764"},{"type":"ORCID","value":"0000-0002-9214-150X"},{"type":"ORCID","value":"0000-0003-1648-5754"},{"type":"ORCID","value":"0000-0003-2236-6719"},{"type":"ORCID","value":"0009-0002-0560-6741"},{"type":"ORCID","value":"0009-0003-8993-7720"},{"type":"ORCID","value":"0009-0005-9888-1380"},{"type":"ORCID","value":"0009-0008-8230-1064"}]},"journalInfo":{"volume":"28","journalIssueId":4225053,"dateOfPublication":"2026 Jul","monthOfPublication":7,"yearOfPublication":2026,"printPublicationDate":"2026-07-01","journal":{"title":"Journal of medical Internet research","medlineAbbreviation":"J Med Internet Res","isoabbreviation":"J Med Internet Res","nlmid":"100959882","essn":"1438-8871","issn":"1439-4456"}},"pubYear":"2026","pageInfo":"e77307","abstractText":"<h4>Background</h4>Recent advances in large language models (LLMs) such as GPT-3/4 have spurred the development of artificial intelligence (AI) chatbots and advisory tools in medicine. These systems are posited to assist or augment physician-patient communication, potentially improving empathy, clarity, and responsiveness. However, their actual impact on communication outcomes remains uncertain.<h4>Objective</h4>This study aimed to systematically review and meta-analyze peer-reviewed studies (2020-2025) evaluating how LLM-based interventions affect physician-patient communication, including empathy, clarity, trust, and patient understanding.<h4>Methods</h4>Following PRISMA (Preferred Reporting Items for Systematic Reviews and Meta-Analyses) 2020 guidelines, we searched PubMed/MEDLINE, Embase, Scopus, and Web of Science for studies published from 2020 to 2025 examining LLM or chatbot applications in clinical communication contexts. Eligible designs included randomized, observational, cross-sectional, and qualitative studies. Two reviewers (WHP and SR) independently screened titles or abstracts, assessed full texts, and extracted data on study design, population, LLM type, communication measures, and outcomes. We conducted a qualitative synthesis and random-effects meta-analysis, reporting pooled standardized mean differences or odds ratios with 95% CIs.<h4>Results</h4>From 312 records, 10 studies were included, all quantitative and predominantly cross-sectional. Populations ranged from patients with chronic conditions to health care professionals and laypersons. Outcomes assessed included empathy (8 studies), clarity or information quality (6 studies), satisfaction or usefulness (4 studies), and trust perceptions (2 studies). In 6 direct comparisons of AI- versus physician-generated responses, LLMs were rated significantly higher in empathy in 5 studies. One large study found that chatbot replies were judged empathetic in 45.1% of cases versus 4.6% for physician replies (odds ratio approximately 9.8, P<.001). Similarly, ChatGPT-4 answers scored higher in empathy on a 5-point scale than human-written responses (mean 4.18 vs 2.70, P<.001). One neurology study showed higher empathy scores (Consultation and Relational Empathy Scale +1.38, P<.01) for ChatGPT answers. Only 1 study found no significant empathy difference. LLM content was also longer and more information-rich, improving patient-perceived clarity and understanding. On the other hand, GPT-4 simplified pathology reports, increasing patient comprehension scores (7.98 vs 5.23/10, P<.001) and reducing consultation time by 70%. However, AI replies were sometimes less concise or less readable for low-literacy patients. In pooled analyses (k=4 studies; total evaluations N=2604), LLM assistance showed a large positive effect on empathy (standardized mean difference 1.02, 95% CI 0.44-1.60; random-effects model). Patient satisfaction results were mixed. No study directly assessed long-term trust.<h4>Conclusions</h4>Current evidence suggests that LLM-based chatbots can enhance physician-patient communication by producing more empathetic, detailed, and understandable responses. These improvements may positively influence patient experience and engagement. However, LLMs may also generate overly lengthy or occasionally inaccurate advice, emphasizing the need for physician oversight. While meta-analytic findings are promising, robust randomized controlled trials, real-world and longitudinal studies are needed to confirm benefits, assess trust outcomes, and define optimal clinical integration strategies.","affiliation":"Department of Neurosurgery, Medical Faculty and University Hospital Carl Gustav Carus, Technische Universität Dresden, Fetscherstrasse 74, Dresden, 01307, Germany, 49 3514582883.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["Meta-Analysis","Systematic Review","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Communication"},{"majorTopic_YN":"N","descriptorName":"Empathy"},{"majorTopic_YN":"Y","descriptorName":"Physician-Patient Relations"},{"majorTopic_YN":"Y","descriptorName":"Artificial Intelligence"},{"majorTopic_YN":"N","descriptorName":"Generative Artificial Intelligence"},{"majorTopic_YN":"N","descriptorName":"Large Language Models"}]},"keywordList":{"keyword":["Empathy","Physician-patient Communication","Artificial Intelligence In Health Care","Large Language Models","Chatgpt","Llms"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/77307"}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-07-31","dateOfCreation":"2026-07-31","firstIndexDate":"2026-08-03","dateOfRevision":"2026-08-19","electronicPublicationDate":"2026-07-31","firstPublicationDate":"2026-07-31"},{"id":"40916423","source":"MED","pmid":"40916423","pmcid":"PMC12418797","fullTextIdList":{"fullTextId":["PMC12418797"]},"doi":"10.1080/0886022x.2025.2555686","title":"Large language models in nephrology: applications and challenges in chronic kidney disease management.","authorString":"Hu Y, Liu J, Jiang W.","authorList":{"author":[{"fullName":"Hu Y","firstName":"Yongzheng","lastName":"Hu","initials":"Y","authorId":{"type":"ORCID","value":"0000-0003-3064-6294"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Nephrology, The Affiliated Hospital of Qingdao University, Qingdao, China."}]}},{"fullName":"Liu J","firstName":"Jianping","lastName":"Liu","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of medical administration, University of Health and Rehabilitation Sciences (Qingdao Municipal Hospital), Qingdao, China."}]}},{"fullName":"Jiang W","firstName":"Wei","lastName":"Jiang","initials":"W","authorId":{"type":"ORCID","value":"0009-0003-1965-3650"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Nephrology, The Affiliated Hospital of Qingdao University, Qingdao, China."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0003-3064-6294"},{"type":"ORCID","value":"0009-0003-1965-3650"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"1","volume":"47","journalIssueId":3872611,"dateOfPublication":"2025 Dec","monthOfPublication":12,"yearOfPublication":2025,"printPublicationDate":"2025-12-01","journal":{"title":"Renal failure","medlineAbbreviation":"Ren Fail","isoabbreviation":"Ren Fail","nlmid":"8701128","essn":"1525-6049","issn":"0886-022X"}},"pubYear":"2025","pageInfo":"2555686","abstractText":"Large language models (LLMs) represent a transformative advance in artificial intelligence, with growing potential to impact chronic kidney disease (CKD) management. CKD is a complex, highly prevalent condition requiring multifaceted care and substantial patient engagement. Recent developments in LLMs-including conversational AI, multimodal integration, and autonomous agents-offer novel opportunities to enhance patient education, streamline clinical documentation, and support decision-making across nephrology practice. Early reports suggest that LLMs can improve health literacy, facilitate adherence to complex treatment regimens, and reduce administrative burdens for clinicians. However, the rapid deployment of these technologies raises important challenges, including patient privacy, data security, model accuracy, algorithmic bias, and ethical accountability. Moreover, real-world evidence supporting the safety and effectiveness of LLMs in nephrology remains limited. Addressing these challenges will require rigorous validation, robust regulatory frameworks, and ongoing collaboration between clinicians, AI developers, and patients. As LLMs continue to evolve, future efforts should focus on the development of nephrology-specific models, prospective clinical trials, and strategies to ensure equitable and transparent implementation. If appropriately integrated, LLMs have the potential to reshape the landscape of CKD care and education, improving outcomes for patients and supporting the nephrology workforce in an era of increasing complexity.","affiliation":"Department of Nephrology, The Affiliated Hospital of Qingdao University, Qingdao, China.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"grantsList":{"grant":[{"agency":"Qingdao Key Health Discipline Development Fund","orderIn":0},{"agency":"Qingdao Key Clinical Specialty Elite Discipline project","orderIn":0},{"grantId":"82370724","agency":"National Natural Science Foundation of China","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Language"},{"majorTopic_YN":"Y","descriptorName":"Nephrology","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Artificial Intelligence"},{"majorTopic_YN":"N","descriptorName":"Disease Management"},{"majorTopic_YN":"Y","descriptorName":"Renal Insufficiency, Chronic","meshQualifierList":{"meshQualifier":[{"abbreviation":"TH","qualifierName":"therapy","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Patient Education as Topic"},{"majorTopic_YN":"N","descriptorName":"Health Literacy"},{"majorTopic_YN":"N","descriptorName":"Large Language Models"}]},"keywordList":{"keyword":["Clinical Decision Support","Ckd","Digital Health","Artificial Intelligence (Ai)","Large Language Models (Llms)"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1080/0886022X.2025.2555686"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12418797"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12418797?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":2,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2025-09-08","dateOfCreation":"2025-09-08","firstIndexDate":"2025-09-09","fullTextReceivedDate":"2025-12-04","dateOfRevision":"2025-09-11","electronicPublicationDate":"2025-09-07","firstPublicationDate":"2025-09-07"},{"id":"42456008","source":"MED","pmid":"42456008","doi":"10.2196/89190","title":"Behavior Change Content and Implementation of Large Language Model-Driven Conversational Agents in Cardiometabolic Care: Scoping Review.","authorString":"Zhao Y, Guo R, Miao Y, Luo Y, Wang H, Wu Y.","authorList":{"author":[{"fullName":"Zhao Y","firstName":"Yuhan","lastName":"Zhao","initials":"Y","authorId":{"type":"ORCID","value":"0009-0008-0461-1913"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Nursing, Capital Medical University, 10 You-An-Men Wai Xi Tou Tiao, Fengtai District, Beijing, 100069, China, 86 13910789837."}]}},{"fullName":"Guo R","firstName":"Rongrong","lastName":"Guo","initials":"R","authorId":{"type":"ORCID","value":"0000-0002-2861-3023"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Nursing, Capital Medical University, 10 You-An-Men Wai Xi Tou Tiao, Fengtai District, Beijing, 100069, China, 86 13910789837."}]}},{"fullName":"Miao Y","firstName":"Yiqun","lastName":"Miao","initials":"Y","authorId":{"type":"ORCID","value":"0000-0002-6084-3662"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Nursing, Capital Medical University, 10 You-An-Men Wai Xi Tou Tiao, Fengtai District, Beijing, 100069, China, 86 13910789837."}]}},{"fullName":"Luo Y","firstName":"Yuan","lastName":"Luo","initials":"Y","authorId":{"type":"ORCID","value":"0000-0003-1198-3877"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Nursing, Capital Medical University, 10 You-An-Men Wai Xi Tou Tiao, Fengtai District, Beijing, 100069, China, 86 13910789837."}]}},{"fullName":"Wang H","firstName":"Huiying","lastName":"Wang","initials":"H","authorId":{"type":"ORCID","value":"0009-0001-7708-3356"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Nursing, Capital Medical University, 10 You-An-Men Wai Xi Tou Tiao, Fengtai District, Beijing, 100069, China, 86 13910789837."}]}},{"fullName":"Wu Y","firstName":"Ying","lastName":"Wu","initials":"Y","authorId":{"type":"ORCID","value":"0000-0002-8633-5404"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Nursing, Capital Medical University, 10 You-An-Men Wai Xi Tou Tiao, Fengtai District, Beijing, 100069, China, 86 13910789837."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-2861-3023"},{"type":"ORCID","value":"0000-0002-6084-3662"},{"type":"ORCID","value":"0000-0002-8633-5404"},{"type":"ORCID","value":"0000-0003-1198-3877"},{"type":"ORCID","value":"0009-0001-7708-3356"},{"type":"ORCID","value":"0009-0008-0461-1913"}]},"journalInfo":{"volume":"28","journalIssueId":4225053,"dateOfPublication":"2026 Jul","monthOfPublication":7,"yearOfPublication":2026,"printPublicationDate":"2026-07-01","journal":{"title":"Journal of medical Internet research","medlineAbbreviation":"J Med Internet Res","isoabbreviation":"J Med Internet Res","nlmid":"100959882","essn":"1438-8871","issn":"1439-4456"}},"pubYear":"2026","pageInfo":"e89190","abstractText":"<h4>Background</h4>Large language models (LLMs) are increasingly embedded in conversational agents for cardiometabolic care. These systems could support self-management, but their behavior change content, delivery mechanisms, and implementation transparency are poorly understood.<h4>Objective</h4>This scoping review mapped behavior change techniques (BCTs) used in LLM-driven conversational agents for cardiometabolic prevention and management, described how these techniques are delivered across static, rule-based, and generative mechanisms, examined LLM design, personalization, and safety reporting, and summarized user experience and behavioral or clinical outcomes.<h4>Methods</h4>We searched PubMed, Web of Science, Embase, CINAHL, APA PsycInfo, IEEE Xplore, ACM Digital Library, arXiv, ClinicalTrials.gov, and the WHO International Clinical Trials Registry Platform for records published from January 1, 2020, to November 30, 2025. The final search was run on March 25, 2026, using this publication-date limit. Eligible studies reported a patient-facing text- or voice-based cardiometabolic conversational agent using an LLM or other transformer-based generative model. Two reviewers independently screened records and extracted data. BCTs were coded using the Behavior Change Technique Taxonomy v1; selected self-management BCTs were classified as static, rule-based or templated, or generative or context-aware. Empirical human-participant- or evaluator-based studies were appraised with the Mixed Methods Appraisal Tool, and a study-specific checklist assessed LLM implementation reporting transparency.<h4>Results</h4>Thirty-eight studies were included; 19 involved empirical human-participant- or evaluator-based assessments, whereas 19 were technical and system-level evaluations, including framework-development, simulated-output, and proof-of-concept studies. Studies were concentrated in 2024-2025. Instruction on how to perform behavior was identified in 30 of 38 (79%) studies, information about health consequences in 27 of 38 (71%) studies, and feedback and monitoring techniques in 19 of 38 (50%) studies. Most agents were positioned as educators or coaches targeting type 2 diabetes, obesity, or related cardiometabolic risk, and GPT-family models embedded in hybrid architectures with retrieval-augmented generation or rule-based components predominated. Generative outputs were used mainly for tailored explanations, risk information, and socioemotional responses, whereas self-monitoring, reminders, and structured interactions were more often rule-based or mixed-mode. Only 13 of 38 (34%) studies fully reported prompts or system messages, and 16 of 38 (42%) studies fully reported safety or oversight mechanisms. User evaluations reported good usability and perceived helpfulness, but behavioral or physiological outcomes were sparse and usually limited to pilot, short-term, or single-case designs.<h4>Conclusions</h4>LLM-driven conversational agents for cardiometabolic care are proliferating but remain early-stage and methodologically heterogeneous. Current systems primarily use LLMs as educational and explanatory layers with \"synthetic empathy\" over rule-based data capture and safety functions, while behavior change content remains dominated by information provision and simple feedback. More rigorous comparative studies with longer follow-up are needed before firm conclusions can be drawn about sustained behavioral or clinical benefit.","affiliation":"School of Nursing, Capital Medical University, 10 You-An-Men Wai Xi Tou Tiao, Fengtai District, Beijing, 100069, China, 86 13910789837.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["Scoping Review","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Cardiovascular Diseases","meshQualifierList":{"meshQualifier":[{"abbreviation":"PC","qualifierName":"prevention & control","majorTopic_YN":"N"},{"abbreviation":"TH","qualifierName":"therapy","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Large Language Models"}]},"keywordList":{"keyword":["Implementation","Transparency","Self-management","Hybrid Systems","Scoping Review","Cardiometabolic Diseases","Behavior Change Techniques","Chatbots","Conversational Agents","Large Language Models"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/89190"}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-07-16","dateOfCreation":"2026-07-15","firstIndexDate":"2026-07-16","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-07-15","firstPublicationDate":"2026-07-15"},{"id":"41355256","source":"MED","pmid":"41355256","pmcid":"PMC12688311","fullTextIdList":{"fullTextId":["PMC12688311"]},"doi":"10.5213/inj.2525edi05","title":"Changes and Evolution of Artificial Specialized Intelligence in Urology.","authorString":"Eun SJ.","authorList":{"author":[{"fullName":"Eun SJ","firstName":"Sung-Jong","lastName":"Eun","initials":"SJ","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Digital Health Industry Team, National IT Industry Promotion Agency, Jincheon, Korea."}]}}]},"journalInfo":{"issue":"Suppl 2","volume":"29","journalIssueId":4067801,"dateOfPublication":"2025 Nov","monthOfPublication":11,"yearOfPublication":2025,"printPublicationDate":"2025-11-01","journal":{"title":"International neurourology journal","medlineAbbreviation":"Int Neurourol J","isoabbreviation":"Int Neurourol J","nlmid":"101534513","essn":"2093-6931","issn":"2093-4777"}},"pubYear":"2025","pageInfo":"S53-S54","affiliation":"Digital Health Industry Team, National IT Industry Promotion Agency, Jincheon, Korea.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Editorial"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.5213/inj.2525edi05"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12688311"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12688311?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"N","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by-nc","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2025-12-08","dateOfCreation":"2025-12-08","firstIndexDate":"2025-12-08","fullTextReceivedDate":"2025-12-12","dateOfRevision":"2025-12-11","electronicPublicationDate":"2025-11-30","firstPublicationDate":"2025-11-30"},{"id":"42199274","source":"MED","pmid":"42199274","pmcid":"PMC13199291","fullTextIdList":{"fullTextId":["PMC13199291"]},"doi":"10.3389/fpsyg.2026.1794568","title":"Artificial intelligence in college students' mental health education: opportunities, challenges, and strategic responses.","authorString":"Wang R, Sun X, Sun Y, Wang J.","authorList":{"author":[{"fullName":"Wang R","firstName":"Rui","lastName":"Wang","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"College of Chemical Engineering, Huaqiao University, Xiamen, China."}]}},{"fullName":"Sun X","firstName":"Xiaobo","lastName":"Sun","initials":"X","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"College of Chemical Engineering, Huaqiao University, Xiamen, China."}]}},{"fullName":"Sun Y","firstName":"Yuqi","lastName":"Sun","initials":"Y","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"College of Chemical Engineering, Huaqiao University, Xiamen, China."}]}},{"fullName":"Wang J","firstName":"Jing","lastName":"Wang","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"College of Chemical Engineering, Huaqiao University, Xiamen, China."}]}}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"17","journalIssueId":4112159,"dateOfPublication":"2026 ","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Frontiers in psychology","medlineAbbreviation":"Front Psychol","isoabbreviation":"Front Psychol","nlmid":"101550902","essn":"1664-1078","issn":"1664-1078"}},"pubYear":"2026","pageInfo":"1794568","abstractText":"Mental health challenges among college students have become a growing global concern, placing increasing pressure on higher education systems to provide effective, scalable, and equitable mental health education and support. This narrative review examines the opportunities, challenges, and strategic responses associated with integrating artificial intelligence (AI) into college students' mental health education. To improve conceptual clarity, it distinguishes educationally oriented AI applications from adjacent domains, including prevention-oriented support, early detection and screening, and supportive quasi-clinical intervention. The review identifies three main opportunity domains: personalized support for self-regulation and mental health learning, AI-assisted early awareness and prevention, and expanded accessibility and institutional reach. It also highlights key challenges related to ethical governance and privacy, accuracy and reliability, and digital divide and inclusivity issues. In response, the review emphasizes the need to strengthen ethical frameworks, improve system reliability and cultural responsiveness, and promote digital and AI literacy within higher education. Overall, current evidence suggests that AI can serve as a valuable complement to professional services and human-centered educational practices. However, the evidence base remains largely short-term and context-dependent, underscoring the need for longitudinal research, stronger institutional governance, and more inclusive implementation strategies. Responsible AI integration therefore requires a balanced, education-centered approach aligned with equity, student well-being, and institutional responsibility.","affiliation":"College of Chemical Engineering, Huaqiao University, Xiamen, China.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"keywordList":{"keyword":["Digital Inclusion","Ethical Governance Of Ai","Ai In Higher Education","College Student Mental Health Education","Personalized Mental Health Support"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3389/fpsyg.2026.1794568"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13199291"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13199291?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-05-27","dateOfCreation":"2026-05-27","firstIndexDate":"2026-05-28","fullTextReceivedDate":"2026-05-27","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-05-11","firstPublicationDate":"2026-05-11"},{"id":"41380150","source":"MED","pmid":"41380150","pmcid":"PMC12741657","fullTextIdList":{"fullTextId":["PMC12741657"]},"doi":"10.2196/73319","title":"AI-Enabled Personalized Smoking Cessation Intervention With the Aipaca Chatbot: Mixed Methods Feasibility Study.","authorString":"Liu Y, Calle P, Vadakekut M, Rubin D, Nagykaldi Z, Doescher M, Hightow-Weidman L, Pan C, Shao R.","authorList":{"author":[{"fullName":"Liu Y","firstName":"Yunlong","lastName":"Liu","initials":"Y","authorId":{"type":"ORCID","value":"0009-0000-0733-8803"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Computer Science, University of Oklahoma, Norman, OK, United States."}]}},{"fullName":"Calle P","firstName":"Paul","lastName":"Calle","initials":"P","authorId":{"type":"ORCID","value":"0009-0000-1849-4481"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Computer Science, University of Oklahoma, Norman, OK, United States."}]}},{"fullName":"Vadakekut M","firstName":"Mariah","lastName":"Vadakekut","initials":"M","authorId":{"type":"ORCID","value":"0009-0005-3437-2050"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Computer Science, University of Oklahoma, Norman, OK, United States."}]}},{"fullName":"Rubin D","firstName":"Daniel","lastName":"Rubin","initials":"D","authorId":{"type":"ORCID","value":"0000-0003-2952-023X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Community Health and Family Medicine, College of Medicine, University of Florida, Gainesville, FL, United States."}]}},{"fullName":"Nagykaldi Z","firstName":"Zsolt","lastName":"Nagykaldi","initials":"Z","authorId":{"type":"ORCID","value":"0000-0003-1239-6164"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Family and Preventive Medicine, College of Medicine, University of Oklahoma Health Sciences Center, Oklahoma City, OK, United States."}]}},{"fullName":"Doescher M","firstName":"Mark","lastName":"Doescher","initials":"M","authorId":{"type":"ORCID","value":"0000-0003-1631-0428"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Family and Preventive Medicine, College of Medicine, University of Oklahoma Health Sciences Center, Oklahoma City, OK, United States."}]}},{"fullName":"Hightow-Weidman L","firstName":"Lisa","lastName":"Hightow-Weidman","initials":"L","authorId":{"type":"ORCID","value":"0000-0002-2421-923X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"College of Nursing, Florida State University, Tallahassee, FL, United States."}]}},{"fullName":"Pan C","firstName":"Chongle","lastName":"Pan","initials":"C","authorId":{"type":"ORCID","value":"0000-0003-2860-0334"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Computer Science, University of Oklahoma, Norman, OK, United States."}]}},{"fullName":"Shao R","firstName":"Ruosi","lastName":"Shao","initials":"R","authorId":{"type":"ORCID","value":"0000-0002-8834-4427"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"College of Communication and Information, Florida State University, Tallahassee, FL, United States."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-2421-923X"},{"type":"ORCID","value":"0000-0002-8834-4427"},{"type":"ORCID","value":"0000-0003-1239-6164"},{"type":"ORCID","value":"0000-0003-1631-0428"},{"type":"ORCID","value":"0000-0003-2860-0334"},{"type":"ORCID","value":"0000-0003-2952-023X"},{"type":"ORCID","value":"0009-0000-0733-8803"},{"type":"ORCID","value":"0009-0000-1849-4481"},{"type":"ORCID","value":"0009-0005-3437-2050"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"volume":"9","journalIssueId":4059821,"dateOfPublication":"2025 Dec","monthOfPublication":12,"yearOfPublication":2025,"printPublicationDate":"2025-12-01","journal":{"title":"JMIR formative research","medlineAbbreviation":"JMIR Form Res","isoabbreviation":"JMIR Form Res","nlmid":"101726394","essn":"2561-326X","issn":"2561-326X"}},"pubYear":"2025","pageInfo":"e73319","abstractText":"<h4>Background</h4>Tobacco use remains the leading cause of preventable mortality in the United States; yet, evidence-based cessation services remain underused due to staffing constraints, limited access to counseling, and competing clinical priorities. Generative artificial intelligence (GenAI) chatbots may address these barriers by delivering personalized, guideline-aligned counseling through naturalistic dialogue. However, little is known about how GenAI chatbots support smoking cessation at both outcome and communication process levels.<h4>Objective</h4>This feasibility study evaluated the implementation of an evidence-based smoking cessation counseling session delivered by a GenAI-powered chatbot, Aipaca. We examined (1) pre-post changes in cessation preparedness, (2) communication dynamics during counseling sessions, and (3) user perceptions of the chatbot's value, limitations, and design needs.<h4>Methods</h4>We conducted an observational, single-arm, mixed methods study with 29 adult smokers. Participants completed pre-post surveys measuring knowledge of smoking-related health risks and cessation methods, self-efficacy, and readiness to quit. Each engaged in a 30-minute text-based counseling session with Aipaca, powered by GPT-4 and structured using the 5A's framework (Ask, Advise, Assess, Assist, Arrange). Sessions were transcribed for microsequential conversation analysis. Twenty-five participants completed semistructured interviews exploring perceived value, challenges, and design suggestions. Quantitative data were analyzed with paired-samples t tests, qualitative data were thematically analyzed, and transcripts were analyzed for interactional practices. The methodological strength of this study lies in its triangulated approach, which combines quantitative measurement of intervention effectiveness, qualitative analysis of user interviews, and conversational analysis of counseling transcripts to generate a comprehensive understanding of both outcomes and underlying mechanisms.<h4>Results</h4>Participants demonstrated significant improvements in all preparedness indicators: knowledge of health risks, knowledge of cessation methods, self-efficacy, and readiness to quit. Conversation analysis identified three recurrent patterns enabling counseling-relevant dynamics: (1) contextual referencing and continuity, (2) formulations with elaboration prompts, and (3) narrative progression toward collaborative planning. Interview themes underscored Aipaca's perceived value as an accessible, nonjudgmental, and motivating resource, capable of delivering personalized and interactive support. Criticisms included limited accountability, reduced cultural resonance, and overly goal-directed style. Participants emphasized design needs such as proactive engagement, gamified progress tracking, empathetic or anthropomorphic personas, and safeguards for accuracy.<h4>Conclusions</h4>This mixed methods feasibility study demonstrates that GenAI can deliver evidence-based smoking cessation counseling with measurable short-term gains in cessation preparedness and process-level communication patterns consistent with motivational interviewing. Users valued Aipaca's accessibility, empathy, and personalization, while also articulating expectations for richer social roles and long-term accountability. Findings highlight both the promise and challenges of integrating GenAI into digital health: pairing adaptive language generation with human-centered design, embedding accuracy safeguards, and ensuring integration into multilevel cessation infrastructures will be essential for future clinical deployment.","affiliation":"School of Computer Science, University of Oklahoma, Norman, OK, United States.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article","Research Support, N.I.H., Extramural","Observational Study"]},"grantsList":{"grant":[{"grantId":"1OT2OD032581-02","agency":"Office of the Director, NIH Common Fund","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Feasibility Studies"},{"majorTopic_YN":"Y","descriptorName":"Smoking Cessation","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"},{"abbreviation":"PX","qualifierName":"psychology","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Self Efficacy"},{"majorTopic_YN":"Y","descriptorName":"Counseling","meshQualifierList":{"meshQualifier":[{"abbreviation":"MT","qualifierName":"methods","majorTopic_YN":"N"}]}},{"majorTopic_YN":"Y","descriptorName":"Artificial Intelligence"},{"majorTopic_YN":"N","descriptorName":"Adult"},{"majorTopic_YN":"N","descriptorName":"Middle Aged"},{"majorTopic_YN":"N","descriptorName":"Female"},{"majorTopic_YN":"N","descriptorName":"Male"},{"majorTopic_YN":"N","descriptorName":"Smokers","meshQualifierList":{"meshQualifier":[{"abbreviation":"PX","qualifierName":"psychology","majorTopic_YN":"N"}]}},{"majorTopic_YN":"N","descriptorName":"Generative Artificial Intelligence"}]},"keywordList":{"keyword":["Health intervention","Usability","Tobacco Treatment","Conversational Agent","Generative Ai"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.2196/73319"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12741657"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12741657?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":3,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"Y","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2025-12-11","dateOfCreation":"2025-12-11","firstIndexDate":"2025-12-12","fullTextReceivedDate":"2025-12-27","dateOfRevision":"2026-06-21","electronicPublicationDate":"2025-12-11","firstPublicationDate":"2025-12-11"},{"id":"42074904","source":"MED","pmid":"42074904","pmcid":"PMC13118107","fullTextIdList":{"fullTextId":["PMC13118107"]},"doi":"10.3390/jcm15083103","title":"Assessment of Stage Two Hypertension Treatment Plans Written by Generative AI.","authorString":"Metzger T, Hossain Z, Park K, Vu S, Dixon S, Taylor TAH.","authorList":{"author":[{"fullName":"Metzger T","firstName":"Tai","lastName":"Metzger","initials":"T","authorId":{"type":"ORCID","value":"0000-0002-8991-3572"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Foundational Medical Studies, Oakland University William Beaumont School of Medicine, Rochester, MI 48309, USA."}]}},{"fullName":"Hossain Z","firstName":"Zaheen","lastName":"Hossain","initials":"Z","authorId":{"type":"ORCID","value":"0009-0003-3235-273X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Foundational Medical Studies, Oakland University William Beaumont School of Medicine, Rochester, MI 48309, USA."}]}},{"fullName":"Park K","firstName":"Kody","lastName":"Park","initials":"K","authorId":{"type":"ORCID","value":"0009-0009-7687-1287"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Foundational Medical Studies, Oakland University William Beaumont School of Medicine, Rochester, MI 48309, USA."}]}},{"fullName":"Vu S","firstName":"Stephen","lastName":"Vu","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Foundational Medical Studies, Oakland University William Beaumont School of Medicine, Rochester, MI 48309, USA."}]}},{"fullName":"Dixon S","firstName":"Simon","lastName":"Dixon","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Cardiovascular Medicine, Corewell Health William Beaumont University Hospital, Royal Oak, MI 48073, USA."}]}},{"fullName":"Taylor TAH","firstName":"Tracey A H","lastName":"Taylor","initials":"TAH","authorId":{"type":"ORCID","value":"0000-0002-4739-7127"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Foundational Medical Studies, Oakland University William Beaumont School of Medicine, Rochester, MI 48309, USA."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-4739-7127"},{"type":"ORCID","value":"0000-0002-8991-3572"},{"type":"ORCID","value":"0009-0003-3235-273X"},{"type":"ORCID","value":"0009-0009-7687-1287"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"8","volume":"15","journalIssueId":4188745,"dateOfPublication":"2026 Apr","monthOfPublication":4,"yearOfPublication":2026,"printPublicationDate":"2026-04-01","journal":{"title":"Journal of clinical medicine","medlineAbbreviation":"J Clin Med","isoabbreviation":"J Clin Med","nlmid":"101606588","essn":"2077-0383","issn":"2077-0383"}},"pubYear":"2026","pageInfo":"3103","abstractText":"<b>Background/Objectives</b>: As use of large language models (LLMs) in clinical practice, in medical education, and by patients increases, it is essential to ensure that information provided is accurate and safe. Our objective was to compare stage two hypertension treatment plans generated by popular LLMs. <b>Methods</b>: ChatGPT (GPT-4o), Claude (Claude 4 Sonnet), ClinicalKey AI, Microsoft Copilot (Wave 2), DeepSeek-V3-0324, Dyna AI, Google Gemini (2.5 Flash), Grok (version 3), Meta AI assistant (Llama 4 Maverick), OpenEvidence (version 2.0), Perplexity (Sonar backend model), and Pi (Inflection-2.5) were prompted to generate a treatment plan for stage two hypertension. Six blinded reviewers scored each response in three domains: adherence to clinical guidelines, detail/clarity, and reliability/safety. <b>Results</b>: Perplexity received the highest composite score (8.17 out of 9), followed by OpenEvidence (7.92 out of 9). Dyna AI had the lowest overall score (3.75 out of 9). Perplexity (3.00 out of 3), Grok (2.83 out of 3), and OpenEvidence (2.75 out of 3) had the highest scores for detail/clarity, while Dyna AI had the lowest for both detail/clarity (1.00 out of 3) and reliability/safety (1.00 out of 3). ChatGPT had the highest score for adherence to guidelines (2.75 out of 3) while Pi had the lowest (1.58 out of 3). Kruskal-Wallis test showed <i>p</i> < 0.05 across sub-score domains and composite scores. <b>Conclusions</b>: LLMs tended to adhere to clinical guidelines and provide detailed responses but often did not provide sources or instruct users to see a healthcare professional. There was notable variability in quality, and medicine-specific LLMs were not superior to popular LLMs.","affiliation":"Department of Foundational Medical Studies, Oakland University William Beaumont School of Medicine, Rochester, MI 48309, USA.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"keywordList":{"keyword":["Hypertension","Artificial intelligence","Cardiovascular disease","Large Language Models"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3390/jcm15083103"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13118107"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13118107?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-05-04","dateOfCreation":"2026-05-04","firstIndexDate":"2026-05-13","fullTextReceivedDate":"2026-05-18","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-04-18","firstPublicationDate":"2026-04-18"},{"id":"42122591","source":"MED","pmid":"42122591","pmcid":"PMC13165907","fullTextIdList":{"fullTextId":["PMC13165907"]},"doi":"10.3390/s26092870","title":"LLMs in the Loop: A Survey of Language-Driven Driver Monitoring and Assistance Systems.","authorString":"Chandrayan V, Alvarez I.","authorList":{"author":[{"fullName":"Chandrayan V","firstName":"Vanchha","lastName":"Chandrayan","initials":"V","authorId":{"type":"ORCID","value":"0000-0003-4242-5747"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Human Centered Intelligent Systems, Technische Hochschule Ingolstadt, 85049 Ingolstadt, Germany."}]}},{"fullName":"Alvarez I","firstName":"Ignacio","lastName":"Alvarez","initials":"I","authorId":{"type":"ORCID","value":"0000-0002-3705-2221"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Human Centered Intelligent Systems, Technische Hochschule Ingolstadt, 85049 Ingolstadt, Germany."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-3705-2221"},{"type":"ORCID","value":"0000-0003-4242-5747"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"9","volume":"26","journalIssueId":4193386,"dateOfPublication":"2026 May","monthOfPublication":5,"yearOfPublication":2026,"printPublicationDate":"2026-05-01","journal":{"title":"Sensors (Basel, Switzerland)","medlineAbbreviation":"Sensors (Basel)","isoabbreviation":"Sensors (Basel)","nlmid":"101204366","essn":"1424-8220","issn":"1424-8220"}},"pubYear":"2026","pageInfo":"2870","abstractText":"In recent years we have seen large language models (LLMs) demonstrating robust reasoning capabilities comparable to human performance. This makes them increasingly appealing for driver assistance, where adaptation to dynamic human context is essential. Yet, research in this area remains fragmented, often focusing on isolated applications, lacking utilization of LLM's full potential to deliver integrated, context-specific support and action. This survey synthesizes recent advancements in LLM-driven occupant monitoring systems, focusing on their capabilities for interpreting driver states and acting appropriately, enabling a new generation of intelligent driver assistance. We critically examine pioneering frameworks, benchmarks, and foundational datasets that employ techniques like reasoning chains, multimodality, and human-in-the-loop feedback to create personalized and safe driving experiences. We lay out the current trends, limitations, and emerging patterns, in addition to a novel human-centered evaluation of the field, providing researchers with a roadmap towards transparent and trustworthy in-cabin systems that bridge safety with driver experience.","affiliation":"Human Centered Intelligent Systems, Technische Hochschule Ingolstadt, 85049 Ingolstadt, Germany.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic","pubTypeList":{"pubType":["review-article","Review","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Automobile Driving"},{"majorTopic_YN":"N","descriptorName":"Surveys and Questionnaires"},{"majorTopic_YN":"Y","descriptorName":"Large Language Models"}]},"keywordList":{"keyword":["Advanced Driver Assistance Systems (Adas)","Human–vehicle Interaction","In-cabin Sensing Modalities","Llm Reasoning"]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.3390/s26092870"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13165907"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC13165907?pdf=render"}]},"commentCorrectionList":{"commentCorrection":[{"id":"PPR1164600","source":"PPR","type":"Preprint in","note":"CrossRef Pre-print loader","orderIn":10002}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"Y","hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["doi"]},"dateOfCompletion":"2026-07-16","dateOfCreation":"2026-05-13","firstIndexDate":"2026-05-15","fullTextReceivedDate":"2026-05-20","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-05-04","firstPublicationDate":"2026-05-04"},{"id":"41836616","source":"MED","pmid":"41836616","pmcid":"PMC12982851","fullTextIdList":{"fullTextId":["PMC12982851"]},"doi":"10.1177/20552076261423991","title":"A LangChain-facilitated conversational approach to cataract disease: A pilot study with large language models.","authorString":"Saqib SM, Naz NS, Mazhar T, Tariq MU, Al-Rasheed A, Khan MA, Shahzad T, Hamam H.","authorList":{"author":[{"fullName":"Saqib SM","firstName":"Sheikh Muhammad","lastName":"Saqib","initials":"SM","authorId":{"type":"ORCID","value":"0000-0002-4647-1698"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Computing and Information Technology, Gomal University, DI Khan, Pakistan."}]}},{"fullName":"Naz NS","firstName":"Naila Sammar","lastName":"Naz","initials":"NS","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Computer Science, National College of Business Administration and Economics, Lahore, Pakistan."}]}},{"fullName":"Mazhar T","firstName":"Tehseen","lastName":"Mazhar","initials":"T","authorId":{"type":"ORCID","value":"0000-0002-4649-2376"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Computer Science, National College of Business Administration and Economics, Lahore, Pakistan."},{"affiliation":"Department of Computer Science and Information Technology, School Education Department, Government of Punjab, Layyah, Pakistan."}]}},{"fullName":"Tariq MU","firstName":"Muhammad Usman","lastName":"Tariq","initials":"MU","authorId":{"type":"ORCID","value":"0000-0002-7605-3040"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Marketing, Operations, and Information Systems, College of Business, Abu Dhabi University, Abu Dhabi, United Arab Emirates."}]}},{"fullName":"Al-Rasheed A","firstName":"Amal","lastName":"Al-Rasheed","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Information Systems, College of Computer and Information Sciences, Princess Nourah bint Abdulrahman University, Riyadh, Saudi Arabia."}]}},{"fullName":"Khan MA","firstName":"Muhammad Amir","lastName":"Khan","initials":"MA","authorId":{"type":"ORCID","value":"0000-0003-3669-2080"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Computer and Mathematical Sciences, Universiti Teknologi MARA, Shah Alam, Malaysia."}]}},{"fullName":"Shahzad T","firstName":"Tariq","lastName":"Shahzad","initials":"T","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Computer Engineering, COMSATS University Islamabad, Sahiwal, Pakistan."}]}},{"fullName":"Hamam H","firstName":"Habib","lastName":"Hamam","initials":"H","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Faculty of Engineering, Université de Moncton, Moncton, Canada."},{"affiliation":"School of Electrical Engineering, University of Johannesburg, Johannesburg, South Africa."},{"affiliation":"International Institute of Technology and Management (IITG), Avenue des Grandes Ecoles, Libreville, Gabon."},{"affiliation":"Bridges for Academic Excellence - Spectrum, Tunis, Tunisia."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-4647-1698"},{"type":"ORCID","value":"0000-0002-4649-2376"},{"type":"ORCID","value":"0000-0002-7605-3040"},{"type":"ORCID","value":"0000-0003-3669-2080"}]},"journalInfo":{"volume":"12","journalIssueId":4085000,"dateOfPublication":"2026 Jan-Dec","monthOfPublication":0,"yearOfPublication":2026,"printPublicationDate":"2026-01-01","journal":{"title":"Digital health","medlineAbbreviation":"Digit Health","isoabbreviation":"Digit Health","nlmid":"101690863","essn":"2055-2076","issn":"2055-2076"}},"pubYear":"2026","pageInfo":"20552076261423991","abstractText":"<h4>Purpose</h4>This study examines the use of Google's advanced large language models and the LangChain library for developing a chat counseling system for cataract disease.<h4>Methods</h4>The proposed system integrates a manually constructed cataract disease information repository with Google Generative artificial intelligence (AI) models, while LangChain is used to simplify the development and deployment of the conversational pipeline. The effectiveness of the system is evaluated using the Recall-Oriented Understudy for Gisting Evaluation (ROUGE) score, a standard metric for assessing the quality of generated responses.<h4>Results</h4>Preliminary evaluation demonstrates an encouraging trend, indicating that the proposed system is suitable for building innovative and responsive counseling tools for cataract education.<h4>Conclusion</h4>The findings suggest that combining Google Generative AI models with LangChain and a curated cataract information repository can support the development of practical conversational systems in the domain of cataract disease.","affiliation":"Department of Computing and Information Technology, Gomal University, DI Khan, Pakistan.","publicationStatus":"epublish","language":"eng","pubModel":"Electronic-eCollection","pubTypeList":{"pubType":["research-article","Journal Article"]},"keywordList":{"keyword":["Cataract Disease","Large Language Models (Llms)","Langchain","Google Generative Ai","Rouge Score"]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1177/20552076261423991"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12982851"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC12982851?pdf=render"}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","hasPDF":"Y","hasBook":"N","hasSuppl":"N","citedByCount":0,"hasData":"N","hasReferences":"Y","hasTextMinedTerms":"N","hasDbCrossReferences":"N","hasLabsLinks":"N","license":"cc by-nc","hasEvaluations":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2026-03-16","dateOfCreation":"2026-03-16","firstIndexDate":"2026-03-17","fullTextReceivedDate":"2026-03-14","dateOfRevision":"2026-08-13","electronicPublicationDate":"2026-03-12","firstPublicationDate":"2026-01-01"}]}}